# PSAU QMS — Environment variables for Render (and local dev)
# Copy this to .env locally:  cp .env.example .env
# On Render: Dashboard -> your Web Service -> Environment -> Add each key below

PORT=10000
NODE_ENV=production
SESSION_SECRET=replace-with-random-32+hex  # generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Firebase — Web API key (from Firebase Console -> Project Settings -> General -> Web API Key)
FIREBASE_API_KEY=your-firebase-web-api-key

# Firebase Admin — SINGLE-LINE JSON string of serviceAccountKey.json
# How to create (Windows PowerShell):
#   $json = Get-Content -Raw serviceAccountKey.json | ConvertFrom-Json | ConvertTo-Json -Compress
#   Set-Clipboard $json   # then paste into Render as FIREBASE_SERVICE_ACCOUNT
# OR (Node):
#   node -e "console.log(JSON.stringify(require('./serviceAccountKey.json')))"
# Paste the ONE-LINE output as the value. Do NOT wrap in extra quotes.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...","client_email":"..."}

# Gmail SMTP — App Password (16 chars, no spaces). Create at https://myaccount.google.com/apppasswords (2FA must be ON)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=abcdefghijklmnop

# Admin allowlist — comma-separated emails that get admin role on first login
ADMIN_EMAIL=admin@psau.edu.ph
ADMIN_EMAILS=admin@psau.edu.ph,second.admin@psau.edu.ph

# Gemini AI — optional, for hybrid reports. Leave blank to use local Naïve Bayes only
GEMINI_API_KEY=your-gemini-api-key

# Brevo HTTPS API — RECOMMENDED for Railway/Render Free (uses 443, never blocked like SMTP 587/465)
# Free: 300 emails/day at brevo.com. Create at: https://app.brevo.com/settings/keys/api
# After adding sender at https://app.brevo.com/settings/senders and verifying bonustimoy@gmail.com
BREVO_API_KEY=xkeysib-...
BREVO_SENDER_EMAIL=bonustimoy@gmail.com
BREVO_SENDER_NAME=PSAU Feedback System

# Optional Gmail OAuth2 (alternative to SMTP_PASS, more reliable if SMTP is blocked):
# GMAIL_OAUTH_CLIENT_ID=
# GMAIL_OAUTH_CLIENT_SECRET=
# GMAIL_OAUTH_REFRESH_TOKEN=
# GMAIL_OAUTH_USER=your-gmail@gmail.com
