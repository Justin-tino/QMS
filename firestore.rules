rules_version = '2';
// PSAU Feedback System — Server-only Firestore rules (TIMO 8.8: "FIRESTORE database,
// managed through the Nodejs system"). All reads/writes flow through the Node.js
// Firebase Admin SDK, which BYPASSES these rules. Direct client access is denied,
// so the public FIREBASE_API_KEY cannot be used to bypass server-side validation,
// CSRF protection, or rate limiting.
//
// Deploy: firebase deploy --only firestore:rules
// (or paste into Firebase Console -> Firestore Database -> Rules -> Publish)
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
