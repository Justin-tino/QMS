<script>
 // the report scope select reuses the full clustered office directory from the
 // dashboard filter so both lists always match.
 (function() {
 const src = document.getElementById('officeFilter');
 const dst = document.getElementById('modalOfficeSelect');
 if (src && dst) {
 dst.innerHTML = src.innerHTML; // preserves optgroups + the server-rendered 'selected' state
 dst.value = src.value; // mirror the dashboard's current office scope
 }
 // Keep AI Assistant link in sync with dashboard office filter so quarterly report respects it
 (function(){
   const link=document.getElementById('side-quarterly');
   const h=document.getElementById('headerOfficeFilter');
   const o=document.getElementById('officeFilter');
   function curOffice(){ return (h && h.value) ? h.value : (o ? o.value : 'all'); }
   function syncLink(){
     if(!link) return;
     const off=curOffice();
     const url=new URL(link.getAttribute('href'), window.location.origin);
     if(off && off!=='all') url.searchParams.set('office', off);
     else url.searchParams.delete('office');
     link.href=url.toString();
     // also keep quarterly's mobile tab in sync
     const mTab=document.querySelector('a.dash-tab-btn[href*="quarterly-reports"]');
     if(mTab){ mTab.href=url.toString(); }
   }
   syncLink();
   if(h) h.addEventListener('change', syncLink);
   if(o) o.addEventListener('change', syncLink);
   // also observe direct syncHeaderOfficeFilter path (it reloads page, but for SPA-like nav keep synced)
   const origSyncH=window.syncHeaderOfficeFilter;
   if(typeof origSyncH==='function'){
     window.syncHeaderOfficeFilter=function(){ if(h && o){ o.value=h.value; } syncLink(); return origSyncH.apply(this, arguments); };
   }
 })();
 })();
</script>

