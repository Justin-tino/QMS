   async function loadReportSignatories() {
    // 1) server-persistent defaults already rendered via EJS; 2) per-browser override via localStorage takes precedence per-report
    try {
      const p = localStorage.getItem('psau_report_prepared');
      const r = localStorage.getItem('psau_report_reviewed');
      const c = localStorage.getItem('psau_report_certified');
      const elP = document.getElementById('modalPreparedName');
      const elR = document.getElementById('modalReviewedName');
      const elC = document.getElementById('modalCertifiedName');
      if (elP && p) elP.value = p;
      if (elR && r) elR.value = r;
      if (elC && c) elC.value = c;
    } catch(e){}
    // also refresh from server in background to keep Settings changes in sync
    try {
      const resp = await fetch('/admin/api/report-signatories', { headers:{'X-Requested-With':'XMLHttpRequest'}, credentials:'same-origin' });
      if (resp.ok) {
        const j = await resp.json();
        if (j.success && j.signatories) {
          const s=j.signatories;
          const mP=document.getElementById('modalPreparedName');
          const mR=document.getElementById('modalReviewedName');
          const mC=document.getElementById('modalCertifiedName');
          // only overwrite modal if no local override exists
          try {
            if (mP && !localStorage.getItem('psau_report_prepared')) mP.value = s.preparedBy;
            if (mR && !localStorage.getItem('psau_report_reviewed')) mR.value = s.reviewedBy;
            if (mC && !localStorage.getItem('psau_report_certified')) mC.value = s.certifiedBy;
          } catch(e){}
          // also keep Settings card in sync if user hasn't typed there
          const sP=document.getElementById('setPreparedBy'); if(sP && document.activeElement!==sP) sP.value=s.preparedBy;
          const sR=document.getElementById('setReviewedBy'); if(sR && document.activeElement!==sR) sR.value=s.reviewedBy;
          const sC=document.getElementById('setCertifiedBy'); if(sC && document.activeElement!==sC) sC.value=s.certifiedBy;
          const sPP=document.getElementById('setPreparedPos'); if(sPP && document.activeElement!==sPP) sPP.value=s.preparedPos;
          const sRP=document.getElementById('setReviewedPos'); if(sRP && document.activeElement!==sRP) sRP.value=s.reviewedPos;
          const sCP=document.getElementById('setCertifiedPos'); if(sCP && document.activeElement!==sCP) sCP.value=s.certifiedPos;
          const sPD=document.getElementById('setPreparedDate'); if(sPD && document.activeElement!==sPD) sPD.value=s.preparedDate;
          const sRD=document.getElementById('setReviewedDate'); if(sRD && document.activeElement!==sRD) sRD.value=s.reviewedDate;
          const sCD=document.getElementById('setCertifiedDate'); if(sCD && document.activeElement!==sCD) sCD.value=s.certifiedDate;
        }
      }
    } catch(e){}
  }
  function saveReportSignatories() {
    try {
      const elP = document.getElementById('modalPreparedName');
      const elR = document.getElementById('modalReviewedName');
      const elC = document.getElementById('modalCertifiedName');
      if (elP) localStorage.setItem('psau_report_prepared', elP.value.trim());
      if (elR) localStorage.setItem('psau_report_reviewed', elR.value.trim());
      if (elC) localStorage.setItem('psau_report_certified', elC.value.trim());
    } catch(e){}
  }
  // auto-save on input
  document.addEventListener('input', function(e){
    if (e.target && ['modalPreparedName','modalReviewedName','modalCertifiedName'].includes(e.target.id)) saveReportSignatories();
  });

