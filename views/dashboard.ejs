.settings-field .sf-role { display:inline-flex; align-items:center; padding:0.2rem 0.6rem; border-radius:20px; font-size:0.72rem; font-weight:800; text-transform:uppercase; letter-spacing:0.3px; background:#f1f5f9; border:1px solid #e2e8f0; color:#334155; }
.set-icon-circle { width:38px; height:38px; border-radius:10px; display:flex; align-items:center; justify-content:center; font-size:0.98rem; flex-shrink:0; }
