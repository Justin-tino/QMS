      <span><span style="display:inline-block; width:8px; height:8px; border-radius:50%; background:#16a34a; vertical-align:middle; margin-right:0.25rem;"></span>Outstanding</span>
      <span><span style="display:inline-block; width:8px; height:8px; border-radius:50%; background:#d97706; vertical-align:middle; margin-right:0.25rem;"></span>Satisfactory</span>
      <span><span style="display:inline-block; width:8px; height:8px; border-radius:50%; background:#dc2626; vertical-align:middle; margin-right:0.25rem;"></span>Needs Attention</span>
    </div>
  </div>

  <% if (clusteredDepartments && clusteredDepartments.length > 0) { %>
  <div id="kmeansTableContainer" style="overflow-x:auto;">
  <table class="data-table" style="margin-top:0; width:100%; border-collapse:collapse;">
  <thead>
  <tr style="background:#f8fafc; text-align:left;">
  <th style="padding:0.55rem 0.75rem; font-size:0.68rem; text-transform:uppercase; letter-spacing:0.4px; color:#475569; border-bottom:1px solid #e2e8f0; width:56px;">Rank</th>
  <th style="padding:0.55rem 0.75rem; font-size:0.68rem; text-transform:uppercase; letter-spacing:0.4px; color:#475569; border-bottom:1px solid #e2e8f0;">Department / Office</th>
  <th style="padding:0.55rem 0.75rem; font-size:0.68rem; text-transform:uppercase; letter-spacing:0.4px; color:#475569; border-bottom:1px solid #e2e8f0; width:160px;">Avg SQD Rating</th>
  <th style="padding:0.55rem 0.75rem; font-size:0.68rem; text-transform:uppercase; letter-spacing:0.4px; color:#475569; border-bottom:1px solid #e2e8f0; width:220px;">K-Means Assigned Cluster Segment</th>
  </tr>
