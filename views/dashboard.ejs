  function openEditUser(id, email, displayName, isSuspended){ 
    editUserId = id; 
    editUserEmail = email; 
    editUserSuspended = !!isSuspended;

    const emailEl = document.getElementById('editUserEmail');
    if (emailEl) emailEl.textContent = email + (isSuspended ? ' (Suspended Account)' : '');

    const avatarEl = document.getElementById('editModalAvatar');
    if (avatarEl) avatarEl.textContent = (displayName || email || 'S').charAt(0).toUpperCase();

    const nameEl = document.getElementById('editDisplayName');
    if (nameEl) nameEl.value = displayName || email.split('@')[0];

    const pwInput = document.getElementById('editNewPassword');
    if (pwInput) pwInput.value = '';
    const pwConfirmInput = document.getElementById('editConfirmPassword');
    if (pwConfirmInput) pwConfirmInput.value = '';

    const pwMsg = document.getElementById('editPwMsg');
    if (pwMsg) pwMsg.style.display = 'none';

    const editMsg = document.getElementById('editUserMsg');
    if (editMsg) {
      editMsg.style.display = 'none';
      editMsg.textContent = '';
    }

    const suspBtn = document.getElementById('btnSuspend');
    if (suspBtn) {
      if (isSuspended) {
        suspBtn.innerHTML = '<i class="fas fa-rotate-left"></i> Restore Account';
        suspBtn.style.background = '#f0fdf4';
        suspBtn.style.borderColor = '#bbf7d0';
        suspBtn.style.color = '#15803d';
      } else {
        suspBtn.innerHTML = '<i class="fas fa-ban"></i> Suspend Account';
        suspBtn.style.background = '#fffbeb';
        suspBtn.style.borderColor = '#fcd34d';
        suspBtn.style.color = '#92400e';
      }
    }

    const modal = document.getElementById('editUserModal');
    if (modal) modal.style.display = 'block'; 
  }

  function filterUsersTable(){
    const input = document.getElementById('userSearchInput');
    if (!input) return;
    const query = input.value.trim().toLowerCase();
    const rows = document.querySelectorAll('.um-user-row');
    rows.forEach(row => {
      const searchData = row.getAttribute('data-search') || '';
      if (!query || searchData.includes(query)) {
        row.style.display = '';
      } else {
        row.style.display = 'none';
      }
    });
  }

