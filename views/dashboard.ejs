 // ========== FILTER & REPORT FUNCTIONS ==========
 let currentModalMode = '<%= filterType || "overall" %>';

 function toggleFilterTypeControls() {
 const mode = document.getElementById('filterTypeSelect').value;
 document.getElementById('monthFilterGroup').style.display = mode === 'month' ? 'inline-flex' : 'none';
 document.getElementById('rangeFilterGroup').style.display = mode === 'range' ? 'inline-flex' : 'none';
