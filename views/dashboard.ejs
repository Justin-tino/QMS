<script>
 // ========== ML SECTIONS AUTO-UPDATE SYSTEM ==========
 // Polls /admin/api/ml-status every 30 seconds and dynamically updates both ML panels
 (function() {
 const ML_POLL_INTERVAL = 30000; // 30 seconds
 let mlPollTimer = null;
 let lastMlData = null;

 // Helper: Animate a value change with a brief flash effect
 function flashUpdate(el, newValue) {
 if (!el) return;
 const oldValue = el.textContent.trim();
 if (oldValue === String(newValue)) return; // No change, skip animation
 el.style.transform = 'scale(1.12)';
 el.style.opacity = '0.6';
 el.textContent = newValue;
 setTimeout(() => {
 el.style.transform = 'scale(1)';
 el.style.opacity = '1';
 }, 300);
 }

 // Helper: Pulse the live indicator during fetch
 function pulseIndicator(active) {
 const indicator = document.getElementById('mlAutoUpdateIndicator');
 if (!indicator) return;
 if (active) {
 indicator.style.background = 'rgba(33, 150, 243, 0.15)';
 indicator.style.color = '#1976d2';
 indicator.style.borderColor = 'rgba(33, 150, 243, 0.4)';
 indicator.innerHTML = 'Syncing';
 } else {
 indicator.style.background = 'rgba(76, 175, 80, 0.1)';
 indicator.style.color = '#4caf50';
 indicator.style.borderColor = 'rgba(76, 175, 80, 0.25)';
 indicator.innerHTML = 'Live';
 }
 }

 // Update ML Performance Suite (Naïve Bayes) section
 function updateMLPerformance(data) {
 const ml = data.mlMetrics;
 if (!ml) return;

 // Update metric cards
 flashUpdate(document.getElementById('mlCardAccuracy'), ml.accuracy + '%');
 flashUpdate(document.getElementById('mlCardF1'), ml.macroF1 + '%');
 flashUpdate(document.getElementById('mlCardVocab'), ml.vocabularySize);
 flashUpdate(document.getElementById('mlCardSamples'), ml.totalSamples);

 // Update accuracy badge in header
 flashUpdate(document.getElementById('mlAccuracyVal'), ml.accuracy);

 // Update engine status badge
 const engineLabel = document.getElementById('mlEngineLabel');
 const engineBadge = document.getElementById('mlEngineBadge');
 if (engineLabel && engineBadge) {
 if (data.aiEngineStatus === 'dual_active') {
 engineLabel.textContent = 'Dual Engine Active';
 engineBadge.style.background = 'rgba(33, 150, 243, 0.12)';
 engineBadge.style.color = '#1976d2';
 engineBadge.style.borderColor = 'rgba(33, 150, 243, 0.3)';
 } else if (data.aiEngineStatus === 'ai_offline_ml_fallback') {
 engineLabel.textContent = 'ML Fallback Active';
 engineBadge.style.background = 'rgba(255, 152, 0, 0.12)';
 engineBadge.style.color = '#f57c00';
 engineBadge.style.borderColor = 'rgba(255, 152, 0, 0.3)';
 } else {
 engineLabel.textContent = 'Local ML Only';
 engineBadge.style.background = 'rgba(76, 175, 80, 0.12)';
 engineBadge.style.color = '#2e7d32';
 engineBadge.style.borderColor = 'rgba(76, 175, 80, 0.3)';
 }
 }

 // Rebuild Confusion Matrix
 const cmContainer = document.getElementById('mlConfusionMatrixContainer');
 if (cmContainer && ml.confusionMatrix) {
 const categories = Object.keys(ml.confusionMatrix);
 const shortLabels = { 'Positive': 'Pos', 'Negative': 'Neg', 'Neutral': 'Neu', 'Mixed': 'Mix' };
 let cmHtml = `
 <h4 style="font-size: 0.85rem; font-weight: 800; text-transform: uppercase; color: var(--psau-green); margin: 0 0 0.6rem 0; display: flex; align-items: center; gap: 0.4rem;">
 Confusion Matrix (Actual vs Predicted)
 </h4>
 <div style="overflow-x: auto;">
 <table class="data-table" style="font-size: 0.8rem; text-align: center;">
 <thead><tr><th style="text-align:left;">Actual \\ Pred</th>`;
 categories.forEach(c => { cmHtml += `<th>${shortLabels[c] || c}</th>`; });
 cmHtml += `</tr></thead><tbody>`;
 categories.forEach(catActual => {
 cmHtml += `<tr><td style="font-weight: 700; text-align:left;">${catActual}</td>`;
 categories.forEach(catPred => {
 const val = ml.confusionMatrix[catActual][catPred];
 const isMatch = catActual === catPred;
 cmHtml += `<td style="${isMatch ? 'font-weight:800; color:var(--psau-green); background:rgba(76,175,80,0.1);' : 'color:var(--text-muted);'}">${val}</td>`;
 });
 cmHtml += `</tr>`;
 });
 cmHtml += `</tbody></table></div>`;
 cmContainer.innerHTML = cmHtml;
 }

 // Rebuild Per-Category Metrics
 const pcContainer = document.getElementById('mlPerCategoryContainer');
 if (pcContainer && ml.metricsPerCategory) {
 let pcHtml = `
 <h4 style="font-size: 0.85rem; font-weight: 800; text-transform: uppercase; color: var(--psau-green); margin: 0 0 0.6rem 0; display: flex; align-items: center; gap: 0.4rem;">
 Per-Category Performance Metrics
 </h4>
 <div style="overflow-x: auto;">
 <table class="data-table" style="font-size: 0.8rem;">
 <thead><tr><th>Category</th><th>Precision</th><th>Recall</th><th>F1-Score</th></tr></thead>
 <tbody>`;
 Object.keys(ml.metricsPerCategory).forEach(cat => {
 const m = ml.metricsPerCategory[cat];
 pcHtml += `<tr>
 <td style="font-weight: 600;">${cat}</td>
 <td><span style="color:#2e7d32; font-weight:700;">${m.precision}%</span></td>
 <td><span style="color:#1976d2; font-weight:700;">${m.recall}%</span></td>
 <td><span style="color:#7b1fa2; font-weight:700;">${m.f1Score}%</span></td>
 </tr>`;
 });
 pcHtml += `</tbody></table></div>`;
 pcContainer.innerHTML = pcHtml;
 }
 }

 // Update K-Means Clustering section
 function updateKMeansClustering(data) {
 const depts = data.clusteredDepartments;
 const container = document.getElementById('kmeansTableContainer');
 if (!container || !depts) return;

  if (depts.length === 0) {
  container.innerHTML = `
  <div class="ai-empty-state" style="padding:1.25rem; text-align:center;">
  <p style="font-weight:600; color:#334155; margin:0;">No clustering data available.</p>
  <p style="color:#64748b; font-size:0.78rem; margin-top:0.25rem;">Gather feedback responses from multiple departments to perform K-Means (k=3) pattern classification.</p>
  </div>`;
  return;
  }

  let html = `<table class="data-table" style="margin-top:0; width:100%; border-collapse:collapse;">
  <thead><tr style="background:#f8fafc; text-align:left;">
  <th style="padding:0.55rem 0.75rem; font-size:0.68rem; text-transform:uppercase; letter-spacing:0.4px; color:#475569; border-bottom:1px solid #e2e8f0; width:56px;">Rank</th>
  <th style="padding:0.55rem 0.75rem; font-size:0.68rem; text-transform:uppercase; letter-spacing:0.4px; color:#475569; border-bottom:1px solid #e2e8f0;">Department / Office</th>
  <th style="padding:0.55rem 0.75rem; font-size:0.68rem; text-transform:uppercase; letter-spacing:0.4px; color:#475569; border-bottom:1px solid #e2e8f0; width:160px;">Avg SQD Rating</th>
  <th style="padding:0.55rem 0.75rem; font-size:0.68rem; text-transform:uppercase; letter-spacing:0.4px; color:#475569; border-bottom:1px solid #e2e8f0; width:220px;">K-Means Assigned Cluster Segment</th>
  </tr></thead><tbody>`;

  depts.forEach((dept, index) => {
  const pct = Math.min(100, (parseFloat(dept.avgScore) / 5) * 100);
  // Secure: escape department and cluster (quality: no icons/emojis per CAPSTONE)
  const safeName = typeof escH === 'function' ? escH(dept.name) : String(dept.name||'').replace(/</g,'&lt;');
  const safeCluster = typeof escH === 'function' ? escH(dept.cluster) : String(dept.cluster||'').replace(/</g,'&lt;');
  const safeAvg = String(dept.avgScore||'').replace(/[^0-9.\/]/g,'');
  const lower = String(dept.cluster||'').toLowerCase();
  const isOutstanding = lower.includes('outstanding') || lower.includes('excellent');
  const isNeeds = lower.includes('needs attention') || lower.includes('needs');
  const bg = isOutstanding ? '#f0fdf4' : isNeeds ? '#fef2f2' : '#fffbeb';
  const col = isOutstanding ? '#15803d' : isNeeds ? '#b91c1c' : '#92400e';
  const bd = isOutstanding ? '#bbf7d0' : isNeeds ? '#fecaca' : '#fde68a';

  html += `<tr style="cursor:pointer; border-bottom:1px solid #f1f5f9;" onclick="showOfficeDetailFromRow(this)" data-office="${safeName}" data-rank="${index+1}" data-avg="${safeAvg}" data-cluster="${safeCluster}" title="Click to view office details and respondents">
  <td style="padding:0.55rem 0.75rem; color:#334155; font-weight:600;">${index + 1}</td>
  <td style="padding:0.55rem 0.75rem; font-weight:600; color:#0f172a;">${safeName}</td>
  <td style="padding:0.55rem 0.75rem;">
  <div style="display:flex; align-items:center; gap:0.6rem;">
  <div style="width:72px; background:#f1f5f9; height:6px; border-radius:10px; overflow:hidden; flex-shrink:0;">
  <div style="width: ${pct}%; background:#1b5e20; height:100%;"></div>
  </div>
  <span style="font-size:0.78rem; font-weight:700; color:#1e293b;">${safeAvg}/5.00</span>
  </div>
  </td>
  <td style="padding:0.5rem 0.75rem;">
  <span style="display:inline-block; background:${bg}; color:${col}; border:1px solid ${bd}; padding:0.25rem 0.5rem; border-radius:6px; font-size:0.68rem; font-weight:700; text-transform:uppercase; letter-spacing:0.3px;">${safeCluster}</span>
  </td>
  </tr>`;
  });

 html += `</tbody></table>`;
 container.innerHTML = html;
 }

 // Main polling function
 async function pollMLStatus() {
 try {
 pulseIndicator(true);

 const response = await fetch('/admin/api/ml-status', {
 headers: { 'Accept': 'application/json' },
 credentials: 'same-origin'
 });

 if (!response.ok) {
 console.warn('ML Status API returned:', response.status);
 pulseIndicator(false);
 return;
 }

 const contentType = response.headers.get('content-type') || '';
 if (!contentType.includes('application/json')) {
 // Session may have expired — server returned HTML (login page). Stop spamming errors.
 console.warn('ML Status API returned non-JSON response — stopping poll.');
 stopMLPolling();
 pulseIndicator(false);
 return;
 }

 const data = await response.json();
 if (!data.success) {
 pulseIndicator(false);
 return;
 }

 // Check if data actually changed to avoid unnecessary DOM updates
 const dataHash = JSON.stringify({
 accuracy: data.mlMetrics?.accuracy,
 vocabSize: data.mlMetrics?.vocabularySize,
 totalFeedbacks: data.totalFeedbacks,
 engineStatus: data.aiEngineStatus
 });

 if (lastMlData !== dataHash) {
 console.log(' ML Status updated — refreshing panels...');
 updateMLPerformance(data);
 updateKMeansClustering(data);
 lastMlData = dataHash;
 }

 pulseIndicator(false);
 } catch (err) {
 console.warn('ML Auto-Update poll error:', err.message);
 pulseIndicator(false);
 }
 }

 // Start polling when dashboard tab is active
 function startMLPolling() {
 if (mlPollTimer) return; // Already running
 mlPollTimer = setInterval(pollMLStatus, ML_POLL_INTERVAL);
 console.log(' ML Auto-Update polling started (every ' + (ML_POLL_INTERVAL / 1000) + 's)');
 }

 function stopMLPolling() {
 if (mlPollTimer) {
 clearInterval(mlPollTimer);
 mlPollTimer = null;
 console.log(' ML Auto-Update polling paused.');
 }
 }

  // Auto-start polling when the page loads (only if dashboard tab is visible)
  document.addEventListener('DOMContentLoaded', function() {
  // Restore tab across refreshes: priority 1) URL hash, 2) handoff from quarterly page, 3) last persisted tab
  let tabToRestore = null;
  const hashTab = (location.hash || '').replace('#','').trim();
  const validTabs = ['dashboard','feedback','qr','users','settings'];
  if (hashTab && validTabs.includes(hashTab)) {
    tabToRestore = hashTab;
  } else {
    const savedTab = sessionStorage.getItem('psauTab');
    if (savedTab && validTabs.includes(savedTab)) {
      tabToRestore = savedTab;
      sessionStorage.removeItem('psauTab');
    } else {
      try {
        const lastTab = localStorage.getItem('psau_last_tab') || sessionStorage.getItem('psau_last_tab');
        if (lastTab && validTabs.includes(lastTab)) tabToRestore = lastTab;
      } catch(e){}
    }
  }
  if (tabToRestore) {
    const sec = document.getElementById('section-' + tabToRestore);
    if (sec) switchMainTab(tabToRestore);
  }
  const dashboardSection = document.getElementById('section-dashboard');
 if (dashboardSection && dashboardSection.style.display !== 'none') {
 startMLPolling();
 }

 // Listen for tab switches to start/stop polling
 const origSwitchTab = window.switchMainTab;
 if (typeof origSwitchTab === 'function') {
 window.switchMainTab = function(tab) {
 origSwitchTab(tab);
 if (tab === 'dashboard') {
 startMLPolling();
 pollMLStatus(); // Immediate refresh when switching back
 } else {
 stopMLPolling();
 }
 };
 }

 // Pause polling when tab is not visible (save resources)
 document.addEventListener('visibilitychange', function() {
 if (document.hidden) {
 stopMLPolling();
 } else {
 const dashboardSection = document.getElementById('section-dashboard');
 if (dashboardSection && dashboardSection.style.display !== 'none') {
 startMLPolling();
 pollMLStatus(); // Immediate refresh when tab becomes visible
 }
 }
 });
 });
 })();
</script>

