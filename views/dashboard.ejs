}
.btn-mode-tab.active {
 background: var(--psau-green, #1b5e20);
 color: #fff;
 border-color: var(--psau-green, #1b5e20);
}
.dash-nav-tabs {
 display: flex;
 align-items: center;
 gap: 0.35rem;
 background: rgba(30, 41, 59, 0.7);
 padding: 4px;
 border-radius: 8px;
 border: 1px solid #334155;
}
.dash-tab-btn {
 padding: 0.45rem 0.85rem;
 font-size: 0.82rem;
 font-weight: 600;
 color: #94a3b8;
 background: transparent;
 border: none;
 border-radius: 6px;
 cursor: pointer;
 transition: all 0.2s ease;
 display: inline-flex;
 align-items: center;
 gap: 0.45rem;
 text-decoration: none;
 line-height: 1;
}
.dash-tab-btn:hover {
 color: #ffffff;
 background: rgba(255, 255, 255, 0.08);
}
.dash-tab-btn.active {
  color: #ffffff;
  background: var(--psau-green, #1b5e20);
  font-weight: 700;
  box-shadow: 0 2px 8px rgba(27, 94, 32, 0.4);
}
/* ===== REDESIGNED EXECUTIVE SETTINGS HUB ===== */
.settings-hub-container { width:100%; max-width:100%; margin:0; display:flex; flex-direction:column; gap:1.25rem; }
.settings-banner-card { background:linear-gradient(135deg, #0f172a 0%, #1e293b 100%); border:1px solid #334155; border-radius:20px; padding:1.6rem 1.8rem; color:#ffffff; box-shadow:0 10px 25px -5px rgba(15,23,42,0.25); position:relative; overflow:hidden; }
.settings-banner-card::before { content:''; position:absolute; top:-40px; right:-40px; width:180px; height:180px; border-radius:50%; background:radial-gradient(circle, rgba(27,94,32,0.35) 0%, rgba(27,94,32,0) 70%); pointer-events:none; }
.settings-banner-title { font-size:1.35rem; font-weight:800; font-family:'Plus Jakarta Sans',sans-serif; display:flex; align-items:center; gap:0.65rem; margin:0 0 0.4rem 0; color:#f8fafc; }
.settings-banner-sub { font-size:0.85rem; color:#94a3b8; margin:0 0 1rem 0; line-height:1.5; }
.settings-banner-badges { display:flex; flex-wrap:wrap; gap:0.55rem; }
.settings-badge-pill { display:inline-flex; align-items:center; gap:0.4rem; background:rgba(255,255,255,0.08); border:1px solid rgba(255,255,255,0.12); backdrop-filter:blur(8px); padding:0.3rem 0.75rem; border-radius:30px; font-size:0.73rem; font-weight:600; color:#e2e8f0; }

.settings-card { background:#ffffff; border:1px solid #e2e8f0; border-radius:16px; overflow:hidden; box-shadow:0 4px 12px rgba(15,23,42,0.03); transition:border-color 0.2s ease, box-shadow 0.2s ease; }
.settings-card:hover { border-color:#cbd5e1; box-shadow:0 6px 16px rgba(15,23,42,0.06); }
.settings-card-header { display:flex; align-items:center; justify-content:space-between; padding:1.15rem 1.4rem; background:#ffffff; cursor:pointer; user-select:none; border-bottom:1px solid transparent; transition:background 0.15s ease; }
.settings-card-header:hover { background:#f8fafc; }
.settings-card-header-left { display:flex; align-items:center; gap:1rem; }
.settings-card-icon { width:44px; height:44px; border-radius:12px; display:flex; align-items:center; justify-content:center; font-size:1.15rem; flex-shrink:0; }
.settings-card-title { font-size:1rem; font-weight:700; color:#0f172a; margin:0; line-height:1.25; }
.settings-card-sub { font-size:0.78rem; color:#64748b; margin:0.2rem 0 0 0; }
.settings-chevron { color:#94a3b8; font-size:0.85rem; flex-shrink:0; transition:transform 0.2s ease; }
.settings-card-header[aria-expanded="true"] .settings-chevron { transform:rotate(90deg); color:#0f172a; }

.settings-detail { display:none; padding:1.35rem 1.4rem 1.4rem 1.4rem; background:#f8fafc; border-top:1px solid #e2e8f0; animation:settingsDrop 0.22s ease; }
.settings-detail.open { display:block; }
@keyframes settingsDrop { from { opacity:0; transform:translateY(-4px); } to { opacity:1; transform:translateY(0); } }
.settings-detail .glass { background:#ffffff !important; border:1px solid #e2e8f0; box-shadow:0 1px 4px rgba(15,23,42,0.04); }
.settings-profile-header { display:flex; align-items:center; gap:0.95rem; padding:1rem 1.1rem; background:#ffffff; border:1px solid #e5e7eb; border-radius:14px; margin-bottom:1rem; }
.settings-profile-avatar { width:52px; height:52px; border-radius:50%; background:#eff6ff; color:#2563eb; display:flex; align-items:center; justify-content:center; font-size:1.28rem; flex-shrink:0; }
.settings-profile-name { font-size:1rem; font-weight:800; color:#0f172a; line-height:1.2; }
