<style>
@keyframes spin {
 0% { transform: rotate(0deg); }
 100% { transform: rotate(360deg); }
}
.spinner {
 display: inline-block;
 width: 2rem;
 height: 2rem;
 vertical-align: text-bottom;
 border: 3px solid rgba(27, 94, 32, 0.1);
 border-top-color: var(--psau-green);
 border-radius: 50%;
 animation: spin .75s linear infinite;
}
/* ===== PSAU TIMER — replaces circle spinner ===== */
.psau-timer {
  position: relative;
  width: 44px;
  height: 44px;
  border: 3px solid #e2e8f0;
  border-radius: 50%;
  background: #ffffff;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2px 10px rgba(15,23,42,0.08);
  flex-shrink: 0;
}
.psau-timer::before {
  content: '';
  position: absolute;
  top: -5px;
  left: 50%;
  transform: translateX(-50%);
  width: 10px;
  height: 5px;
  background: #94a3b8;
  border-radius: 2px 2px 0 0;
  border: 1px solid #cbd5e1;
}
.psau-timer-hand {
  position: absolute;
  width: 2.5px;
  height: 15px;
  background: #1b5e20;
  border-radius: 2px;
  top: 50%;
  left: 50%;
  transform-origin: 50% 100%;
  transform: translate(-50%, -100%) rotate(0deg);
  animation: psauTimerTick 1s linear infinite;
}
.psau-timer-center {
  width: 6px;
  height: 6px;
  background: #1b5e20;
  border-radius: 50%;
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 1;
  box-shadow: 0 0 0 2px #ffffff;
}
.psau-timer-text {
  position: absolute;
  bottom: -18px;
  left: 50%;
  transform: translateX(-50%);
  font-size: 0.62rem;
  font-weight: 700;
  color: #64748b;
  background: #f8fafc;
  border: 1px solid #e2e8f0;
  padding: 1px 6px;
  border-radius: 10px;
  white-space: nowrap;
  letter-spacing: 0.2px;
  font-variant-numeric: tabular-nums;
}
@keyframes psauTimerTick {
  from { transform: translate(-50%, -100%) rotate(0deg); }
  to { transform: translate(-50%, -100%) rotate(360deg); }
}
.psau-timer.small {
  width: 18px;
  height: 18px;
  border-width: 2px;
  box-shadow: none;
}
.psau-timer.small::before { width: 6px; height: 3px; top: -3px; }
.psau-timer.small .psau-timer-hand { height: 7px; width: 2px; }
.psau-timer.small .psau-timer-center { width: 3px; height: 3px; }
.psau-timer.small .psau-timer-text { display: none; }
.btn-timer { display: inline-flex; align-items: center; gap: 0.5rem; justify-content: center; }
/* ===== SMOOTH SECTION TRANSITIONS ===== */
@keyframes tabFadeSlideIn {
  from { opacity: 0; transform: translateY(10px); }
  to   { opacity: 1; transform: translateY(0); }
}
.tab-section {
  animation: none;
}
.tab-section.tab-entering {
  animation: tabFadeSlideIn 0.22s cubic-bezier(0.16, 1, 0.3, 1) both;
}
.psau-global-timer {
  position: fixed; inset: 0; background: rgba(15,23,42,0.48); backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px);
  display: none; align-items: center; justify-content: center; z-index: 4000; flex-direction: column; gap: 0.9rem; padding: 1rem;
}
.psau-global-timer.open { display: flex; }
.psau-global-timer-card {
  background: #ffffff; border: 1px solid #e2e8f0; border-radius: 16px; padding: 1.4rem 1.6rem; min-width: 280px; max-width: 360px; text-align: center;
  box-shadow: 0 20px 40px -12px rgba(15,23,42,0.28); display: flex; flex-direction: column; align-items: center; gap: 0.7rem;
}
.psau-global-timer-title { font-family:'Plus Jakarta Sans',sans-serif; font-size:0.92rem; font-weight:800; color:#0f172a; }
.psau-global-timer-sub { font-size:0.76rem; font-weight:500; color:#64748b; text-align:center; line-height:1.4; }
[data-theme='dark'] .psau-timer { background:#0f172a; border-color:#334155; }
[data-theme='dark'] .psau-timer-center { box-shadow:0 0 0 2px #0f172a; }
[data-theme='dark'] .psau-timer-text { background:#1e293b; border-color:#334155; color:#94a3b8; }
[data-theme='dark'] .psau-global-timer-card { background:#0f172a; border-color:#1e293b; }
[data-theme='dark'] .psau-global-timer-title { color:#f1f5f9; }
[data-theme='dark'] .psau-global-timer-sub { color:#94a3b8; }
.btn-refresh-ai-inline:hover {
 background: rgba(255, 255, 255, 0.15) !important;
 border-color: var(--psau-green) !important;
}
.btn-mode-tab {
 padding: 0.55rem 0.65rem;
 font-size: 0.78rem;
 font-weight: 700;
 border: 1px solid var(--border-color, #cbd5e1);
 background: var(--card-bg, #f1f5f9);
 color: var(--text-primary, #475569);
 border-radius: 8px;
