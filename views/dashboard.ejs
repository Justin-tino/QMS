.welcome-card{background:#ffffff;border:1px solid #e2e8f0;border-radius:20px;padding:2rem 1.6rem 1.4rem 1.6rem;min-width:300px;max-width:380px;width:100%;text-align:center;box-shadow:0 20px 50px -12px rgba(15,23,42,0.35),0 8px 16px -8px rgba(15,23,42,0.15);display:flex;flex-direction:column;align-items:center;gap:0.6rem;animation:welcomeCardIn 0.45s cubic-bezier(0.16,1,0.3,1)}
.welcome-emoji{font-size:2.6rem;line-height:1;animation:welcomeBounce 1.2s ease infinite;filter:drop-shadow(0 2px 6px rgba(0,0,0,0.08))}
.welcome-title{font-family:'Plus Jakarta Sans',sans-serif;font-size:1.35rem;font-weight:800;color:#0f172a;margin:0;letter-spacing:-0.02em}
.welcome-sub{font-size:0.82rem;font-weight:600;color:#64748b;margin:0}
.welcome-progress{width:100%;height:6px;background:#f1f5f9;border-radius:10px;overflow:hidden;margin-top:0.4rem;border:1px solid #e2e8f0}
.welcome-progress-bar{height:100%;width:0%;background:linear-gradient(90deg,#1b5e20,#22c55e);border-radius:10px;animation:welcomeProgress 4s linear forwards}
.welcome-timer{display:inline-flex;align-items:center;gap:0.4rem;font-size:0.72rem;font-weight:700;color:#475569;margin-top:0.15rem;font-variant-numeric:tabular-nums}
@keyframes welcomeFadeIn{from{opacity:0}to{opacity:1}}
@keyframes welcomeCardIn{from{transform:translateY(14px) scale(0.98);opacity:0}to{transform:translateY(0) scale(1);opacity:1}}
@keyframes welcomeBounce{0%,100%{transform:translateY(0)}50%{transform:translateY(-6px)}}
@keyframes welcomeProgress{from{width:0%}to{width:100%}}
@keyframes welcomeFadeOut{from{opacity:1;transform:scale(1)}to{opacity:0;transform:scale(0.98)}}
.welcome-overlay.hide{animation:welcomeFadeOut 0.35s ease forwards}
[data-theme='dark'] .welcome-card{background:#0f172a;border-color:#1e293b}
[data-theme='dark'] .welcome-title{color:#f1f5f9}
[data-theme='dark'] .welcome-sub{color:#94a3b8}
[data-theme='dark'] .welcome-progress{background:#1e293b;border-color:#334155}
[data-theme='dark'] .welcome-timer{color:#94a3b8}
</style>
<script>
(function(){
  var ov=document.getElementById('welcomeOverlay');
  var txt=document.getElementById('welcomeTimerText');
  if(!ov) return;
  var start=Date.now();
  var int=setInterval(function(){
    if(!txt) return;
    var elapsed=((Date.now()-start)/1000);
    if(elapsed>4) elapsed=4;
    txt.textContent=elapsed.toFixed(1)+'s / 4.0s';
  },80);
  setTimeout(function(){
    clearInterval(int);
    if(txt) txt.textContent='4.0s / 4.0s';
    ov.classList.add('hide');
    setTimeout(function(){
      if(ov && ov.parentNode) ov.parentNode.removeChild(ov);
    },350);
  },4000);
})();
</script>
<% } %>

