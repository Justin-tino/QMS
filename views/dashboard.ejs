.settings-theme-grid { display:grid; grid-template-columns:1fr 1fr; gap:0.85rem; }
.theme-mode-card { display:flex; align-items:center; gap:0.85rem; padding:1rem 1.15rem; border-radius:12px; border:2px solid #e2e8f0; background:#ffffff; cursor:pointer; transition:all 0.2s ease; }
