 ].map(r => `<div style="display:flex; justify-content:space-between; gap:1rem; padding:0.4rem 0; border-bottom:1px solid #f1f5f9;"><span style="color:#64748b;">${r[0]}</span><span style="text-align:right; color:#0f172a; font-weight:600;">${r[1]}</span></div>`).join('');
 const distRows = ['5','4','3','2','1','N/A'].map(k => {
