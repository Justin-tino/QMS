  <% if (chartData.sqdDist) { %>
  <%
    // Secure + exact Python replication for SQD Summary:
    // sqd_rows = 9 rows (SQD0-8) each with counts per rating; avg = DataFrame.mean() across 9
    // For dashboard, _rs_t5.._rs_t1 are sums across 9 SQDs (same as sum(sqd_rows[5]))
    // Python: valid = avg5+avg4+avg3+avg2+avg1, positive = avg5+avg4, percentage = positive/valid*100 if valid else 0
    // Note: avg5 = _rs_t5/9, so percentage == (sum 4+5)/(sum valid) — kept via _rs_pct below
    let _rs_t5 = 0, _rs_t4 = 0, _rs_t3 = 0, _rs_t2 = 0, _rs_t1 = 0, _rs_tNA = 0;
    if (Array.isArray(chartData.sqdDist)) {
      chartData.sqdDist.forEach(function(d){ _rs_t5 += Number(d['5']||0); _rs_t4 += Number(d['4']||0); _rs_t3 += Number(d['3']||0); _rs_t2 += Number(d['2']||0); _rs_t1 += Number(d['1']||0); _rs_tNA += Number(d['N/A']||0); });
    }
    const _rs_totalValid = _rs_t5 + _rs_t4 + _rs_t3 + _rs_t2 + _rs_t1;
    const _rs_totalEmojis = 5;
    const _rs_totalRespondents = (typeof feedbacks !== 'undefined' && Array.isArray(feedbacks)) ? feedbacks.length : 0;
    const _rs_avg = _rs_totalValid > 0 ? (_rs_totalValid / _rs_totalEmojis).toFixed(2) : '0.00';
    // For audit: avg per SQD (Python's sqd_df.mean()) — not displayed but used for percentage verification
    // Secure: ensure numeric, finite, and handle empty group gracefully
    const _rs_sqdLen = (Array.isArray(chartData.sqdDist) && chartData.sqdDist.length) ? chartData.sqdDist.length : 9;
    const _rs_safe = (v) => (typeof v === 'number' && isFinite(v) ? v : 0);
    const _rs_avgCounts = {
      '5': _rs_safe(_rs_t5/_rs_sqdLen),
      '4': _rs_safe(_rs_t4/_rs_sqdLen),
      '3': _rs_safe(_rs_t3/_rs_sqdLen),
      '2': _rs_safe(_rs_t2/_rs_sqdLen),
      '1': _rs_safe(_rs_t1/_rs_sqdLen),
      'N/A': _rs_safe(_rs_tNA/_rs_sqdLen)
    };
    const _rs_validAvg = _rs_safe(_rs_avgCounts['5']+_rs_avgCounts['4']+_rs_avgCounts['3']+_rs_avgCounts['2']+_rs_avgCounts['1']);
    const _rs_positiveAvg = _rs_safe(_rs_avgCounts['5']+_rs_avgCounts['4']);
    const _rs_fmt = (n) => _rs_safe(n).toFixed(2);
    // _rs_pct below uses sum method — numerically identical to _rs_positiveAvg/_rs_validAvg
    const _rs_rows = [
      { emoji: '&#128512;', char: '😀', label: '5 — Strongly Agree', rating:'5', count: _rs_t5, color: '#ef4444', light: '#fef2f2' },
      { emoji: '&#128578;', char: '🙂', label: '4 — Agree', rating:'4', count: _rs_t4, color: '#f59e0b', light: '#fffbeb' },
      { emoji: '&#128528;', char: '😐', label: '3 — Neutral', rating:'3', count: _rs_t3, color: '#2563eb', light: '#eff6ff' },
      { emoji: '&#128577;', char: '🙁', label: '2 — Disagree', rating:'2', count: _rs_t2, color: '#22c55e', light: '#f0fdf4' },
      { emoji: '&#128545;', char: '😡', label: '1 — Strongly Disagree', rating:'1', count: _rs_t1, color: '#f97316', light: '#fff7ed' }
    ];
    function _rs_pct(c){ return _rs_totalValid > 0 ? ((c / _rs_totalValid) * 100).toFixed(2) : '0.00'; }
  %>
  <div class="glass fade-up hover-lift" style="margin-top:1.5rem; background:#fff; border:1px solid #e5e7eb; border-radius:16px; padding:1.25rem 1.25rem 0.9rem 1.25rem; overflow:hidden;">
    <!-- header -->
    <div style="margin-bottom:1rem;">
        <div style="font-size:1.35rem; font-weight:800; color:#0f172a; line-height:1.1;">SQD Summary</div>
        <div style="font-size:0.82rem; color:#64748b; margin-top:0.15rem;">Overview of SQD ratings for 5-1</div>
    </div>
    <!-- top 4 cards — the computation total now lives in the 4th box -->
    <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap:0.75rem; margin-bottom:0.9rem;">
      <div style="border:1px solid #e5e7eb; border-radius:12px; padding:0.75rem 0.85rem; background:#fff;">
          <div style="font-size:0.7rem; color:#64748b; font-weight:600; text-transform:uppercase; letter-spacing:0.3px;">Total Ratings (5-1)</div>
          <div style="font-size:1.5rem; font-weight:800; color:#2563eb; line-height:1;"><%= Number(_rs_totalValid)||0 %></div>
          <div style="font-size:0.65rem; color:#94a3b8; margin-top:0.15rem;">sum of all 5-1</div>
      </div>
      <div style="border:1px solid #e5e7eb; border-radius:12px; padding:0.75rem 0.85rem; background:#fff;">
          <div style="font-size:0.7rem; color:#64748b; font-weight:600; text-transform:uppercase; letter-spacing:0.3px;">Total Respondents</div>
          <div style="font-size:1.5rem; font-weight:800; color:#16a34a; line-height:1;"><%= Number(_rs_totalRespondents)||0 %></div>
          <div style="font-size:0.65rem; color:#94a3b8; margin-top:0.15rem;">len(group)</div>
      </div>
