  // ===== PSAU UNIFIED DIALOG — replaces native alert/confirm =====
  let _psauResolve = null;
  function _psauShow({title, message, variant='danger', confirmText='OK', cancelText='Cancel', showCancel=true, iconClass}) {
    return new Promise(function(resolve){
      _psauResolve = resolve;
      var overlay = document.getElementById('psauDialog');
      var tEl = document.getElementById('psauDialogTitle');
      var mEl = document.getElementById('psauDialogMessage');
      var iEl = document.getElementById('psauDialogIcon');
      var cBtn = document.getElementById('psauDialogConfirm');
      var xBtn = document.getElementById('psauDialogCancel');
      if (!overlay || !tEl || !mEl || !iEl || !cBtn || !xBtn) return resolve(false);
      // secure: textContent only, never innerHTML with user data
      tEl.textContent = String(title || '');
      mEl.textContent = String(message || '');
      cBtn.textContent = String(confirmText || 'OK');
      xBtn.textContent = String(cancelText || 'Cancel');
      xBtn.style.display = showCancel ? 'inline-flex' : 'none';
      // icon
      var map = {danger:'fa-triangle-exclamation', success:'fa-circle-check', error:'fa-circle-xmark', warning:'fa-triangle-exclamation', info:'fa-circle-info'};
      var v = variant === 'error' ? 'danger' : variant;
      iEl.className = 'psau-dialog-icon variant-' + v;
      iEl.innerHTML = '<i class="fas ' + (iconClass || map[v] || map.danger) + '"></i>';
      cBtn.className = v === 'danger' ? 'psau-btn-danger' : v === 'success' ? 'psau-btn-success' : v === 'warning' ? 'psau-btn-danger' : 'psau-btn-primary';
      if (v === 'success') cBtn.className = 'psau-btn-success';
      if (v === 'info') cBtn.className = 'psau-btn-primary';
      overlay.classList.add('open');
      overlay.style.display = 'flex';
      document.body.style.overflow = 'hidden';
      setTimeout(function(){ try{ cBtn.focus(); }catch(e){} }, 40);
    });
  }
  function _psauClose(result){
    var overlay = document.getElementById('psauDialog');
    if (overlay) { overlay.classList.remove('open'); overlay.style.display = 'none'; }
    document.body.style.overflow = '';
    if (_psauResolve) { var r=_psauResolve; _psauResolve=null; r(result); }
  }
  // attach once
  (function(){
    var ov=document.getElementById('psauDialog');
    var cB=document.getElementById('psauDialogConfirm');
    var xB=document.getElementById('psauDialogCancel');
    if(cB) cB.addEventListener('click', function(){ _psauClose(true); });
    if(xB) xB.addEventListener('click', function(){ _psauClose(false); });
    if(ov) ov.addEventListener('click', function(e){ if(e.target===ov) _psauClose(false); });
    document.addEventListener('keydown', function(e){ var o=document.getElementById('psauDialog'); if(e.key==='Escape' && o && o.style.display!=='none' && o.classList.contains('open')) _psauClose(false); });
  })();
  function psauConfirm(opts){ return _psauShow(Object.assign({showCancel:true, variant:'danger'}, opts)); }
  function psauAlert(opts){ return _psauShow(Object.assign({showCancel:false, variant:'info', confirmText:'Got it'}, opts)); }
  // ===== PSAU TIMER helpers — timer instead of circle =====
  let psauGlobalTimerInt=null, psauGlobalStart=0;
  function showGlobalTimer(title, sub){
    var ov=document.getElementById('psauGlobalTimer');
    var t=document.getElementById('psauGlobalTimerTitle');
    var s=document.getElementById('psauGlobalTimerSub');
    var e=document.getElementById('psauGlobalTimerElapsed');
    if(!ov) return;
    if(t) t.textContent=String(title||'Loading...');
    if(s) s.innerHTML='Please wait <span id="psauGlobalTimerElapsed" style="font-weight:800; color:#1b5e20;">0.0s</span>';
    // re-acquire elapsed span after innerHTML
    e=document.getElementById('psauGlobalTimerElapsed');
    ov.style.display='flex'; ov.classList.add('open');
    document.body.style.overflow='hidden';
    psauGlobalStart=Date.now();
    if(psauGlobalTimerInt) clearInterval(psauGlobalTimerInt);
    psauGlobalTimerInt=setInterval(function(){
      var el=document.getElementById('psauGlobalTimerElapsed');
      if(!el) return;
      var sec=((Date.now()-psauGlobalStart)/1000).toFixed(1);
      el.textContent=sec+'s';
    },100);
  }
  function hideGlobalTimer(){
    var ov=document.getElementById('psauGlobalTimer');
    if(ov){ ov.style.display='none'; ov.classList.remove('open'); }
    document.body.style.overflow='';
    if(psauGlobalTimerInt){ clearInterval(psauGlobalTimerInt); psauGlobalTimerInt=null; }
  }
  function startButtonTimer(btn, baseText){
    if(!btn) return;
    if(btn.dataset.origHtml===undefined) btn.dataset.origHtml=btn.innerHTML;
    if(btn.dataset.timerInt) clearInterval(parseInt(btn.dataset.timerInt));
    var start=Date.now();
    btn.disabled=true;
    btn.classList.add('btn-timer');
    btn.setAttribute('aria-busy','true');
    var update=function(){
      var sec=((Date.now()-start)/1000).toFixed(1);
      btn.innerHTML='<span class="psau-timer small" aria-hidden="true"><span class="psau-timer-hand"></span><span class="psau-timer-center"></span></span> '+String(baseText||'Loading...')+' <span style="font-weight:800; font-variant-numeric:tabular-nums;">'+sec+'s</span>';
    };
    update();
    var intId=setInterval(update,100);
    btn.dataset.timerInt=String(intId);
    btn.dataset.timerStart=String(start);
  }
  function stopButtonTimer(btn, restoreHtml){
    if(!btn) return;
    var intId=btn.dataset.timerInt;
    if(intId) clearInterval(parseInt(intId));
    delete btn.dataset.timerInt;
    delete btn.dataset.timerStart;
    btn.disabled=false;
    btn.classList.remove('btn-timer');
    btn.removeAttribute('aria-busy');
    if(restoreHtml!==undefined) btn.innerHTML=restoreHtml;
    else if(btn.dataset.origHtml!==undefined) { btn.innerHTML=btn.dataset.origHtml; delete btn.dataset.origHtml; }
  }

 async function revokeUser(id,email){
  var safeEmail = String(email || '');
  var ok = await psauConfirm({
    title: 'Revoke Employee',
    message: 'Revoke employee ' + safeEmail + '? Their account will be permanently deleted. This cannot be undone.',
    confirmText: 'Revoke',
    cancelText: 'Cancel',
    variant: 'danger',
    iconClass: 'fa-user-xmark'
  });
  if (!ok) return;
  try{
    const r=await fetch('/admin/users/delete',{ method:'POST', headers:{'Content-Type':'application/json','X-Requested-With':'XMLHttpRequest'}, body: JSON.stringify({ id, _csrf: '<%= csrfToken %>' }) });
    const j=await r.json();
    if(j.success){
      await psauAlert({title:'Account Revoked', message:'Revoked ' + safeEmail, variant:'success', iconClass:'fa-circle-check'});
      location.reload();
    } else {
      await psauAlert({title:'Failed to revoke', message: j.error || 'Failed to revoke', variant:'error'});
    }
  }catch(e){
    await psauAlert({title:'Network Error', message:'Network error. Please try again.', variant:'error'});
  }
 }

