   function buildReportParams() {
  const params = new URLSearchParams();
  // Enforce dashboard filter — if dashboard is office-scoped, report must be too (prevents All when filtered)
  const filteredOffice=getDashboardFilteredOffice();
  let office='all';
  if(filteredOffice && filteredOffice!=='all'){
    office=filteredOffice;
  } else {
    const officeSelect = document.getElementById('modalOfficeSelect');
    office = officeSelect ? officeSelect.value : 'all';
  }
  if (office !== 'all') params.set('office', office);

  params.set('filterType', currentModalMode);

  if (currentModalMode === 'month') {
  const monthInput = document.getElementById('modalMonthInput');
  if (monthInput && monthInput.value) params.set('month', monthInput.value);
  } else if (currentModalMode === 'range') {
  const dFrom = document.getElementById('modalDateFrom');
  const dTo = document.getElementById('modalDateTo');
  if (dFrom && dFrom.value) params.set('dateFrom', dFrom.value);
  if (dTo && dTo.value) params.set('dateTo', dTo.value);
  }
  // signatories — editable
  const elP = document.getElementById('modalPreparedName');
  const elR = document.getElementById('modalReviewedName');
  const elC = document.getElementById('modalCertifiedName');
  if (elP && elP.value.trim()) params.set('preparedBy', elP.value.trim());
  if (elR && elR.value.trim()) params.set('reviewedBy', elR.value.trim());
  if (elC && elC.value.trim()) params.set('certifiedBy', elC.value.trim());
  try { saveReportSignatories(); } catch(e){}
  return params;
  }

 // On-screen report viewer with animated loading (spinner + progress + rotating steps)
 let reportViewerParams = null;
 let reportLoadingTimer = null;
 const REPORT_LOADING_STEPS = [
 'Gathering feedback records',
 'Computing SQD dimension averages',
 'Analyzing trilingual sentiment',
 'Ranking department performance',
 'Compiling demographics breakdown',
 'Formatting publication report'
 ];

 function startReportLoadingAnimation() {
 let stepIdx = 0;
 const bar = document.getElementById('reportLoadingBar');
 const stepEl = document.getElementById('reportLoadingStep');
 const timerEl = document.getElementById('reportTimerText');
 if (bar) bar.style.width = '8%';
 if (stepEl) stepEl.textContent = REPORT_LOADING_STEPS[0];
 if (timerEl) timerEl.textContent = '0.0s';
 let rStart = Date.now();
 let rInt = setInterval(function(){
   const te = document.getElementById('reportTimerText');
   if (te) te.textContent = ((Date.now() - rStart)/1000).toFixed(1) + 's';
 }, 100);
 reportLoadingTimer = setInterval(() => {
 stepIdx = Math.min(stepIdx + 1, REPORT_LOADING_STEPS.length - 1);
 if (stepEl) stepEl.textContent = REPORT_LOADING_STEPS[stepIdx];
 if (bar) bar.style.width = (8 + (stepIdx / (REPORT_LOADING_STEPS.length - 1)) * 82) + '%';
 }, 900);
 reportLoadingTimer._rInt = rInt;
 reportLoadingTimer._rStart = rStart;
 }

 function finishReportLoading(success) {
 if (reportLoadingTimer) { clearInterval(reportLoadingTimer); if(reportLoadingTimer._rInt) clearInterval(reportLoadingTimer._rInt); reportLoadingTimer = null; }
 const loading = document.getElementById('reportViewerLoading');
 const bar = document.getElementById('reportLoadingBar');
 const stepEl = document.getElementById('reportLoadingStep');
 const titleEl = document.getElementById('reportLoadingTitle');
 if (success) {
 if (bar) bar.style.width = '100%';
 if (stepEl) stepEl.textContent = 'Done';
 setTimeout(() => { if (loading) loading.style.display = 'none'; }, 350);
 } else {
 if (loading) loading.style.display = 'flex';
 if (titleEl) titleEl.textContent = 'Failed to generate report';
 if (stepEl) stepEl.textContent = 'Please check your connection and try again.';
 if (bar) bar.style.width = '100%';
 if (bar) bar.style.background = '#dc2626';
 }
 }

 async function showReportOnScreen() {
 reportViewerParams = buildReportParams();
 const overlay = document.getElementById('reportViewerOverlay');
 const loading = document.getElementById('reportViewerLoading');
 const titleEl = document.getElementById('reportLoadingTitle');
 const bar = document.getElementById('reportLoadingBar');
 // Reset loading state visuals
 if (titleEl) titleEl.textContent = 'Compiling your report...';
 if (bar) { bar.style.background = '#1b5e20'; bar.style.width = '8%'; }
 if (loading) loading.style.display = 'flex';
 const officeSel = document.getElementById('modalOfficeSelect');
 const scopeEl = document.getElementById('reportViewerScope');
 if (scopeEl) scopeEl.textContent = officeSel && officeSel.value !== 'all' ? '— ' + officeSel.value : '— All Offices / Departments';
 overlay.style.display = 'block';
 document.body.style.overflow = 'hidden';
 startReportLoadingAnimation();

 // Render the full report page in a same-origin iframe — complete CSS fidelity
 // (the report's own stylesheet travels with it, isolated from dashboard styles).
 const frame = document.getElementById('reportViewerFrame');
 frame.onload = () => {
 try {
 const d = frame.contentDocument;
 if (d && d.body) {
 // Strip the report's own action bar — the viewer provides the single Download action
 const ab = d.querySelector('.action-bar');
 if (ab) ab.remove();
 const txt = d.body.innerText || '';
 if (txt.includes('Error generating report')) { finishReportLoading(false); return; }
 }
 } catch (e) { /* same-origin only; ignore */ }
 finishReportLoading(true);
 };
 frame.src = '/admin/report?' + reportViewerParams.toString();
 }

