   <tbody>
  <% clusteredDepartments.forEach(function(dept, index) { %>
  <tr class="<%= index >= 5 ? 'extra-dept-row' : '' %>" style="<%= index >= 5 ? 'display:none; ' : '' %>cursor:pointer; border-bottom:1px solid #f1f5f9;" onclick="showOfficeDetailFromRow(this)" data-office="<%= dept.name %>" data-rank="<%= index + 1 %>" data-avg="<%= dept.avgScore %>" data-cluster="<%= dept.cluster %>" title="Click to view office details and respondents">
  <td style="padding:0.55rem 0.75rem; color:#334155; font-weight:600;"><%= index + 1 %></td>
  <td style="padding:0.55rem 0.75rem; font-weight:600; color:#0f172a;"><%= dept.name %></td>
  <td style="padding:0.55rem 0.75rem;">
  <div style="display:flex; align-items:center; gap:0.6rem;">
  <div style="width:72px; background:#f1f5f9; height:6px; border-radius:10px; overflow:hidden; flex-shrink:0;">
  <div style="width: <%= Math.min(100, (parseFloat(dept.avgScore) / 5) * 100) %>%; background:#1b5e20; height:100%;"></div>
  </div>
  <span style="font-size:0.78rem; font-weight:700; color:#1e293b;"><%= dept.avgScore %>/5.00</span>
  </div>
  </td>
  <td style="padding:0.5rem 0.75rem;">
  <% 
    // CAPSTONE: 3 segments — keep text only, no icons/emojis
    var clusterLabel = String(dept.cluster||'').trim();
    var normalized = clusterLabel.toLowerCase();
    var isOutstanding = normalized.includes('outstanding') || normalized.includes('excellent');
    var isNeeds = normalized.includes('needs attention') || normalized.includes('needs');
    var bg = isOutstanding ? '#f0fdf4' : isNeeds ? '#fef2f2' : '#fffbeb';
    var col = isOutstanding ? '#15803d' : isNeeds ? '#b91c1c' : '#92400e';
    var bd = isOutstanding ? '#bbf7d0' : isNeeds ? '#fecaca' : '#fde68a';
  %>
  <span style="display:inline-block; background:<%= bg %>; color:<%= col %>; border:1px solid <%= bd %>; padding:0.25rem 0.5rem; border-radius:6px; font-size:0.68rem; font-weight:700; text-transform:uppercase; letter-spacing:0.3px;"><%= clusterLabel %></span>
  </td>
  </tr>
  <% }); %>
   </tbody>
  </table>
  </div>
  <% if (clusteredDepartments.length > 5) { %>
  <div id="deptRankingsToggleWrap" style="padding:0.7rem 1rem; text-align:center; border-top:1px solid #e2e8f0; background:#f8fafc;">
    <button type="button" id="deptRankingsToggleBtn" data-total="<%= clusteredDepartments.length %>" onclick="toggleDeptRankings()" style="background:#ffffff; border:1px solid #e2e8f0; color:#1b5e20; font-weight:700; font-size:0.78rem; padding:0.45rem 1rem; border-radius:20px; cursor:pointer; display:inline-flex; align-items:center; gap:0.35rem; transition:all .15s; box-shadow:0 1px 3px rgba(15,23,42,0.04);">
      <span id="deptRankingsToggleText">View All (<%= clusteredDepartments.length %>)</span> <i id="deptRankingsToggleIcon" class="fas fa-chevron-down" style="font-size:0.68rem; transition:transform .2s;"></i>
    </button>
  </div>
  <% } %>
  <% } else { %>
  <div class="ai-empty-state" style="padding:1.25rem; text-align:center;">
  <p style="font-weight:600; color:#334155; margin:0;">No clustering data available.</p>
  <p style="color:#64748b; font-size:0.78rem; margin-top:0.25rem;">Gather feedback responses from multiple departments to perform K-Means (k=3) pattern classification.</p>
  </div>
  <% } %>
  </div>
 </div>
<script>
function toggleDeptRankings(){
  const rows=document.querySelectorAll('.extra-dept-row');
  const txt=document.getElementById('deptRankingsToggleText');
  const icon=document.getElementById('deptRankingsToggleIcon');
  const btn=document.getElementById('deptRankingsToggleBtn');
  if(!rows.length) return;
  const isCollapsed = rows[0].style.display==='none';
  rows.forEach(r=>{ r.style.display=isCollapsed?'':'none'; });
  const total=btn&&btn.getAttribute('data-total')?btn.getAttribute('data-total'):String(rows.length+5);
  if(txt) txt.textContent=isCollapsed?'View Less':'View All ('+total+')';
  if(icon) icon.style.transform=isCollapsed?'rotate(180deg)':'rotate(0deg)';
  if(isCollapsed){
    // smooth scroll to bottom of expanded list
    const wrap=document.getElementById('kmeansTableContainer');
    if(wrap) wrap.scrollIntoView({behavior:'smooth', block:'nearest'});
  }
  // subtle pulse on button
  if(btn){ btn.style.transform='scale(0.97)'; setTimeout(()=>{ btn.style.transform='scale(1)'; },140); }
}
</script>
