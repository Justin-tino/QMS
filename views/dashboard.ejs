          </tr>
        </thead>
        <tbody>
          <% _rs_rows.forEach(function(r){ const pct = _rs_pct(r.count); %>
          <tr style="border-bottom:1px solid #f8fafc; cursor:pointer;" onclick="showSqdSummaryDetail('<%= r.rating %>')" onmouseover="this.style.background='#f8fafc'" onmouseout="this.style.background=''">
            <td style="padding:0.62rem 0.5rem; cursor:pointer;" onclick="event.stopPropagation(); showSqdSummaryDetail('<%= r.rating %>')" onmouseover="this.style.background='#f1f5f9'" onmouseout="this.style.background=''">
              <span style="font-size:1.35rem; vertical-align:middle; margin-right:0.4rem;"><%- r.emoji %></span>
              <span style="font-weight:500; color:#0f172a;"><%= r.label %></span>
            </td>
