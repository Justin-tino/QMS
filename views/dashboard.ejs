 function applyFilters() {
 const params = new URLSearchParams();
 const office = document.getElementById('officeFilter').value;
 if (office !== 'all') params.set('office', office);

 const filterType = document.getElementById('filterTypeSelect').value;
 params.set('filterType', filterType);

 if (filterType === 'month') {
 const monthVal = document.getElementById('monthFilter').value;
 if (monthVal) params.set('month', monthVal);
 } else if (filterType === 'range') {
 const dateFrom = document.getElementById('dateFrom').value;
 const dateTo = document.getElementById('dateTo').value;
 if (dateFrom) params.set('dateFrom', dateFrom);
 if (dateTo) params.set('dateTo', dateTo);
 }

  // persist for follower tabs/pages (AI Assistant, Feedback, QR, Users, Settings)
  try{
    const _ft=document.getElementById('filterTypeSelect')?.value||'overall';
    const _df=document.getElementById('dateFrom')?.value||'';
    const _dt=document.getElementById('dateTo')?.value||'';
    const _mv=document.getElementById('monthFilter')?.value||'';
    const _off=document.getElementById('officeFilter')?.value||document.getElementById('headerOfficeFilter')?.value||'all';
    const _bt=document.getElementById('dashDateBadgeText')?.textContent?.trim()||'';
    let _badgeForStore=_bt;
    if(_ft==='range'&&_df&&_dt&&_df===_dt){ try{ _badgeForStore=new Date(_df).toLocaleDateString('en-PH',{year:'numeric',month:'long',day:'numeric'}); }catch(e){ _badgeForStore=_df; } }
    else if(_ft==='range'&&( _df||_dt)){ _badgeForStore=_df&&_dt?(_df+' to '+_dt):(_df||_dt); }
    else if(_ft==='month'&&_mv){ try{ const p=_mv.split('-'); const mn=['January','February','March','April','May','June','July','August','September','October','November','December']; _badgeForStore=mn[parseInt(p[1])-1]+' '+p[0]; }catch(e){} }
    const _payload={filterType:_ft,dateFrom:_df,dateTo:_dt,monthVal:_mv,badgeText:_badgeForStore,office:_off,ts:Date.now()};
    try{ localStorage.setItem('psau_global_dateFilter', JSON.stringify(_payload)); }catch(e){}
  }catch(e){}
  showGlobalTimer('Applying filters...', '');
   setTimeout(function(){ window.location.href = '/admin/dashboard?' + params.toString(); }, 250);
  }

  // ===== GLOBAL DATE FOLLOWER — Dashboard is sole writer, others just display =====
  function loadGlobalDateFilter(){ try{ const r=localStorage.getItem('psau_global_dateFilter'); return r?JSON.parse(r):null; }catch(e){ return null; } }
  function getGlobalDateDisplayText(){
    const gf=loadGlobalDateFilter();
    if(!gf) {
      // fallback to current URL/server state if no stored filter (first visit) — read live DOM
      try{
        const ft=document.getElementById('filterTypeSelect')?.value||'overall';
        const df=document.getElementById('dateFrom')?.value||'';
        const dt=document.getElementById('dateTo')?.value||'';
        const bt=document.getElementById('dashDateBadgeText')?.textContent?.trim()||'';
        if(ft==='range'&&df&&dt&&df===dt){ const d=new Date(df); if(!isNaN(d.getTime())) return d.toLocaleDateString('en-PH',{year:'numeric',month:'long',day:'numeric'}); }
        if((ft==='range'&&(df||dt))||ft==='month'){ return bt||null; }
      }catch(e){}
      return null;
    }
    if(gf.filterType==='range'&&gf.dateFrom&&gf.dateTo&&gf.dateFrom===gf.dateTo){
      try{ const d=new Date(gf.dateFrom); if(!isNaN(d.getTime())) return d.toLocaleDateString('en-PH',{year:'numeric',month:'long',day:'numeric'}); }catch(e){}
      return gf.dateFrom;
    }
    if(gf.filterType==='range'&&(gf.dateFrom||gf.dateTo)){
      return gf.badgeText|| (gf.dateFrom&&gf.dateTo?gf.dateFrom+' to '+gf.dateTo:(gf.dateFrom||gf.dateTo));
    }
    if(gf.filterType==='month'&&gf.badgeText) return gf.badgeText;
    if(gf.filterType==='overall') return null;
    return gf.badgeText||null;
  }
  function updateAllGlobalDateContexts(){
    // User requested: only Dashboard shows date — hide follower banners but keep filter following internally
    ['feedback','qr','users','settings'].forEach(function(tab){
      const el=document.getElementById('globalDateContext-'+tab);
      if(el) el.style.display='none';
    });
  }
  function syncGlobalDateFromUrlToStorage(){
    try{
      const ft=document.getElementById('filterTypeSelect')?.value||'overall';
      const df=document.getElementById('dateFrom')?.value||'';
      const dt=document.getElementById('dateTo')?.value||'';
      const mv=document.getElementById('monthFilter')?.value||'';
      const bt=document.getElementById('dashDateBadgeText')?.textContent?.trim()||'';
      const off=document.getElementById('officeFilter')?.value||document.getElementById('headerOfficeFilter')?.value||'all';
      const payload={filterType:ft,dateFrom:df,dateTo:dt,monthVal:mv,badgeText:bt,office:off,ts:Date.now()};
      localStorage.setItem('psau_global_dateFilter', JSON.stringify(payload));
    }catch(e){}
  }
  function getQuarterFromMonth(m){ if(m<=2) return 'Q1'; if(m<=5) return 'Q2'; if(m<=8) return 'Q3'; return 'Q4'; }
  function updateQuarterlyNavLinks(){
    try{
      const gf=loadGlobalDateFilter();
      if(!gf || gf.filterType==='overall') return;
      let dateStr='';
      let year=null; let quarter=null;
      if(gf.filterType==='range' && gf.dateFrom){
        dateStr=gf.dateFrom;
        const d=new Date(gf.dateFrom);
        if(!isNaN(d.getTime())){ year=d.getFullYear(); quarter=getQuarterFromMonth(d.getMonth()); }
      } else if(gf.filterType==='month' && gf.monthVal){
        const p=gf.monthVal.split('-'); year=parseInt(p[0]); const m=parseInt(p[1])-1; quarter=getQuarterFromMonth(m); dateStr=gf.monthVal+'-01';
      }
      if(!year||!quarter) return;
      const base='/admin/quarterly-reports';
      document.querySelectorAll('a[href="/admin/quarterly-reports"], a.side-link[href="/admin/quarterly-reports"], a.dash-tab-btn[href="/admin/quarterly-reports"]').forEach(function(a){
        try{
          const u=new URL(a.getAttribute('href'), window.location.origin);
          if(!u.searchParams.has('year')) u.searchParams.set('year', year);
          if(!u.searchParams.has('quarter')) u.searchParams.set('quarter', quarter);
          if(dateStr && !u.searchParams.has('date')) u.searchParams.set('date', dateStr);
          a.setAttribute('href', u.pathname + '?' + u.searchParams.toString());
          // also intercept click to ensure params fresh
          a.addEventListener('click', function(e){
            try{
              const cur=loadGlobalDateFilter();
              if(!cur || cur.filterType==='overall') return;
              let ds=''; let yr=null; let qr=null;
              if(cur.filterType==='range' && cur.dateFrom){ ds=cur.dateFrom; const dd=new Date(cur.dateFrom); if(!isNaN(dd.getTime())){ yr=dd.getFullYear(); qr=getQuarterFromMonth(dd.getMonth()); } }
              else if(cur.filterType==='month' && cur.monthVal){ const pp=cur.monthVal.split('-'); yr=parseInt(pp[0]); qr=getQuarterFromMonth(parseInt(pp[1])-1); ds=cur.monthVal+'-01'; }
              if(yr&&qr){ e.preventDefault(); const nu=new URL('/admin/quarterly-reports', window.location.origin); nu.searchParams.set('year',yr); nu.searchParams.set('quarter',qr); if(ds) nu.searchParams.set('date',ds); if(cur.office&&cur.office!=='all') nu.searchParams.set('office',cur.office); window.location.href=nu.toString(); }
            }catch(err){}
          }, {once:true});
        }catch(e){}
      });
    }catch(e){}
  }

  function setQuickRange(preset){
 const ft=document.getElementById('filterTypeSelect');
 const df=document.getElementById('dateFrom');
 const dt=document.getElementById('dateTo');
 const today=new Date();
 const fmt=d=> d.toISOString().split('T')[0];
 let from=null,to=new Date(today);
 if(preset==='7'){ from=new Date(today); from.setDate(today.getDate()-7); }
 else if(preset==='30'){ from=new Date(today); from.setDate(today.getDate()-30); }
 else if(preset==='90'){ from=new Date(today); from.setDate(today.getDate()-90); }
 else if(preset==='thisYear'){ from=new Date(today.getFullYear(),0,1); }
 if(from){ ft.value='range'; toggleFilterTypeControls(); if(df) df.value=fmt(from); if(dt) dt.value=fmt(to); setTimeout(()=> applyFilters(), 80); }
 }

 // ========== CLICKABLE DATE BADGE — admin & employee, any previous date/year/day ==========
 // Secure: validates YYYY-MM-DD via regex + Date check, sanitizes before navigation. Same stack: vanilla JS + existing filter infra.
  function toggleDashDatePicker(){
    const pop=document.getElementById('dashDatePopover');
    const badge=document.getElementById('dashDateBadge');
    const inp=document.getElementById('dashDatePickerInput');
    if(!pop || !badge) return;
    const isHidden = pop.style.display==='none' || !pop.style.display || getComputedStyle(pop).display==='none';
    if(isHidden){
      pop.style.display='block';
      pop.style.position='fixed';
      pop.style.zIndex='5000';
      pop.style.left='auto';
      pop.style.right='auto';
      pop.style.width='280px';
      pop.style.maxWidth='min(92vw, 300px)';
      pop.style.boxSizing='border-box';
      const rect=badge.getBoundingClientRect();
      void pop.offsetWidth;
      const w=pop.getBoundingClientRect().width || 280;
      const h=pop.getBoundingClientRect().height || 220;
      let top=rect.bottom + 8;
      let rightGap = window.innerWidth - rect.right;
      // right-align popover with badge right edge using right property
      let right = rightGap;
      // if pop would overflow left side, switch to left anchoring
      let leftEdge = window.innerWidth - right - w;
      if(leftEdge < 8){
        pop.style.left='8px';
        pop.style.right='auto';
        pop.style.top=top + 'px';
      } else {
        pop.style.right=right + 'px';
        pop.style.left='auto';
        pop.style.top=top + 'px';
      }
      // flip above if would overflow bottom
      requestAnimationFrame(function(){
        const pr=pop.getBoundingClientRect();
        if(pr.bottom > window.innerHeight - 8){
          const alt = rect.top - pr.height - 8;
          pop.style.top = (alt >= 8 ? alt : Math.max(8, window.innerHeight - pr.height - 8)) + 'px';
        }
        if(pr.right > window.innerWidth - 8){
          pop.style.right='8px';
          pop.style.left='auto';
        }
        if(pr.left < 8){
          pop.style.left='8px';
          pop.style.right='auto';
        }
      });
      if(inp){
        const df=document.getElementById('dateFrom')?.value;
        const dt=document.getElementById('dateTo')?.value;
        if(df && dt && df===dt) inp.value=df;
        else if(df) inp.value=df;
        else try{ inp.valueAsDate = new Date(); }catch(e){ inp.value=new Date().toISOString().split('T')[0]; }
        setTimeout(function(){ try{inp.focus(); if(inp.showPicker) inp.showPicker(); }catch(e){} }, 30);
      }
    } else {
      pop.style.display='none';
    }
  }
