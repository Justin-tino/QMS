/* Dark mode for dialogs */
[data-theme='dark'] .psau-dialog-card { background:#0f172a; border-color:#1e293b; }
[data-theme='dark'] .psau-dialog-title { color:#f1f5f9; }
[data-theme='dark'] .psau-dialog-message { color:#94a3b8; }
