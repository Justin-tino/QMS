<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<script>
 // ========== TAB NAVIGATION ==========
 let _tabSwitching = false;
 function switchMainTab(tab) {
  // Debounce rapid clicks
  if (_tabSwitching) return;
  _tabSwitching = true;
  setTimeout(() => { _tabSwitching = false; }, 250);

  // Fade out current visible section, then swap
  const currentSection = document.querySelector('.tab-section:not([style*="display: none"]):not([style*="display:none"])');
  const nextSection = document.getElementById('section-' + tab);

  function _showNext() {
   // Hide all, show next with animation
   document.querySelectorAll('.tab-section').forEach(s => {
    s.style.display = 'none';
    s.classList.remove('tab-entering');
   });
   if (nextSection) {
    nextSection.style.display = 'block';
    // Force reflow so animation triggers
    void nextSection.offsetWidth;
    nextSection.classList.add('tab-entering');
   }
  }

  if (currentSection && currentSection !== nextSection) {
   // Brief fade-out on the leaving section
   currentSection.style.transition = 'opacity 0.12s ease, transform 0.12s ease';
   currentSection.style.opacity = '0';
   currentSection.style.transform = 'translateY(-6px)';
   setTimeout(() => {
    currentSection.style.transition = '';
    currentSection.style.opacity = '';
    currentSection.style.transform = '';
    _showNext();
   }, 120);
  } else {
   _showNext();
  }

  // Update nav tab buttons (mobile top tabs)
  document.querySelectorAll('.dash-tab-btn').forEach(b => b.classList.remove('active'));
  const activeBtn = document.getElementById('tabNav-' + tab);
  if (activeBtn) activeBtn.classList.add('active');

  // Update sidebar active state
  document.querySelectorAll('.side-link').forEach(l => l.classList.remove('active'));
  const activeSide = document.getElementById('side-' + tab);
  if (activeSide) activeSide.classList.add('active');

  // Update page header title & subtitle (i18n-aware via admin-ui.js)
  const T = (window.PSAU_UI && PSAU_UI.t) ? PSAU_UI.t : function (k) { return k; };
   const titles = {
  dashboard: [T('dash.title'), T('dash.sub')],
  feedback: [T('fb.title'), T('fb.sub')],
  qr: [T('qr.title'), T('qr.sub')],
  users: [T('users.title'), T('users.sub')],
  settings: [T('settings.title'), T('settings.sub')]
  };
  const filterZone = document.getElementById('filterZone');
  if (filterZone) filterZone.style.display = (tab === 'dashboard' || tab === 'feedback') ? 'block' : 'none';
  const officeFilterWrap = document.getElementById('headerOfficeFilterWrap');
  if (officeFilterWrap) officeFilterWrap.style.display = (tab === 'users' || tab === 'settings' || tab === 'qr') ? 'none' : 'inline-flex';
  // Only Dashboard shows and controls the date — all other tabs hide it (but still follow filter internally)
  const _badge = document.getElementById('dashDateBadge');
  const _isDash = tab === 'dashboard';
  if(_badge){
    _badge.style.display = _isDash ? 'inline-flex' : 'none';
    if(_isDash){
      _badge.style.opacity='1'; _badge.style.cursor='pointer';
      _badge.title='Click to filter by any date/year/day — admin & employee';
      _badge.onclick=toggleDashDatePicker;
    } else {
      _badge.onclick=null;
      const _pop=document.getElementById('dashDatePopover'); if(_pop) _pop.style.display='none';
    }
  }
  const entry = titles[tab] || titles.dashboard;
  const titleEl = document.getElementById('dashHeaderTitle');
  const subtitleEl = document.getElementById('dashHeaderSubtitle');
  if (titleEl && entry) {
   titleEl.textContent = entry[0];
   if(subtitleEl) subtitleEl.textContent = entry[1];
  }
  // Persist tab across refreshes — hash has priority, then local/session storage
  try { localStorage.setItem('psau_last_tab', tab); sessionStorage.setItem('psau_last_tab', tab); } catch(e){}
  try {
   if (history.replaceState) history.replaceState(null, '', '#' + tab);
   else location.hash = tab;
  } catch(e){}
 }

 // ========== USER MANAGEMENT (Paper: Centralized Firestore) ==========
 async function createEmployee(e){
 e.preventDefault();
 const form = document.getElementById('addUserForm');
 // Prefer modal message div; fall back gracefully
 const msg = document.getElementById('addEmpMsg') || document.getElementById('userCreateMsg');
 const btn = document.getElementById('btnCreateUser');
 const fd = new FormData(form);
 const email = (fd.get('email')||'').trim();
 const password = fd.get('password')||'';
 const confirmPassword = fd.get('confirmPassword')||'';
 function showMsg(color, bg, border, text) {
   if (!msg) return;
   msg.style.display = 'block';
   msg.style.color = color;
   msg.style.background = bg;
   msg.style.border = '1px solid ' + border;
   msg.textContent = text;
 }
  if (!msg) return;
  msg.style.display = 'none';
  // Strict email validation with typo detection (frontend instant feedback)
  function getTypoSuggestionFrontend(em){
    if(!em || !em.includes('@')) return null;
    const d = em.trim().toLowerCase().split('@')[1];
    if(!d) return null;
    const map = {'gmai.com':'gmail.com','gmial.com':'gmail.com','gmal.com':'gmail.com','gnail.com':'gmail.com','gmaiil.com':'gmail.com','gmail.con':'gmail.com','gmail.cm':'gmail.com','gmail.co':'gmail.com','hotmai.com':'hotmail.com','hotnail.com':'hotmail.com','yahooo.com':'yahoo.com','yaho.com':'yahoo.com','outlok.com':'outlook.com','icloude.com':'icloud.com'};
    if(map[d]) return map[d];
    const common=['gmail.com','yahoo.com','hotmail.com','outlook.com','icloud.com','psau.edu.ph'];
    function lev(a,b){ const m=a.length,n=b.length; const dp=Array.from({length:m+1},()=>Array(n+1).fill(0)); for(let i=0;i<=m;i++) dp[i][0]=i; for(let j=0;j<=n;j++) dp[0][j]=j; for(let i=1;i<=m;i++) for(let j=1;j<=n;j++) dp[i][j]=Math.min(dp[i-1][j]+1,dp[i][j-1]+1,dp[i-1][j-1]+(a[i-1]===b[j-1]?0:1)); return dp[m][n]; }
    for(const c of common){ if(d!==c && lev(d,c)===1) return c; }
    return null;
  }
  function isValidEmailStrictFrontend(em){
    if(!em || typeof em!=='string') return false;
    em=em.trim();
    if(!em || em.length>200) return false;
    if(!/^[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,63}$/i.test(em)) return false;
    if(em.includes('..')) return false;
    const p=em.split('@'); if(p.length!==2) return false;
    const [l,d]=p; if(!l||!d) return false;
    if(l.startsWith('.')||l.endsWith('.')) return false;
    if(d.startsWith('-')||d.startsWith('.')||d.endsWith('-')||d.endsWith('.')) return false;
    if(!d.includes('.')) return false;
    for(const part of d.split('.')){ if(!part||part.startsWith('-')||part.endsWith('-')) return false; }
    if(!/^[a-z]{2,63}$/i.test(d.split('.').pop())) return false;
    const sug=getTypoSuggestionFrontend(em);
    if(sug) return false;
    return true;
  }
  const emailTrim = email.trim();
  const typoSug = getTypoSuggestionFrontend(emailTrim);
  if(typoSug){
    showMsg('#b91c1c','#fef2f2','#fecaca','Did you mean '+typoSug+'? You typed "'+(emailTrim.split('@')[1]||'')+'". Please correct the email.');
    const inp=document.getElementById('newUserEmail'); if(inp){ inp.style.borderColor='#dc2626'; inp.focus(); setTimeout(()=>inp.style.borderColor='',3000); }
    return;
  }
  if(!isValidEmailStrictFrontend(emailTrim)){
    showMsg('#b91c1c','#fef2f2','#fecaca','Invalid email format. Use name@domain.com (e.g., name@gmail.com).');
    const inp=document.getElementById('newUserEmail'); if(inp){ inp.style.borderColor='#dc2626'; inp.focus(); }
    return;
  }
  if(!email || password.length<8){ showMsg('#b91c1c','#fef2f2','#fecaca','Email and password (≥8 chars, letters+numbers) required.'); return; }
  if(!/[A-Za-z]/.test(password) || !/[0-9]/.test(password)){ showMsg('#b91c1c','#fef2f2','#fecaca','Password must contain at least one letter and one number.'); return; }
  if(password !== confirmPassword){ showMsg('#b91c1c','#fef2f2','#fecaca','Passwords do not match. Please re-type both fields.'); return; }
 startButtonTimer(btn, 'Creating...');
 try{
 const res = await fetch('/admin/users/create', {
 method:'POST',
 headers:{ 'Content-Type':'application/json', 'X-Requested-With':'XMLHttpRequest' },
 body: JSON.stringify({ email, password, _csrf: fd.get('_csrf') })
 });
 const j = await res.json();
 if(j.success){
 showMsg('#15803d','#f0fdf4','#bbf7d0', 'Account created successfully!');
 form.reset();
 setTimeout(()=> location.reload(), 900);
 } else {
 showMsg('#b91c1c','#fef2f2','#fecaca', j.error||'Failed to create account.');
 }
  } catch(err){
  showMsg('#b91c1c','#fef2f2','#fecaca','Network error. Please try again.');
  } finally {
  stopButtonTimer(btn);
  }
  }
  // Live typo hint as user types — shows Did you mean gmail.com? instantly
  (function(){
    const inp = document.getElementById('newUserEmail');
    const hint = document.getElementById('emailTypoHint');
    if(!inp || !hint) return;
    function lev(a,b){ const m=a.length,n=b.length; const dp=Array.from({length:m+1},()=>Array(n+1).fill(0)); for(let i=0;i<=m;i++) dp[i][0]=i; for(let j=0;j<=n;j++) dp[0][j]=j; for(let i=1;i<=m;i++) for(let j=1;j<=n;j++) dp[i][j]=Math.min(dp[i-1][j]+1,dp[i][j-1]+1,dp[i-1][j-1]+(a[i-1]===b[j-1]?0:1)); return dp[m][n]; }
    function getSug(em){
      if(!em||!em.includes('@')) return null;
      const d=em.trim().toLowerCase().split('@')[1]; if(!d) return null;
      const map={'gmai.com':'gmail.com','gmial.com':'gmail.com','gmal.com':'gmail.com','gnail.com':'gmail.com','gmaiil.com':'gmail.com','gmail.con':'gmail.com','gmail.cm':'gmail.com','gmail.co':'gmail.com','hotmai.com':'hotmail.com','hotnail.com':'hotmail.com','yahooo.com':'yahoo.com','yaho.com':'yahoo.com','outlok.com':'outlook.com','icloude.com':'icloud.com'};
      if(map[d]) return map[d];
      const common=['gmail.com','yahoo.com','hotmail.com','outlook.com','icloud.com','psau.edu.ph'];
      for(const c of common){ if(d!==c && lev(d,c)===1) return c; }
      return null;
    }
    inp.addEventListener('input', function(){
      const v = inp.value.trim();
      const sug = getSug(v);
      if(sug){
        hint.style.display='block';
        hint.innerHTML='Did you mean <strong>'+sug+'</strong>? <span style="text-decoration:underline; cursor:pointer;" onclick="document.getElementById(\'newUserEmail\').value=document.getElementById(\'newUserEmail\').value.split(\'@\')[0]+\'@'+sug+'\'; document.getElementById(\'emailTypoHint\').style.display=\'none\';">Click to fix</span> <span style="color:#78716c;">(you typed '+ (v.split('@')[1]||'') +')</span>';
        inp.style.borderColor='#f59e0b';
      } else {
        hint.style.display='none';
        inp.style.borderColor='';
