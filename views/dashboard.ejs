 function filterTableRows() {
 const searchVal = (document.getElementById('fbSearchInput')?.value || '').toLowerCase().trim();
 const genderVal = document.getElementById('fbGenderSelect')?.value || 'all';
 const tanggapanVal = document.getElementById('fbTanggapanSelect')?.value || 'all';
 const rows = document.querySelectorAll('#feedbackTableBody .feedback-row');
 let visibleCount = 0;

 rows.forEach(row => {
 const rowSentiment = row.dataset.sentiment || '';
 const rowGender = row.dataset.gender || '';
 const rowTanggapan = row.dataset.tanggapan || '';
 const rowSearch = row.dataset.search || '';

 const matchesSentiment = (activeSentimentFilter === 'all') || (rowSentiment === activeSentimentFilter);
 const matchesGender = (genderVal === 'all') || (rowGender === genderVal);
 const matchesTanggapan = (tanggapanVal === 'all') || (rowTanggapan === tanggapanVal);
 const matchesSearch = !searchVal || rowSearch.includes(searchVal);

 if (matchesSentiment && matchesGender && matchesTanggapan && matchesSearch) {
 row.style.display = '';
 visibleCount++;
 } else {
 row.style.display = 'none';
 const cb = row.querySelector('.fb-row-checkbox');
 if (cb) cb.checked = false;
 }
 });

 const countEl = document.getElementById('visibleFbCount');
 if (countEl) countEl.textContent = visibleCount;

 const noResults = document.getElementById('noResultsMsg');
 if (noResults) {
 noResults.style.display = (visibleCount === 0 && rows.length > 0) ? 'block' : 'none';
 }

 updateSelectionCount();
 }

 function sortTableRows() {
 const sortVal = document.getElementById('fbSortSelect')?.value || 'date-desc';
 const tbody = document.getElementById('feedbackTableBody');
 if (!tbody) return;

 const rows = Array.from(tbody.querySelectorAll('.feedback-row'));

 rows.sort((a, b) => {
 if (sortVal === 'sqd-desc') {
 return (parseFloat(b.dataset.sqd) || 0) - (parseFloat(a.dataset.sqd) || 0);
 } else if (sortVal === 'sqd-asc') {
 return (parseFloat(a.dataset.sqd) || 0) - (parseFloat(b.dataset.sqd) || 0);
 } else if (sortVal === 'date-asc') {
 return (a.dataset.date || '').localeCompare(b.dataset.date || '');
 } else {
 return (b.dataset.date || '').localeCompare(a.dataset.date || '');
 }
 });

 rows.forEach((row, idx) => {
 const numCell = row.querySelector('.row-num');
 if (numCell) numCell.textContent = idx + 1;
 tbody.appendChild(row);
 });
 }

 function toggleSelectAll(masterCb) {
 const rows = document.querySelectorAll('#feedbackTableBody .feedback-row');
 rows.forEach(row => {
 if (row.style.display !== 'none') {
 const cb = row.querySelector('.fb-row-checkbox');
 if (cb) cb.checked = masterCb.checked;
 }
