 async function executeDeleteAction() {
 if (deleteTargetIds.length === 0) return;

 const btn = document.getElementById('btnExecuteDelete');
 if (btn) {
 startButtonTimer(btn, 'Deleting...');
 }

 try {
 const response = await fetch('/admin/feedback/delete', {
 method: 'POST',
 headers: {
 'Content-Type': 'application/json',
 'X-Requested-With': 'XMLHttpRequest'
 },
 body: JSON.stringify({ ids: deleteTargetIds, _csrf: '<%= csrfToken %>' })
 });

 const result = await response.json();
 if (result.success) {
  // keep branded success via reload (no native dialog); optionally show toast, but reload is the feedback
  window.location.reload();
 } else {
  await psauAlert({title:'Failed to delete', message: result.error || 'Hindi ma-delete ang feedback.', variant:'error', iconClass:'fa-circle-xmark'});
 }
 } catch (err) {
  console.error('Delete feedback error:', err);
  await psauAlert({title:'Network Error', message:'Nagkaroon ng problema sa koneksyon. Pakisubukan ulit.', variant:'error', iconClass:'fa-wifi'});
 } finally {
 if (btn) {
 stopButtonTimer(btn);
 }
 closeDeleteConfirmModal();
 }
 }

