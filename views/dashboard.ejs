 ['Average rating', `<strong style="color:#1b5e20;">${Number(avg).toFixed(2)} / 5.00</strong>`],
 ['Satisfaction % (4 + 5)', `<strong style="color:#1b5e20;">${csmPct}%</strong> of ${valid} valid`],
 ['Performance level', escH(perfLevel(Number(avg)))],
 ['Valid ratings', `${valid} (N/A excluded: ${na})`],
