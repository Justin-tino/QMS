 const valid = ['1','2','3','4','5'].reduce((s,k)=>s+dist[k],0);
 const na = dist['N/A'];
 let mode = '—', modeN = -1;
 ['1','2','3','4','5'].forEach(k => { if (dist[k] > modeN) { modeN = dist[k]; mode = k; } });
 const csmPct = valid > 0 ? ((dist['4'] + dist['5']) / valid * 100).toFixed(1) : '0.0';
 const emojiFor = { '5': '&#128512;', '4': '&#128578;', '3': '&#128528;', '2': '&#128577;', '1': '&#128545;', 'N/A': '&#128683;' };
 const rows = [
 ['Dimension', escH(def.full)],
