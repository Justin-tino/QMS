  function showSqdSummaryDetail(rating) {
    const r = String(rating);
    const emojiMap = { '5': '\u{1F929}', '4': '\u{1F642}', '3': '\u{1F610}', '2': '\u{1F61E}', '1': '\u{1F621}' };
    const colorMap = { '5':'#ef4444', '4':'#f59e0b', '3':'#2563eb', '2':'#22c55e', '1':'#f97316' };
    const labelMap = { '5':'5 — Strongly Agree', '4':'4 — Agree', '3':'3 — Neutral', '2':'2 — Disagree', '1':'1 — Strongly Disagree' };
    const sqdFields = ['sqd0','sqd1','sqd2','sqd3','sqd4','sqd5','sqd6','sqd7','sqd8'];
    const emoji = emojiMap[r] || '❓';
    // total valid ratings (all 5-1) and total instances for this rating
    let totalValid = 0, totalForRating = 0;
    feedbacksData.forEach(f => {
      sqdFields.forEach(fd => {
        const v = String(f[fd] == null ? '' : f[fd]).trim();
        if (['1','2','3','4','5'].includes(v)) totalValid++;
        if (v === r) totalForRating++;
      });
    });
    const pct = totalValid > 0 ? (totalForRating / totalValid * 100).toFixed(2) : '0.00';
    // distinct respondents who gave this rating on at least one SQD
    const matched = feedbacksData.filter(f => sqdFields.some(fd => String(f[fd] || '').trim() === r));
    const facts = [
      ['Rating', emoji + ' ' + (labelMap[r] || r)],
      ['Total rating instances (5-1)', String(totalForRating)],
      ['Distinct respondents', String(matched.length)],
      ['Share of all valid ratings', pct + '% of ' + totalValid]
    ].map(x => '<div style="display:flex; justify-content:space-between; gap:1rem; padding:0.4rem 0; border-bottom:1px solid #f1f5f9;"><span style="color:#64748b;">' + x[0] + '</span><span style="text-align:right; color:#0f172a; font-weight:600;">' + x[1] + '</span></div>').join('');
    let rowsHtml = '';
    if (!matched.length) {
      rowsHtml = '<p style="color:#94a3b8; font-style:italic; text-align:center; padding:0.8rem;">No respondents gave this rating.</p>';
    } else {
      rowsHtml = '<div style="overflow-x:auto; max-height:50vh; overflow-y:auto;"><table style="width:100%; border-collapse:collapse; font-size:0.78rem;"><thead><tr style="background:#f8fafc; text-align:left; position:sticky; top:0;"><th style="padding:0.4rem 0.5rem; color:#475569; font-size:0.68rem;">#</th><th style="padding:0.4rem 0.5rem; color:#475569; font-size:0.68rem;">Name</th><th style="padding:0.4rem 0.5rem; color:#475569; font-size:0.68rem;">Email</th><th style="padding:0.4rem 0.5rem; color:#475569; font-size:0.68rem;">Region</th><th style="padding:0.4rem 0.5rem; color:#475569; font-size:0.68rem;">Office</th><th style="padding:0.4rem 0.5rem; color:#475569; font-size:0.68rem;">Date</th><th style="padding:0.4rem 0.5rem; color:#475569; font-size:0.68rem;">Matched SQDs</th></tr></thead><tbody>' +
        matched.map((f,idx) => {
          const matchedSqds = sqdFields.filter(fd => String(f[fd]||'').trim()===r).map(fd=>fd.toUpperCase()).join(', ');
