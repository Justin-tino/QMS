 }

  // ========== SETTINGS: REPORT SIGNATORIES (persistent) ==========
  async function saveSignatories() {
    const btn = document.getElementById('btnSaveSignatories');
    const msg = document.getElementById('sigMsg');
    const badge = document.getElementById('sigSaveBadge');
    if (btn) { startButtonTimer(btn, 'Saving...'); }
    if (msg) msg.style.display = 'none';
    try {
      const payload = {
        preparedBy: document.getElementById('setPreparedBy')?.value?.trim() || '',
        preparedPos: document.getElementById('setPreparedPos')?.value?.trim() || '',
        preparedDate: document.getElementById('setPreparedDate')?.value?.trim() || '',
        reviewedBy: document.getElementById('setReviewedBy')?.value?.trim() || '',
        reviewedPos: document.getElementById('setReviewedPos')?.value?.trim() || '',
        reviewedDate: document.getElementById('setReviewedDate')?.value?.trim() || '',
        certifiedBy: document.getElementById('setCertifiedBy')?.value?.trim() || '',
        certifiedPos: document.getElementById('setCertifiedPos')?.value?.trim() || '',
        certifiedDate: document.getElementById('setCertifiedDate')?.value?.trim() || '',
        _csrf: '<%= csrfToken %>'
      };
      const r = await fetch('/admin/api/report-signatories', { method:'POST', headers:{'Content-Type':'application/json','X-Requested-With':'XMLHttpRequest'}, body: JSON.stringify(payload) });
      const j = await r.json();
      if (j.success) {
        if (msg) { msg.textContent = 'Signatories saved — future reports will use these names.'; msg.style.display='block'; msg.style.background='#f0fdf4'; msg.style.border='1px solid #bbf7d0'; msg.style.color='#15803d'; }
        if (badge) { badge.style.display='inline-block'; setTimeout(()=>badge.style.display='none', 2500); }
        // also update modal defaults to match
        const mP = document.getElementById('modalPreparedName'); if (mP) mP.value = payload.preparedBy;
        const mR = document.getElementById('modalReviewedName'); if (mR) mR.value = payload.reviewedBy;
        const mC = document.getElementById('modalCertifiedName'); if (mC) mC.value = payload.certifiedBy;
        try { localStorage.setItem('psau_report_prepared', payload.preparedBy); localStorage.setItem('psau_report_reviewed', payload.reviewedBy); localStorage.setItem('psau_report_certified', payload.certifiedBy); } catch(e){}
      } else {
        if (msg) { msg.textContent = j.error || 'Failed to save.'; msg.style.display='block'; msg.style.background='#fef2f2'; msg.style.border='1px solid #fecaca'; msg.style.color='#b91c1c'; }
      }
    } catch(e){
      if (msg) { msg.textContent = 'Network error.'; msg.style.display='block'; msg.style.background='#fef2f2'; msg.style.border='1px solid #fecaca'; msg.style.color='#b91c1c'; }
    } finally {
      if (btn) { stopButtonTimer(btn); }
    }
  }

