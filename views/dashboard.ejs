  %>
   <div id="section-settings" class="tab-section" style="display:none;">
     <div id="globalDateContext-settings" style="display:none; align-items:center; gap:0.5rem; padding:0.6rem 0.85rem; margin-bottom:0.85rem; background:#f8fafc; border:1px solid #e2e8f0; border-radius:8px; font-size:0.78rem; font-weight:600; color:#334155;">
       <i class="fas fa-calendar" style="color:#1b5e20;"></i> <span id="globalDateContext-settings-text">Overall (All Time) — no date filter</span> <a href="#" onclick="switchMainTab('dashboard');return false;" style="margin-left:auto; font-size:0.72rem; color:#1b5e20; font-weight:700; text-decoration:underline; white-space:nowrap;">Change on Dashboard</a>
     </div>
     <div class="settings-hub-container">
      
      <!-- Card 1: Profile & Password -->
      <div class="settings-card fade-up">
        <div class="settings-card-header" onclick="toggleSettingsDetail('settings-detail-profile')" aria-expanded="true" aria-controls="settings-detail-profile">
          <div class="settings-card-header-left">
            <div class="settings-card-icon" style="background:#eff6ff; color:#2563eb;">
              <i class="fas fa-user-shield"></i>
            </div>
            <div>
              <h4 class="settings-card-title">Profile & Security Credentials</h4>
              <p class="settings-card-sub">Administrator identity, role privileges, and password reset</p>
            </div>
          </div>
          <span class="settings-chevron"><i class="fas fa-chevron-right"></i></span>
        </div>
        <div id="settings-detail-profile" class="settings-detail open" style="display:block;">
          <div class="settings-profile-header">
            <div class="settings-profile-avatar" style="background:#1b5e20; color:#fff; font-weight:800; font-size:1.1rem; width:52px; height:52px;">
              <%= _displayName.charAt(0).toUpperCase() %>
            </div>
            <div style="flex:1;">
              <div class="settings-profile-name" style="font-size:1.05rem;"><%= _displayName %></div>
              <div class="settings-profile-sub"><%= _adminEmail %> &bull; <span style="text-transform:capitalize; color:#1b5e20; font-weight:700;"><%= _adminRole %></span></div>
            </div>
            <span class="sf-role" style="background:#f0fdf4; border-color:#bbf7d0; color:#15803d; font-size:0.75rem;"><i class="fas fa-check-circle" style="margin-right:0.3rem;"></i> Active Session</span>
          </div>

          <div class="settings-field-grid">
            <div class="settings-field">
              <label>Administrator Email</label>
              <div class="sf-value"><%= _adminEmail %></div>
            </div>
            <div class="settings-field">
              <label>Display Name</label>
              <div class="sf-value"><%= _displayName %></div>
            </div>
            <div class="settings-field" style="grid-column: span 2;">
              <label>Assigned System Role</label>
              <div style="margin-top:0.2rem; display:flex; align-items:center; gap:0.5rem;">
                <span class="sf-role"><%= _adminRole %></span>
                <span style="font-size:0.76rem; color:#64748b;">Full administrative privileges across analytics, feedback records, user management, and exports.</span>
              </div>
            </div>
          </div>

          <!-- Change Password Box -->
          <div class="glass" style="padding:1.25rem; border-radius:14px; margin-top:0.6rem;">
            <div style="display:flex; align-items:flex-start; gap:0.85rem; margin-bottom:0.9rem;">
              <div>
                <h4 style="margin:0; font-size:0.96rem; font-weight:800; color:#0f172a;">Change Password</h4>
                <p style="margin:0.2rem 0 0 0; font-size:0.76rem; font-weight:700; color:#d97706;">Verified via email link</p>
                <p style="margin:0.35rem 0 0 0; font-size:0.78rem; color:#64748b; line-height:1.5;">Enter your current password to confirm your identity. A secure password reset link will be sent to your email.</p>
              </div>
            </div>
            <label for="currentPassword" style="font-size:0.7rem; font-weight:700; color:#334155; text-transform:uppercase; letter-spacing:0.4px; display:block; margin-bottom:0.4rem;" data-i18n="set.pw.current">Current password</label>
            <div style="position:relative; margin-bottom:0.75rem;">
              <i class="fas fa-lock" style="position:absolute; left:14px; top:50%; transform:translateY(-50%); color:#94a3b8; font-size:0.85rem;"></i>
              <input type="password" id="currentPassword" autocomplete="current-password" placeholder="Enter your current password" onkeydown="if(event.key==='Enter')sendPasswordReset()" style="width:100%; padding:0.7rem 2.8rem 0.7rem 2.4rem; border:1px solid #cbd5e1; border-radius:10px; font-size:0.86rem; color:#0f172a; background:#fff;">
              <button type="button" onclick="toggleSettingPw()" aria-label="Show password" style="position:absolute; right:10px; top:50%; transform:translateY(-50%); background:none; border:none; cursor:pointer; color:#94a3b8; padding:4px;"><i class="fas fa-eye" id="setPwEye"></i></button>
            </div>
            <div id="pwMsg" style="margin-bottom:0.75rem; font-size:0.8rem; display:none; padding:0.6rem 0.8rem; border-radius:8px; line-height:1.45;" role="alert" aria-live="polite"></div>
            <button id="btnSendPwReset" onclick="sendPasswordReset()" style="background:#fffbeb; color:#b45309; border:1px solid #fcd34d; padding:0.7rem 1.3rem; border-radius:10px; font-weight:700; font-size:0.83rem; cursor:pointer; transition:all 0.15s ease;"><i class="fas fa-paper-plane"></i>&nbsp; <span data-i18n="set.pw.send">Send Reset Password Link</span></button>
          </div>
        </div>
      </div>

      <!-- Card 2: Appearance & Language -->
      <div class="settings-card fade-up">
        <div class="settings-card-header" onclick="toggleSettingsDetail('settings-detail-appearance')" aria-expanded="false" aria-controls="settings-detail-appearance">
          <div class="settings-card-header-left">
            <div class="settings-card-icon" style="background:#faf5ff; color:#a855f7;">
              <i class="fas fa-palette"></i>
            </div>
            <div>
              <h4 class="settings-card-title">Appearance & Display Standards</h4>
              <p class="settings-card-sub">Color theme options and administrative interface language</p>
            </div>
          </div>
          <span class="settings-chevron"><i class="fas fa-chevron-right"></i></span>
        </div>
        <div id="settings-detail-appearance" class="settings-detail" style="display:none;">
          <!-- Theme Switcher Sub-card -->
          <div class="glass" style="padding:1.25rem; border-radius:14px; margin-bottom:1rem;">
            <div style="display:flex; align-items:center; gap:0.75rem; margin-bottom:0.9rem;">
              <div>
                <h4 style="margin:0; font-size:0.96rem; font-weight:800; color:#0f172a;" data-i18n="set.theme.title">Interface Theme</h4>
                <p style="margin:0.15rem 0 0 0; font-size:0.76rem; color:#64748b;">Select preferred light or dark mode theme for this session</p>
              </div>
            </div>
            <div class="settings-theme-grid">
              <button type="button" class="btn-mode-tab theme-mode-card" data-set-theme="light" onclick="PSAU_UI.setTheme('light')" style="padding:0.85rem 1.1rem; justify-content:center; width:100%;">
                <i class="fas fa-sun" style="font-size:1.1rem; color:#eab308;"></i>
                <span style="font-weight:700; font-size:0.88rem;" data-i18n="theme.light">Light Mode</span>
              </button>
              <button type="button" class="btn-mode-tab theme-mode-card" data-set-theme="dark" onclick="PSAU_UI.setTheme('dark')" style="padding:0.85rem 1.1rem; justify-content:center; width:100%;">
                <i class="fas fa-moon" style="font-size:1.1rem; color:#a855f7;"></i>
                <span style="font-weight:700; font-size:0.88rem;" data-i18n="theme.dark">Dark Mode</span>
              </button>
            </div>
          </div>

          <!-- Language Sub-card (English Standard) -->
          <div class="glass" style="padding:1.25rem; border-radius:14px;">
            <div style="display:flex; align-items:center; gap:0.75rem; margin-bottom:0.75rem;">
              <div>
                <h4 style="margin:0; font-size:0.96rem; font-weight:800; color:#0f172a;" data-i18n="set.lang.title">Dashboard Language</h4>
                <p style="margin:0.15rem 0 0 0; font-size:0.76rem; color:#64748b;">System language standard</p>
              </div>
            </div>
            <div style="background:#f0fdf4; border:1px solid #bbf7d0; border-radius:12px; padding:0.9rem 1.1rem; display:flex; align-items:center; gap:0.85rem;">
              <i class="fas fa-circle-check" style="font-size:1.25rem; color:#16a34a;"></i>
              <div>
                <div style="font-size:0.88rem; font-weight:800; color:#14532d;">English Standard (Active)</div>
                <div style="font-size:0.76rem; color:#166534; margin-top:0.15rem; line-height:1.4;">
                  The administrative dashboard is standardized in English for institutional report accuracy, audit compliance, and machine learning analytics.
                </div>
              </div>
            </div>
            <!-- Hidden button for data-set-lang="en" so PSAU_UI can safely query it if needed -->
            <button type="button" data-set-lang="en" onclick="PSAU_UI.setLanguage('en')" style="display:none;"></button>
          </div>
        </div>
      </div>

      <!-- Card 3: Database Backup & Security -->
      <div class="settings-card fade-up">
        <div class="settings-card-header" onclick="toggleSettingsDetail('settings-detail-security')" aria-expanded="false" aria-controls="settings-detail-security">
          <div class="settings-card-header-left">
            <div class="settings-card-icon" style="background:#eff6ff; color:#2563eb;">
              <i class="fas fa-database"></i>
            </div>
            <div>
              <h4 class="settings-card-title">Database Backup & Recovery Vault</h4>
              <p class="settings-card-sub">Generate and download encrypted snapshot of system records</p>
            </div>
          </div>
          <span class="settings-chevron"><i class="fas fa-chevron-right"></i></span>
        </div>
        <div id="settings-detail-security" class="settings-detail" style="display:none;">
          <div class="glass" style="padding:1.25rem; border-radius:14px;">
            <div style="display:flex; align-items:flex-start; gap:0.85rem; margin-bottom:0.85rem;">
              <div>
                <h4 style="margin:0; font-size:0.96rem; font-weight:800; color:#0f172a;" data-i18n="set.backup.title">Data Backup Vault</h4>
              </div>
            </div>
            <p style="margin:0 0 0.95rem 0; font-size:0.8rem; color:#64748b; line-height:1.55;">
              Download a complete snapshot of all Firestore database collections (feedback entries, office metrics, ML model states, and audit trails). To protect university data, a one-time verification PIN is sent to your registered admin email.
            </p>
            
            <div id="backupStep1" style="display:block;">
              <div style="display:flex; gap:0.65rem; flex-wrap:wrap; align-items:stretch;">
                <div style="flex:1; min-width:240px; position:relative;">
                  <i class="fas fa-envelope" style="position:absolute; left:14px; top:50%; transform:translateY(-50%); color:#94a3b8; font-size:0.85rem;"></i>
                  <input type="text" readonly value="<%= _adminEmail %>" aria-label="Admin email" style="width:100%; padding:0.7rem 0.9rem 0.7rem 2.4rem; border:1px solid #cbd5e1; border-radius:10px; font-size:0.85rem; color:#0f172a; background:#fff; font-weight:600;">
                </div>
                <button id="btnSendOtp" onclick="sendBackupOtp()" style="background:#1b5e20; color:#fff; border:none; padding:0.7rem 1.25rem; border-radius:10px; font-weight:700; font-size:0.83rem; cursor:pointer; white-space:nowrap; transition:all 0.15s ease;"><i class="fas fa-paper-plane"></i>&nbsp; <span data-i18n="set.backup.send">Send Code to Email</span></button>
              </div>
              <div style="display:flex; align-items:center; gap:0.6rem; margin-top:1rem; padding-top:0.85rem; border-top:1px dashed #cbd5e1;">
                <span id="backupStep1Dot" style="width:24px; height:24px; border-radius:50%; background:#1b5e20; color:#fff; display:inline-flex; align-items:center; justify-content:center; font-size:0.72rem; font-weight:800;">1</span>
                <span style="font-size:0.8rem; font-weight:700; color:#0f172a;" data-i18n="set.backup.send">Send Code to Email</span>
                <span style="flex:1; height:1px; background:#cbd5e1; min-width:20px;"></span>
                <span id="backupStepDot" style="width:24px; height:24px; border-radius:50%; background:#e2e8f0; color:#64748b; display:inline-flex; align-items:center; justify-content:center; font-size:0.72rem; font-weight:800;">2</span>
                <span style="font-size:0.8rem; font-weight:700; color:#94a3b8;">Enter Verification PIN</span>
              </div>
              <p id="backupEmailLine" style="margin:0.4rem 0 0 0; font-size:0.74rem; font-weight:600; color:#64748b; display:none;"><%= _adminEmail %></p>
            </div>

            <div id="backupStep2" style="display:none; margin-top:0.95rem;">
              <label for="backupPin" style="font-size:0.7rem; font-weight:700; color:#334155; text-transform:uppercase; letter-spacing:0.4px; display:block;" data-i18n="set.backup.pin">6-digit code from your email</label>
              <input type="text" id="backupPin" inputmode="numeric" maxlength="6" autocomplete="one-time-code" placeholder="000000" onkeydown="if(event.key==='Enter')verifyBackupPin()" style="width:100%; max-width:280px; padding:0.68rem; border:1px solid #cbd5e1; border-radius:10px; font-size:1.1rem; letter-spacing:10px; text-align:center; font-weight:800; margin:0.4rem 0 0.7rem 0; background:#fff;">
              <div style="display:flex; gap:0.6rem; flex-wrap:wrap; align-items:center;">
                <button id="btnVerifyOtp" onclick="verifyBackupPin()" style="background:#0f172a; color:#fff; border:none; padding:0.68rem 1.25rem; border-radius:10px; font-weight:700; font-size:0.83rem; cursor:pointer;" data-i18n="set.backup.verify">Verify & Download (ZIP)</button>
                <button type="button" onclick="resetBackupFlow()" style="background:none; border:none; color:#64748b; padding:0.5rem 0.75rem; font-size:0.76rem; cursor:pointer; text-decoration:underline;">Request a new code</button>
              </div>
            </div>

            <div id="backupMsg" style="margin-top:0.75rem; font-size:0.8rem; display:none; padding:0.6rem 0.8rem; border-radius:8px; line-height:1.45;" role="alert" aria-live="polite"></div>
            <p style="margin:0.75rem 0 0 0; font-size:0.72rem; color:#94a3b8;"><i class="fas fa-lock" style="margin-right:0.3rem;"></i> <span data-i18n="set.backup.note">The download link is single-use and expires in 10 minutes.</span></p>
          </div>
        </div>
      </div>

    </div>

    <script>
    // Secure accordion toggle — allowlist validated, uses textContent, no innerHTML with user input
    function toggleSettingsDetail(id) {
      var allowed = ['settings-detail-profile','settings-detail-appearance','settings-detail-security'];
      if (allowed.indexOf(id) === -1) return;
      var el = document.getElementById(id);
      if (!el) return;
      var isHidden = el.style.display === 'none' || el.style.display === '' || window.getComputedStyle(el).display === 'none';
      allowed.forEach(function(otherId) {
        if (otherId !== id) {
          var otherEl = document.getElementById(otherId);
          if (otherEl) { 
            otherEl.style.display = 'none'; 
            otherEl.classList.remove('open'); 
            var b = document.querySelector('[aria-controls="' + otherId + '"]'); 
            if (b) b.setAttribute('aria-expanded','false'); 
          }
        }
      });
      if (isHidden) {
        el.style.display = 'block';
        el.classList.add('open');
        var btn = document.querySelector('[aria-controls="' + id + '"]');
        if (btn) btn.setAttribute('aria-expanded','true');
      } else {
        el.style.display = 'none';
        el.classList.remove('open');
        var btn2 = document.querySelector('[aria-controls="' + id + '"]');
        if (btn2) btn2.setAttribute('aria-expanded','false');
      }
    }
    function confirmLogout(e){
      if(e) e.preventDefault();
      var go=function(){ window.location.href='/admin/logout'; };
      if(typeof psauConfirm==='function'){
        psauConfirm({title:'Proceed to logout?', message:'You will be signed out of your account and will need to sign in again.', confirmText:'Yes', cancelText:'No', variant:'warning', iconClass:'fa-right-from-bracket'}).then(function(ok){ if(ok) go(); });
      } else {
        if(confirm('Proceed to logout?')) go();
      }
      return false;
    }
    </script>
  </div>
  <% } %>

  </div><!-- end dash-content -->
 </main>
</div><!-- end admin-shell -->

<!-- Edit User Modal — Single entry point (Edit + Password + Suspend/Delete) -->
<div id="editUserModal" class="modal" style="display:none;">
  <div class="modal-content" style="max-width:520px; border-radius:18px; padding:0; overflow:hidden; border:1px solid #e2e8f0; box-shadow:0 20px 40px -12px rgba(15,23,42,0.25);">
    <div class="um-modal-header">
      <div class="um-modal-avatar" id="editModalAvatar">S</div>
      <div style="flex:1;">
        <h3 class="um-modal-title">Manage Employee Credentials</h3>
        <div class="um-modal-sub" id="editUserEmail">staff@psau.edu.ph</div>
      </div>
      <span class="close-modal" onclick="closeEditUser()" style="color:#94a3b8; font-size:1.4rem; cursor:pointer; transition:color 0.15s ease;">&times;</span>
    </div>

    <div class="um-modal-body">
      
      <!-- Section 1: Display Name -->
      <div class="um-modal-section">
        <div class="um-modal-section-title">
          <i class="fas fa-id-card" style="color:#1b5e20;"></i> Display Identity
        </div>
        <div style="display:flex; gap:0.55rem; align-items:center;">
          <div class="um-input-wrap" style="flex:1;">
            <i class="fas fa-user um-input-icon"></i>
            <input type="text" id="editDisplayName" placeholder="Display Name" class="um-input">
          </div>
          <button id="btnSaveEdit" onclick="submitEditUser()" class="um-btn-primary" style="padding:0.58rem 1rem;">
            Save
          </button>
        </div>
      </div>

      <!-- Section 2: Change Password -->
      <div class="um-modal-section">
        <div class="um-modal-section-title">
          <i class="fas fa-key" style="color:#d97706;"></i> Update Account Password
        </div>
        <div style="display:flex; flex-direction:column; gap:0.55rem;">
          <div style="display:flex; gap:0.55rem; flex-wrap:wrap;">
            <div class="um-input-wrap" style="flex:1; min-width:180px;">
              <i class="fas fa-lock um-input-icon"></i>
              <input type="password" id="editNewPassword" placeholder="New password (≥8)" autocomplete="new-password" class="um-input">
            </div>
            <div class="um-input-wrap" style="flex:1; min-width:180px;">
              <i class="fas fa-lock um-input-icon"></i>
              <input type="password" id="editConfirmPassword" placeholder="Confirm password" autocomplete="new-password" class="um-input">
            </div>
          </div>
          <div style="display:flex; justify-content:space-between; align-items:center;">
            <span style="font-size:0.72rem; color:#64748b;">Must contain letters & numbers</span>
            <button id="btnEditPw" onclick="submitEditPassword()" class="psau-btn-primary" style="padding:0.48rem 0.9rem; font-size:0.78rem;">
              <i class="fas fa-rotate"></i> Update Password
            </button>
          </div>
          <div id="editPwMsg" style="font-size:0.76rem; display:none; padding:0.4rem 0.6rem; border-radius:7px;"></div>
        </div>
      </div>

      <!-- General Notification Area -->
      <div id="editUserMsg" style="font-size:0.78rem; display:none; padding:0.55rem 0.8rem; border-radius:8px; font-weight:600;" role="alert"></div>

      <!-- Section 3: Account Governance / Danger Zone -->
      <div class="um-modal-section" style="border-color:#fecaca; background:#fff5f5;">
        <div class="um-modal-section-title" style="color:#b91c1c;">
          <i class="fas fa-shield-cat"></i> Security Governance & Account Control
        </div>
        <div style="display:flex; gap:0.55rem; margin-bottom:0.55rem; flex-wrap:wrap;">
          <button id="btnSuspend" onclick="toggleSuspendUser()" style="flex:1; border:1px solid #fcd34d; background:#fffbeb; color:#92400e; padding:0.55rem; border-radius:8px; font-weight:700; cursor:pointer; font-size:0.78rem; display:inline-flex; align-items:center; justify-content:center; gap:0.4rem;">
            <i class="fas fa-ban"></i> Suspend Account
          </button>
          <button onclick="deleteFromEdit()" style="flex:1; border:1px solid #fecaca; background:#fef2f2; color:#b91c1c; padding:0.55rem; border-radius:8px; font-weight:700; cursor:pointer; font-size:0.78rem; display:inline-flex; align-items:center; justify-content:center; gap:0.4rem;">
            <i class="fas fa-user-xmark"></i> Delete Account
          </button>
        </div>
        <button id="btnResendVerify" onclick="resendVerification()" style="width:100%; border:1px solid #bfdbfe; background:#eff6ff; color:#1d4ed8; padding:0.55rem; border-radius:8px; font-weight:700; cursor:pointer; font-size:0.78rem; display:inline-flex; align-items:center; justify-content:center; gap:0.4rem;">
          <i class="fas fa-paper-plane"></i> Resend Email Verification Link
        </button>
        <p style="font-size:0.71rem; color:#64748b; margin:0.45rem 0 0 0; line-height:1.45;">
          Suspended accounts cannot sign in. Staff must verify their email before initial login.
        </p>
      </div>

    </div>

    <div class="um-modal-footer">
      <button type="button" onclick="closeEditUser()" class="psau-btn-secondary" style="padding:0.45rem 1rem;">
        Close
      </button>
    </div>
  </div>
</div>

<!-- Add Employee Modal -->
<div id="addEmployeeModal" class="modal" style="display:none;" role="dialog" aria-modal="true" aria-labelledby="addEmpModalTitle">
  <div class="modal-content">
    <!-- Modal Header -->
    <div class="um-modal-header">
      <div class="um-modal-avatar">
        <i class="fas fa-user-plus" style="font-size:1.1rem;"></i>
      </div>
      <div style="flex:1;">
        <h3 class="um-modal-title" id="addEmpModalTitle">Provision Staff Account</h3>
        <div class="um-modal-sub">Create staff-level credentials for department heads</div>
      </div>
      <span class="close-modal" onclick="closeAddEmployeeModal()" role="button" aria-label="Close" tabindex="0">&times;</span>
    </div>

    <!-- Modal Body -->
    <div class="um-add-modal-body">

      <div id="addEmpMsg" role="alert" style="display:none; font-size:0.82rem; padding:0.6rem 0.85rem; border-radius:9px; font-weight:600;"></div>

      <form id="addUserForm" onsubmit="createEmployee(event)">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <!-- Email -->
        <div class="um-add-modal-field" style="margin-bottom:0.85rem;">
          <label for="newUserEmail" style="font-size:0.7rem; font-weight:700; color:#475569; text-transform:uppercase; letter-spacing:0.4px; display:block; margin-bottom:0.35rem;">Email Address</label>
          <div class="um-input-wrap">
            <i class="fas fa-envelope um-input-icon"></i>
            <input type="email" name="email" id="newUserEmail" required placeholder="employee@psau.edu.ph"
              class="um-input" style="padding-left:2.25rem;" autocomplete="email" spellcheck="false">
          </div>
          <div id="emailTypoHint" style="display:none; margin-top:0.35rem; font-size:0.76rem; font-weight:600; color:#b91c1c; background:#fef2f2; border:1px solid #fecaca; padding:0.4rem 0.6rem; border-radius:7px; line-height:1.4;"></div>
        </div>

