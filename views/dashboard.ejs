/* ===== PSAU UNIFIED DIALOG — replaces native alert/confirm (localhost says) ===== */
.psau-dialog-overlay { position:fixed; inset:0; background:rgba(15,23,42,0.55); backdrop-filter:blur(6px); -webkit-backdrop-filter:blur(6px); display:none; align-items:center; justify-content:center; z-index:3000; padding:1rem; animation:psauFadeIn 0.2s ease; }
.psau-dialog-overlay.open { display:flex; }
@keyframes psauFadeIn { from { opacity:0; } to { opacity:1; } }
.psau-dialog-card { background:#ffffff; border:1px solid #e2e8f0; border-radius:16px; padding:1.6rem 1.5rem 1.35rem 1.5rem; width:100%; max-width:420px; box-shadow:0 20px 40px -12px rgba(15,23,42,0.28), 0 8px 16px -8px rgba(15,23,42,0.15); animation:psauSlideUp 0.24s cubic-bezier(0.16,1,0.3,1); text-align:center; }
@keyframes psauSlideUp { from { transform:translateY(14px) scale(0.98); opacity:0; } to { transform:translateY(0) scale(1); opacity:1; } }
.psau-dialog-icon { width:56px; height:56px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:1.45rem; margin:0 auto 0.9rem auto; border:1px solid transparent; }
.psau-dialog-icon.variant-danger { background:#fef2f2; color:#dc2626; border-color:#fecaca; }
.psau-dialog-icon.variant-success { background:#f0fdf4; color:#16a34a; border-color:#bbf7d0; }
.psau-dialog-icon.variant-error { background:#fef2f2; color:#dc2626; border-color:#fecaca; }
.psau-dialog-icon.variant-warning { background:#fffbeb; color:#d97706; border-color:#fde68a; }
.psau-dialog-icon.variant-info { background:#eff6ff; color:#2563eb; border-color:#bfdbfe; }
.psau-dialog-title { font-family:'Plus Jakarta Sans',sans-serif; font-size:1.06rem; font-weight:800; color:#0f172a; margin:0 0 0.4rem 0; letter-spacing:-0.02em; line-height:1.25; }
.psau-dialog-message { font-size:0.84rem; color:#475569; line-height:1.55; margin:0 0 1.35rem 0; word-break:break-word; }
.psau-dialog-actions { display:flex; gap:0.6rem; justify-content:center; flex-wrap:wrap; }
.psau-btn-primary, .psau-btn-danger, .psau-btn-success, .psau-btn-secondary { display:inline-flex; align-items:center; justify-content:center; gap:0.4rem; padding:0.6rem 1.15rem; border-radius:9px; font-size:0.82rem; font-weight:700; cursor:pointer; border:1px solid transparent; transition:all 0.15s ease; min-width:96px; font-family:inherit; }
.psau-btn-primary { background:#0f172a; color:#fff; border-color:#0f172a; } .psau-btn-primary:hover { background:#1e293b; border-color:#1e293b; transform:translateY(-1px); }
.psau-btn-danger { background:#dc2626; color:#fff; border-color:#dc2626; } .psau-btn-danger:hover { background:#b91c1c; border-color:#b91c1c; transform:translateY(-1px); }
.psau-btn-success { background:#16a34a; color:#fff; border-color:#16a34a; } .psau-btn-success:hover { background:#15803d; border-color:#15803d; transform:translateY(-1px); }
.psau-btn-secondary { background:#f1f5f9; color:#475569; border-color:#e2e8f0; } .psau-btn-secondary:hover { background:#e2e8f0; color:#334155; }
.psau-btn-primary:focus-visible, .psau-btn-danger:focus-visible, .psau-btn-success:focus-visible, .psau-btn-secondary:focus-visible { outline:2px solid #2563eb; outline-offset:2px; }
/* Delete confirm modal polish to match unified design */
