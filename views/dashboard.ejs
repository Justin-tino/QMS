 }).join('');
 openChartDetail(def.code + ' — Rating Breakdown',
 `<div style="margin-bottom:1rem;">${rows}</div><h4 style="margin:0 0 0.5rem 0; font-size:0.8rem; text-transform:uppercase; color:#1b5e20;">Rating Distribution (1 = Strongly Disagree, 5 = Strongly Agree)</h4>${distRows}`
 );
 }

