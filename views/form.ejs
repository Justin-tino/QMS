                    <div class="form-group">
                        <label for="uri_transaksyon">Uri ng transaksyon o serbisyo</label>
                        <input type="text" id="uri_transaksyon" name="uri_transaksyon"
                            placeholder="I-type ang transaksyon o serbisyo" maxlength="200" required>
                    </div>

                    <!-- Citizen's Charter Section -->
                    <div class="section-title"><i class="fas fa-landmark"></i> Citizen's Charter (CC)</div>

                    <div class="sqd-instruction">
                        PANUTO: Lagyan ng tsek (✔) ang iyong sagot sa mga sumusunod na katanungan tungkol sa Citizen's
                        Charter (CC).
                        Ito ay isang opisyal na dokumento na naglalaman ng mga serbisyo sa isang ahensya/opisina ng
                        gobyerno,
                        makikita rito ang mga kailangan na dokumento, kaukulang bayarin at pagkabuuang oras ng proseso.
                    </div>

                    <!-- CC1 -->
                    <div class="sqd-item">
                        <div class="sqd-label"><strong>CC1</strong> — Alin sa mga sumusunod ang naglalarawan sa iyong
                            kaalaman sa CC?</div>
                        <div class="sqd-options" style="flex-direction: column;">
                            <label class="check-option">
                                <input type="radio" name="cc1" value="1" required>
                                <span class="check-label">Alam ko ang CC at nakita ko ito sa napuntahang opisina</span>
                            </label>
                            <label class="check-option">
                                <input type="radio" name="cc1" value="2">
                                <span class="check-label">Alam ko ang CC pero hindi ko ito nakita sa napuntahang
                                    opisina</span>
                            </label>
                            <label class="check-option">
                                <input type="radio" name="cc1" value="3">
                                <span class="check-label">Nalaman ko ang CC nang makita ko ito sa napuntahang
                                    opisina</span>
                            </label>
                            <label class="check-option">
                                <input type="radio" name="cc1" value="4">
                                <span class="check-label">Hindi ko alam kung ano ang CC at wala akong nakita sa
                                    napuntahang opisina</span>
                            </label>
                        </div>
                    </div>

                    <!-- CC2 -->
                    <div class="sqd-item" id="cc2Container">
                        <div class="sqd-label"><strong>CC2</strong> — Kung alam ang CC (nag-tsek sa opsyon 1-3 sa CC1),
                            masasabi mo ba na ang CC nang napuntahang opisina ay...?</div>
                        <div class="sqd-options" style="flex-direction: column;">
                            <label class="check-option"><input type="radio" name="cc2" value="1"><span
                                    class="check-label">Madaling makita</span></label>
                            <label class="check-option"><input type="radio" name="cc2" value="2"><span
                                    class="check-label">Medyo madaling makita</span></label>
                            <label class="check-option"><input type="radio" name="cc2" value="3"><span
                                    class="check-label">Mahirap makita</span></label>
                            <label class="check-option"><input type="radio" name="cc2" value="4"><span
                                    class="check-label">Hindi makita</span></label>
                            <label class="check-option"><input type="radio" name="cc2" value="N/A"><span
                                    class="check-label">N/A</span></label>
                        </div>
                    </div>

                    <!-- CC3 -->
                    <div class="sqd-item" id="cc3Container">
                        <div class="sqd-label"><strong>CC3</strong> — Kung alam ang CC (nag-tsek sa opsyon 1-3 sa CC1),
                            gaano nakatulong ang CC sa transaksyon mo?</div>
                        <div class="sqd-options" style="flex-direction: column;">
                            <label class="check-option"><input type="radio" name="cc3" value="1"><span
                                    class="check-label">Sobrang nakatulong</span></label>
                            <label class="check-option"><input type="radio" name="cc3" value="2"><span
                                    class="check-label">Nakatulong naman</span></label>
                            <label class="check-option"><input type="radio" name="cc3" value="3"><span
                                    class="check-label">Hindi nakatulong</span></label>
                            <label class="check-option"><input type="radio" name="cc3" value="N/A"><span
                                    class="check-label">N/A</span></label>
                        </div>
                    </div>

                    <!-- SQD Section -->
                    <div class="section-title"><i class="fas fa-chart-bar"></i> Service Quality Dimensions (SQD 0-8)
                    </div>

                    <div class="sqd-instruction">
                        PANUTO: Para sa SQD 0-8, lagyan ng tsek (✔) ang hanay na pinakaangkop sa iyong sagot.
                    </div>

                    <% const sqdItems=[ { id: 'sqd0' ,
                        label: 'SQD0. Nasiyahan ako sa serbisyo na aking natanggap sa napuntahan na tanggapan.' }, {
                        id: 'sqd1' ,
                        label: 'SQD1. Makatawiran ang oras na aking ginugol para sa pagproseso ng aking transaksyon.' },
                        { id: 'sqd2' ,
                        label: 'SQD2. Ang opisina ay sumusunod sa mga kinakailangang dokumento at mga hakbang batay sa impormasyong ibinigay.'
                        }, { id: 'sqd3' ,
                        label: 'SQD3. Ang mga hakbang sa pagproseso, kasama na ang pagbayad ay madali at simple lamang.'
                        }, { id: 'sqd4' ,
                        label: 'SQD4. Mabilis at madali akong nakahanap ng impormasyon tungkol sa aking transaksyon mula sa opisina o sa website nito.'
                        }, { id: 'sqd5' ,
                        label: 'SQD5. Nagbayad ako ng makatwirang halaga para sa aking transaksyon. (Kung ang serbisyo ay ibinigay ng libre, maglagay ng tsek sa hanay ng N/A).'
                        }, { id: 'sqd6' ,
                        label: 'SQD6. Pakiramdam ko ay patas ang opisina sa lahat, o "walang palakasan".' }, {
                        id: 'sqd7' ,
                        label: 'SQD7. Magalang akong tinrato ng mga tauhan, at (kung sakali ako ay humingi ng tulong) alam ko na sila ay handang tumulong sa akin.'
                        }, { id: 'sqd8' ,
                        label: 'SQD8. Nakuha ko ang kinakailangan ko mula sa tanggapan ng gobyerno, kung tinanggihan man, ito ay sapat na ipinaliwanag sa akin.'
                        } ]; const ratingLabels=[ { value: '1' , emoji: '😡' , text: 'Lubos na hindi sumasang-ayon' }, {
                        value: '2' , emoji: '🙁' , text: 'Hindi sumasang-ayon' }, { value: '3' , emoji: '😐' ,
                        text: 'Walang kinikilingan' }, { value: '4' , emoji: '🙂' , text: 'Sumasang-ayon' }, {
                        value: '5' , emoji: '😍' , text: 'Lubos na sumasang-ayon' }, { value: 'N/A' , emoji: '🚫' ,
                        text: 'N/A' } ]; %>

                        <% sqdItems.forEach(function(item, idx) { %>
                            <div class="sqd-item" data-sqd="<%= item.id %>">
                                <div class="sqd-label"><strong>
                                        <%= item.label.split('.')[0] %>
                                    </strong>.<%= item.label.split('.').slice(1).join('.') %>
                                </div>
                                <div class="emoji-grid">
                                    <% ratingLabels.forEach(function(rating, rIdx) { %>
                                        <label class="emoji-card">
                                            <input type="radio" name="<%= item.id %>" value="<%= rating.value %>"
                                                <%=rIdx===0 ? 'required' : '' %>>
                                            <div class="emoji-card-content">
                                                <span class="emoji-face">
                                                    <%= rating.emoji %>
                                                </span>
                                                <span class="emoji-label">
                                                    <%= rating.text %>
                                                </span>
                                            </div>
                                        </label>
                                        <% }); %>
                                </div>
                            </div>
                            <% }); %>

                                <!-- Suggestions & Email -->
                                <div class="section-title"><i class="fas fa-comment-dots"></i> Karagdagang Feedback
                                </div>

                                <div class="form-group full-width">
                                    <label for="suggestions">Mga suhestiyon kung paano pa mapapabuti ang aming mga
                                        serbisyo (opsyonal)</label>
                                    <textarea id="suggestions" name="suggestions"
                                        placeholder="Isulat dito ang iyong suhestiyon..." rows="4"></textarea>
                                </div>

                                <div class="form-group full-width">
                                    <label for="email">Email address (opsyonal)</label>
                                    <input type="email" id="email" name="email" placeholder="iyong.email@example.com">
                                </div>

                                <!-- Submit -->
                                <div class="submit-section">
                                    <button type="submit" class="btn-submit" id="submitBtn">
                                        <i class="fas fa-paper-plane"></i> Isumite ang Feedback
                                    </button>
                                </div>
                </div>
            </form>
        </div>
    </div>

    <script>
        // Auto-fill today's date
        document.getElementById('petsa').value = new Date().toISOString().split('T')[0];

        // Enter key advances focus to the next field; submit button submits as usual
        (function () {
            var form = document.getElementById('feedbackForm');
            if (!form) return;
            form.addEventListener('keydown', function (e) {
                if (e.key !== 'Enter') return;
                var t = e.target;
                if (!t || t.tagName === 'TEXTAREA') return;
                if (t.tagName === 'BUTTON') return;
                e.preventDefault();
                var nodes = form.querySelectorAll('input:not([type=hidden]):not([disabled]), select:not([disabled]), textarea:not([disabled]), button[type=submit]');
                var list = Array.prototype.slice.call(nodes).filter(function (el) { return el.offsetParent !== null; });
                var idx = list.indexOf(t);
                if (t.type === 'radio') {
                    for (var i = idx + 1; i < list.length; i++) {
                        if (list[i].type === 'radio' && list[i].name === t.name) continue;
                        idx = i - 1; break;
                    }
                }
                for (var j = idx + 1; j < list.length; j++) {
                    var el = list[j];
                    if (el.type === 'radio' && t.type === 'radio' && el.name === t.name) continue;
                    el.focus();
                    if (el.tagName === 'SELECT') el.dispatchEvent(new Event('change'));
                    return;
                }
                var submit = form.querySelector('button[type=submit]');
                if (submit) submit.focus();
            });
        })();

        // CC1 logic: auto-select N/A for CC2 and CC3 when option 4 is selected
        document.querySelectorAll('input[name="cc1"]').forEach(r => {
            r.addEventListener('change', function () {
                if (this.value === '4') {
                    document.querySelector('input[name="cc2"][value="N/A"]').checked = true;
                    document.querySelector('input[name="cc3"][value="N/A"]').checked = true;
                }
            });
        });

        // Update office code in header
        document.getElementById('tanggapan').addEventListener('change', function () {
            const selectedOption = this.options[this.selectedIndex];
            const code = selectedOption.getAttribute('data-code');
            if (code) {
                document.getElementById('headerOfficeCode').textContent = code;
            }
        });

        // Auto-select office from URL query parameter (e.g. ?office=OQA)
        const urlParams = new URLSearchParams(window.location.search);
        const officeParam = urlParams.get('office');
        if (officeParam) {
            const selectEl = document.getElementById('tanggapan');
            const paramLower = officeParam.toLowerCase().trim();
            for (let i = 0; i < selectEl.options.length; i++) {
                const opt = selectEl.options[i];
                const optVal = opt.value.toLowerCase().trim();
                const optCode = (opt.getAttribute('data-code') || '').toLowerCase().trim();
                if (optCode === paramLower || optVal === paramLower) {
                    selectEl.selectedIndex = i;
                    // Trigger change event to update the header code
                    selectEl.dispatchEvent(new Event('change'));
                    break;
                }
            }
        }

        // Form submission — unified fetch + offline fallback + precise missing-field surfacing
        document.getElementById('feedbackForm').addEventListener('submit', async function (e) {
            e.preventDefault();
            const btn = document.getElementById('submitBtn');
            const form = this;

            // Clear previous message
            let msg = document.getElementById('formValidationMsg');
            if (!msg) {
                msg = document.createElement('div');
                msg.id = 'formValidationMsg';
                msg.style.cssText = 'margin:0.75rem auto 0 auto; max-width:720px; background:#fef2f2; border:1px solid #fecaca; color:#b91c1c; padding:0.7rem 0.9rem; border-radius:8px; font-size:0.85rem; font-weight:600; text-align:center; display:none;';
                btn.parentElement.insertBefore(msg, btn);
            }
            msg.style.display = 'none';
            // Remove prior outlines
            form.querySelectorAll('.sqd-item, .form-group').forEach(el => { el.style.outline = ''; });

            // Build explicit missing list (covers hidden radios which :invalid alone can miss)
            const missing = [];
            const addMissing = (label, ok) => { if (!ok) missing.push(label); };
            addMissing('Pangalan', document.getElementById('pangalan').value.trim());
            addMissing('Uri ng Kliyente', form.querySelector('input[name="uri_kliyente"]:checked'));
            addMissing('Petsa', document.getElementById('petsa').value);
            addMissing('Kasarian', form.querySelector('input[name="kasarian"]:checked'));
            addMissing('Edad', document.getElementById('edad').value);
            addMissing('Rehiyon', document.getElementById('rehiyon').value);
            addMissing('Tanggapan na binisita', document.getElementById('tanggapan').value);
            addMissing('Uri ng transaksyon', document.getElementById('uri_transaksyon').value.trim());
            addMissing('CC1', form.querySelector('input[name="cc1"]:checked'));
            for (let i = 0; i <= 8; i++) addMissing('SQD' + i, form.querySelector(`input[name="sqd${i}"]:checked`));
            // Email format is optional but must be valid if filled
            const emailEl = document.getElementById('email');
            if (emailEl && emailEl.value.trim() && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailEl.value.trim())) missing.push('Email (invalid format)');

            // Also use browser's checkValidity for any other constraints (number range etc.)
            const browserValid = form.checkValidity();
            if (missing.length || !browserValid) {
                // Find first missing group to scroll to
                let firstTarget = null;
                if (!form.querySelector('input[name="uri_kliyente"]:checked')) firstTarget = document.querySelector('.form-group:has(input[name="uri_kliyente"])') || form.querySelector('input[name="uri_kliyente"]')?.closest('.sqd-item, .form-group');
                else if (!document.getElementById('pangalan').value.trim()) firstTarget = document.getElementById('pangalan').closest('.form-group');
                else if (!form.querySelector('input[name="kasarian"]:checked')) firstTarget = document.querySelector('input[name="kasarian"]')?.closest('.form-group');
                else if (!document.getElementById('edad').value) firstTarget = document.getElementById('edad').closest('.form-group');
                else if (!document.getElementById('rehiyon').value) firstTarget = document.getElementById('rehiyon').closest('.form-group');
                else if (!form.querySelector('input[name="cc1"]:checked')) firstTarget = document.querySelector('input[name="cc1"]')?.closest('.sqd-item');
                else {
                    for (let i = 0; i <= 8; i++) if (!form.querySelector(`input[name="sqd${i}"]:checked`)) { firstTarget = document.querySelector(`[data-sqd="sqd${i}"]`); break; }
                }
                if (!firstTarget) {
                    const inv = form.querySelector(':invalid');
                    if (inv) firstTarget = inv.closest('.sqd-item') || inv.closest('.form-group') || inv;
                }
                if (firstTarget) {
                    firstTarget.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    firstTarget.style.outline = '2px solid #dc2626';
                    firstTarget.style.borderRadius = '8px';
                    setTimeout(() => { firstTarget.style.outline = ''; }, 3000);
                }
                // Highlight all missing SQD items
                for (let i = 0; i <= 8; i++) if (!form.querySelector(`input[name="sqd${i}"]:checked`)) {
                    const el = document.querySelector(`[data-sqd="sqd${i}"]`);
                    if (el) { el.style.outline = '2px solid #dc2626'; el.style.borderRadius = '8px'; setTimeout(() => el.style.outline = '', 3000); }
                }
                msg.textContent = 'Kumpletuhin muna: ' + (missing.length ? missing.join(', ') : 'may kulang — paki-check ang pula') + '. Lahat ng SQD 0-8 ay required.';
                msg.style.display = 'block';
                console.warn('Form blocked — missing:', missing, 'browserValid:', browserValid, 'invalid:', form.querySelectorAll(':invalid'));
                return;
            }

            // Offline → save to IndexedDB — timer instead of spinner
            if (!navigator.onLine) {
                btn.disabled = true;
                btn.innerHTML = '<span class="psau-timer small" aria-hidden="true"><span class="psau-timer-hand"></span><span class="psau-timer-center"></span></span> Ipinapasa sa Offline Storage...';
                const formData = new FormData(form);
                const dataObj = {};
                formData.forEach((v, k) => dataObj[k] = v);
                try {
                    if (window.offlineStorage) await window.offlineStorage.saveFeedback(dataObj);
                    window.location.href = '/thank-you?offline=1';
                } catch (err) {
                    console.error('Offline save error:', err);
                    msg.textContent = 'Offline save failed: ' + (err.message || 'unknown');
                    msg.style.display = 'block';
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fas fa-paper-plane"></i> Isumite ang Feedback';
                }
                return;
            }

            // Online → submit via fetch — timer instead of spinner
            btn.disabled = true;
            btn.innerHTML = '<span class="psau-timer small" aria-hidden="true"><span class="psau-timer-hand"></span><span class="psau-timer-center"></span></span> Nagsusumite...';
            const formData = new FormData(form);
            try {
                const resp = await fetch(form.action, {
                    method: 'POST',
                    body: new URLSearchParams(formData),
                    headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' },
                    credentials: 'same-origin'
                });
                const ct = resp.headers.get('content-type') || '';
                let data = {};
                if (ct.includes('application/json')) data = await resp.json().catch(() => ({}));
                else data = { success: resp.ok, message: await resp.text().catch(() => '') };
                if (resp.ok && (data.success === true || data.success === undefined)) {
                    // Duplicate is also treated as success
                    window.location.href = '/thank-you' + (data.duplicate ? '?duplicate=1' : '');
                } else {
                    const errMsg = (data && (data.error || data.message)) || `Server rejected (${resp.status}). Try refreshing to get a fresh CSRF token.`;
                    msg.textContent = errMsg;
                    msg.style.display = 'block';
                    // If CSRF, suggest refresh
                    if (resp.status === 403 && /CSRF/i.test(errMsg)) msg.textContent += ' — i-refresh ang page at subukang muli.';
                    console.error('Submit failed', resp.status, data);
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fas fa-paper-plane"></i> Isumite ang Feedback';
                    // Do not scroll to top — keep message visible near button
                    msg.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }
            } catch (err) {
                console.error('Submit network error:', err);
                msg.textContent = 'Network error: ' + (err.message || 'hindi maabot ang server') + ' — susubukan ang offline save.';
                msg.style.display = 'block';
                // Fallback to offline save
                try {
                    const fd2 = new FormData(form);
                    const obj2 = {}; fd2.forEach((v, k) => obj2[k] = v);
                    if (window.offlineStorage) await window.offlineStorage.saveFeedback(obj2);
                    setTimeout(() => window.location.href = '/thank-you?offline=1', 800);
                } catch (_) { }
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-paper-plane"></i> Isumite ang Feedback';
            }
        });
    </script>

    <%- include('partials/footer') %>