<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Customer Feedback Report (PSAU-QMS-SF-20) - PSAU</title>
    <style>
        *,
        *::before,
        *::after {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background: #f0f2f5;
            padding: 1.5rem;
            color: #111;
        }

        .sheet {
            max-width: 820px;
            margin: 0 auto;
            background: #fff;
            padding: 1.2rem 1.4rem;
            box-shadow: 0 4px 16px rgba(0, 0, 0, .08);
        }

        .btn-bar {
            max-width: 820px;
            margin: 0 auto 1rem auto;
            display: flex;
            gap: 0.6rem;
            justify-content: flex-end;
        }

        .btn-bar button {
            padding: 0.55rem 1.1rem;
            background: #1b5e20;
            color: #fff;
            border: none;
            border-radius: 7px;
            font-weight: 700;
            font-size: 0.8rem;
            cursor: pointer;
            font-family: inherit;
        }

        .btn-bar button.secondary {
            background: #475569;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        td,
        th {
            border: 1px solid #000;
            padding: 4px 7px;
            font-size: 11.5px;
            vertical-align: top;
        }

        .hdr-table td {
            text-align: center;
        }

        .hdr-table .unit {
            font-size: 11px;
            letter-spacing: 0.4px;
        }

        .hdr-table .title {
            font-size: 15px;
            font-weight: 800;
            letter-spacing: 0.6px;
        }

        .logo-cell {
            width: 78px;
            text-align: center;
        }

        .logo-cell img {
            height: 52px;
            width: auto;
        }

        .meta-table td {
            font-size: 10.5px;
            text-align: center;
            padding: 3px 5px;
        }

        .info-table td {
            font-size: 11.5px;
        }

        .info-table .lbl {
            width: 26%;
            font-weight: 400;
        }

        .dist-table th {
            text-align: center;
            font-size: 10.5px;
            background: #f2f2f2;
        }

        .dist-table td {
            text-align: center;
            font-size: 11px;
        }

        .dist-table .month {
            text-align: left;
            font-size: 10.5px;
            letter-spacing: 0.4px;
        }

        .dist-table .quarter-row td {
            font-weight: 800;
            font-size: 11px;
            background: #f9f9f9;
        }

        .dist-table .total-row td {
            font-weight: 800;
            font-size: 11px;
            background: #f9f9f9;
        }

        .sqd-table th {
            background: #e8f5e9;
        }

        .section-box {
            border: 1px solid #000;
            margin-top: 8px;
        }

        .section-box .section-head {
            border-bottom: 1px solid #000;
            padding: 3px 7px;
            font-size: 11.5px;
            font-weight: 800;
            background: #fff;
        }

        .section-box .section-body {
            padding: 6px 9px;
            font-size: 11px;
            min-height: 52px;
            line-height: 1.5;
        }

        .sign-table td {
            height: 28px;
            font-size: 11px;
            vertical-align: top;
            padding: 4px 7px;
        }

        .sign-table th {
            font-size: 10.5px;
            background: #f2f2f2;
        }

        .sign-table .role {
            font-style: italic;
        }

        .sign-table .sig {
            height: 42px;
        }

        .note {
            font-size: 10px;
            font-style: italic;
            margin-top: 6px;
            color: #333;
        }

        #signEditBar {
            max-width: 820px;
            margin: 0 auto 0.8rem auto;
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            padding: 0.7rem 0.9rem;
            display: flex;
            gap: 0.7rem;
            flex-wrap: wrap;
            align-items: end;
        }

        #signEditBar input {
            width: 100%;
            padding: 0.35rem 0.5rem;
            border: 1px solid #cbd5e1;
            border-radius: 6px;
            font-size: 0.8rem;
        }

        #signEditBar label {
            font-size: 0.68rem;
            font-weight: 700;
            color: #334155;
            text-transform: uppercase;
            display: block;
            margin-bottom: 0.2rem;
        }

        @media print {
            body {
                background: #fff;
                padding: 0;
            }

            .btn-bar,
            #signEditBar {
                display: none !important;
            }

            .sheet {
                box-shadow: none;
                max-width: 100%;
                padding: 0.4rem 0.5rem;
            }

            @page {
                size: A4 portrait;
                margin: 10mm;
            }
        }
    </style>
</head>

<body>
    <div class="btn-bar">
        <button class="secondary" onclick="handleReportClose()">Close</button>
        <button onclick="window.print()">Print / Save as PDF</button>
    </div>
    <% const _todayShortQ=(typeof todayShort !=='undefined' && todayShort) ? todayShort : new
        Date().toLocaleDateString('en-US', { month:'2-digit', day:'2-digit', year:'numeric' }); %>
        <div id="signEditBar">
            <div style="flex:1; min-width:180px;"><label>Prepared by</label><input id="editPreparedBy"
                    value="<%= typeof preparedBy !== 'undefined' ? preparedBy : 'Ma. Reena Rose P. Tayag' %>"
                    oninput="document.getElementById('sigPreparedName').textContent=this.value"></div>
            <div style="flex:1; min-width:180px;"><label>Position</label><input id="editPreparedPos"
                    value="<%= typeof preparedPos !== 'undefined' ? preparedPos : 'Assistant Quality Management Representative' %>"
                    oninput="document.getElementById('sigPreparedPos').textContent=this.value"></div>
            <div style="flex:1; min-width:180px;"><label>Reviewed by</label><input id="editReviewedBy"
                    value="<%= typeof reviewedBy !== 'undefined' ? reviewedBy : 'Glenda Marie T. Maniago' %>"
                    oninput="document.getElementById('sigReviewedName').textContent=this.value"></div>
            <div style="flex:1; min-width:180px;"><label>Position</label><input id="editReviewedPos"
                    value="<%= typeof reviewedPos !== 'undefined' ? reviewedPos : 'Quality Management Representative' %>"
                    oninput="document.getElementById('sigReviewedPos').textContent=this.value"></div>
            <div style="flex:1; min-width:180px;"><label>Certified by</label><input id="editCertifiedBy"
                    value="<%= typeof certifiedBy !== 'undefined' ? certifiedBy : 'Dexter Andrew O. Manalo' %>"
                    oninput="document.getElementById('sigCertifiedName').textContent=this.value"></div>
            <div style="flex:1; min-width:180px;"><label>Position</label><input id="editCertifiedPos"
                    value="<%= typeof certifiedPos !== 'undefined' ? certifiedPos : 'Director, Office of Institutional Quality Assurance' %>"
                    oninput="document.getElementById('sigCertifiedPos').textContent=this.value"></div>
            <div style="width:100%; font-size:0.7rem; color:#64748b; margin-top:0.3rem;">Edit names/positions directly —
                changes reflect instantly on the sheet and on print. To make permanent, save in <strong>Settings →
                    Report Signatories</strong>.</div>
        </div>

        <div class="sheet">
            <!-- Document header -->
            <table class="hdr-table">
                <tr>
                    <td class="logo-cell" rowspan="2"><img src="/images/leftlogo.png" alt="Left Logo"
                            onerror="this.style.display='none'"></td>
                    <td class="unit">Quality Management System Unit</td>
                    <td class="logo-cell" rowspan="2"><img src="/images/rightlogo.png" alt="Right Logo"
                            onerror="this.style.display='none'"></td>
                </tr>
                <tr>
                    <td class="title">CUSTOMER FEEDBACK REPORT</td>
                </tr>
            </table>
            <table class="meta-table">
                <tr>
                    <td style="width:25%;">PSAU-QMS-SF-20</td>
                    <td style="width:25%;">Revision No.: 08</td>
                    <td style="width:28%;">Eff. Date: <%= typeof effDate !=='undefined' && effDate ? effDate : new
                            Date().toLocaleDateString('en-PH', { month:'long', day:'numeric', year:'numeric' }) %>
                    </td>
                    <td>Page 1 of 1</td>
                </tr>
            </table>
            <% const _generatedAtQ=typeof generatedAt !=='undefined' && generatedAt ? generatedAt : new
                Date().toLocaleString('en-PH', { year:'numeric', month:'long', day:'numeric', hour:'2-digit',
                minute:'2-digit', hour12:true }); %>
                <div style="text-align:right; font-size:9px; color:#64748b; margin-top:3px; font-style:italic;">Report
                    generated: <%= _generatedAtQ %>
                </div>

                <!-- Scope -->
                <% const _rawOfficeQ=(typeof selectedOffice !=='undefined' && selectedOffice && selectedOffice !=='all'
                    ) ? selectedOffice : ((typeof office !=='undefined' && office && office !=='all' ) ? office : '' );
                    const _office_q=_rawOfficeQ && _rawOfficeQ.trim().length ? _rawOfficeQ.trim() : 'All' ; const
                    _months_q=(typeof months !=='undefined' && Array.isArray(months)) ? months : []; const
                    _respondents_q=typeof respondents !=='undefined' ? respondents : (typeof feedbacks !=='undefined' ?
                    feedbacks.length : 0); const _year_q=typeof year !=='undefined' ? year : new Date().getFullYear();
                    %>
                    <table class="info-table" style="margin-top:8px;">
                        <tr>
                            <td class="lbl">Organizational Unit</td>
                            <td colspan="3" style="font-weight:800; letter-spacing:0.3px;">
                                <%= _office_q.toUpperCase() %>
                            </td>
                        </tr>
                        <tr>
                            <td class="lbl">Covered Month-Year</td>
                            <td>
                                <% _months_q.forEach(function(m, i) { %>
                                    <%= m.name %>
                                        <%= i < _months_q.length - 1 ? ' - ' : '' %>
                                            <% }) %>
                                                <strong>
                                                    <%= _year_q %>
                                                </strong>
                            </td>
                            <td class="lbl" style="width:22%;">Total Respondents</td>
                            <td style="width:12%; text-align:center; font-weight:800;">
                                <%= _respondents_q %>
                            </td>
                        </tr>
                    </table>

                    <!-- Monthly frequency distribution -->
                    <table class="dist-table" style="margin-top:8px;">
                        <tr>
                            <th rowspan="2" style="width:22%;">MONTH</th>
                            <th colspan="6">Frequency Distribution</th>
                            <th rowspan="2" style="width:13%;">Percentage (%)</th>
                            <th rowspan="2" style="width:15%;">Adjectival Equivalent</th>
                        </tr>
                        <tr>
                            <th style="width:6%;">5</th>
                            <th style="width:6%;">4</th>
                            <th style="width:6%;">3</th>
                            <th style="width:6%;">2</th>
                            <th style="width:6%;">1</th>
                            <th style="width:6%;">N/A</th>
                        </tr>
                        <% const _qs=(typeof quarterSummary !=='undefined' && quarterSummary) ? quarterSummary : (typeof
                            overall !=='undefined' ? overall : { counts:{'5':0,'4':0,'3':0,'2':0,'1':0,'N/A':0},
                            valid:0, pct:0, adj:'—' }); %>
                            <% _months_q.forEach(function(m) { %>
                                <tr>
                                    <td class="month">
                                        <%= m.name %>
                                    </td>
                                    <td>
                                        <%= m.counts['5'] %>
                                    </td>
                                    <td>
                                        <%= m.counts['4'] %>
                                    </td>
                                    <td>
                                        <%= m.counts['3'] %>
                                    </td>
                                    <td>
                                        <%= m.counts['2'] %>
                                    </td>
                                    <td>
                                        <%= m.counts['1'] %>
                                    </td>
                                    <td>
                                        <%= m.counts['N/A'] %>
                                    </td>
                                    <td>
                                        <%= m.valid> 0 ? m.pct.toFixed(2) + '%' : '—' %>
                                    </td>
                                    <td>
                                        <%= m.valid> 0 ? m.adj : '—' %>
                                    </td>
                                </tr>
                                <% }) %>
                                    <tr class="quarter-row">
                                        <td class="month">FREQUENCY DIST. FOR THE QUARTER</td>
                                        <td>
                                            <%= _qs.counts['5'] %>
                                        </td>
                                        <td>
                                            <%= _qs.counts['4'] %>
                                        </td>
                                        <td>
                                            <%= _qs.counts['3'] %>
                                        </td>
                                        <td>
                                            <%= _qs.counts['2'] %>
                                        </td>
                                        <td>
                                            <%= _qs.counts['1'] %>
                                        </td>
                                        <td>
                                            <%= _qs.counts['N/A'] %>
                                        </td>
                                        <td></td>
                                        <td></td>
                                    </tr>
                                    <tr class="quarter-row">
                                        <td class="month">QUARTERLY RATING</td>
                                        <td colspan="5" style="background:#fff;"></td>
                                        <td>
                                            <%= _qs.valid> 0 ? _qs.counts['N/A'] : '' %>
                                        </td>
                                        <td style="font-weight:800;">
                                            <%= _qs.valid> 0 ? _qs.pct.toFixed(2) + '%' : '—' %>
                                        </td>
                                        <td style="font-weight:800;">
                                            <%= _qs.valid> 0 ? _qs.adj : '—' %>
                                        </td>
                                    </tr>
                    </table>

                    <!-- SQD RATINGS SUMMARY -->
                    <table class="dist-table sqd-table" style="margin-top:8px;">
                        <tr>
                            <th colspan="11" style="text-align:center; font-size:11px; letter-spacing:0.3px;">SQD
                                RATINGS SUMMARY (SQD0 — SQD8)</th>
                        </tr>
                        <tr>
                            <th rowspan="2" style="width:7%;">SQD</th>
                            <th rowspan="2" style="width:30%; text-align:left;">Service Quality Dimension</th>
                            <th colspan="6">Frequency Distribution</th>
                            <th rowspan="2" style="width:7%;">Avg</th>
                            <th rowspan="2" style="width:10%;">Percentage (%)</th>
                            <th rowspan="2" style="width:12%;">Adjectival Equivalent</th>
                        </tr>
                        <tr>
                            <th style="width:6%;">5</th>
                            <th style="width:6%;">4</th>
                            <th style="width:6%;">3</th>
                            <th style="width:6%;">2</th>
                            <th style="width:6%;">1</th>
                            <th style="width:6%;">N/A</th>
                        </tr>
                        <% (typeof sqdSummary !=='undefined' && sqdSummary ? sqdSummary : []).forEach(function(s) { %>
                            <tr>
                                <td style="font-weight:800;">
                                    <%= s.code %>
                                </td>
                                <td style="text-align:left; font-size:9.5px; line-height:1.3;">
                                    <%= s.full %>
                                        <div style="font-size:8.5px; color:#555;">
                                            <%= s.desc %>
                                        </div>
                                </td>
                                <td>
                                    <%= s.counts['5'] %>
                                </td>
                                <td>
                                    <%= s.counts['4'] %>
                                </td>
                                <td>
                                    <%= s.counts['3'] %>
                                </td>
                                <td>
                                    <%= s.counts['2'] %>
                                </td>
                                <td>
                                    <%= s.counts['1'] %>
                                </td>
                                <td>
                                    <%= s.counts['N/A'] %>
                                </td>
                                <td style="font-weight:700;">
                                    <%= s.valid> 0 ? s.mean.toFixed(2) : '—' %>
                                </td>
                                <td>
                                    <%= s.valid> 0 ? s.pct.toFixed(2) + '%' : '—' %>
                                </td>
                                <td>
                                    <%= s.adj %>
                                </td>
                            </tr>
                            <% }) %>
                                <tr class="total-row">
                                    <td colspan="2" class="month">OVERALL SQD AVERAGE</td>
                                    <td>
                                        <%= (typeof sqdTotals !=='undefined' && sqdTotals ? sqdTotals['5'] : 0) %>
                                    </td>
                                    <td>
                                        <%= (typeof sqdTotals !=='undefined' && sqdTotals ? sqdTotals['4'] : 0) %>
                                    </td>
                                    <td>
                                        <%= (typeof sqdTotals !=='undefined' && sqdTotals ? sqdTotals['3'] : 0) %>
                                    </td>
                                    <td>
                                        <%= (typeof sqdTotals !=='undefined' && sqdTotals ? sqdTotals['2'] : 0) %>
                                    </td>
                                    <td>
                                        <%= (typeof sqdTotals !=='undefined' && sqdTotals ? sqdTotals['1'] : 0) %>
                                    </td>
                                    <td>
                                        <%= (typeof sqdTotals !=='undefined' && sqdTotals ? sqdTotals['N/A'] : 0) %>
                                    </td>
                                    <td style="font-weight:800;">
                                        <%= (typeof sqdOverallMean !=='undefined' ? Number(sqdOverallMean).toFixed(2)
                                            : '—' ) %>
                                    </td>
                                    <td style="font-weight:800;">
                                        <%= (typeof sqdOverallPct !=='undefined' ? Number(sqdOverallPct).toFixed(2)+'%'
                                            : '—' ) %>
                                    </td>
                                    <td style="font-weight:800;">
                                        <%= (typeof sqdOverallAdj !=='undefined' ? sqdOverallAdj : '—' ) %>
                                    </td>
                                </tr>
                    </table>

                    <% const _remarks_q=typeof remarks !=='undefined' ? remarks : (_qs.valid> 0 ? _qs.adj + ' — ' +
                        _qs.pct.toFixed(2) + '%' : 'No remarks — insufficient data.'); %>
                        <div style="display:flex; gap:8px; margin-top:6px;">
                            <div class="section-box" style="flex:1; margin-top:0;">
                                <div class="section-head">QUARTERLY RATING</div>
                                <div class="section-body"
                                    style="min-height:28px; text-align:center; font-weight:800; font-size:11px;">
                                    <%= _qs.valid> 0 ? _qs.pct.toFixed(2)+'%' : '—' %> — <%= _qs.valid> 0 ? _qs.adj :
                                            '—' %>
                                </div>
                            </div>
                            <div class="section-box" style="flex:1; margin-top:0;">
                                <div class="section-head">REMARKS:</div>
                                <div class="section-body" style="min-height:28px;">
                                    <%= _remarks_q %>
                                </div>
                            </div>
                        </div>




                        <!-- Sign-offs -->
                        <table class="sign-table" style="margin-top:8px;">
                            <tr>
                                <th style="width:34%; text-align:left;">Name</th>
                                <th style="width:34%; text-align:left;">Position/Designation</th>
                                <th style="width:18%;">Signature</th>
                                <th style="width:14%;">Date</th>
                            </tr>
                            <tr>
                                <td style="height:auto; padding:5px 7px;"><span
                                        style="font-style:italic; font-size:10px;">Prepared by:</span><br><strong
                                        id="sigPreparedName" style="text-decoration:underline;">
                                        <%= typeof preparedBy !=='undefined' ? preparedBy : 'Ma. Reena Rose P. Tayag' %>
                                    </strong></td>
                                <td id="sigPreparedPos">
                                    <%= typeof preparedPos !=='undefined' ? preparedPos
                                        : 'Assistant Quality Management Representative' %>
                                </td>
                                <td class="sig"></td>
                                <td id="sigPreparedDate"
                                    style="text-align:center; vertical-align:middle; font-size:10px;">
                                    <%= (typeof preparedDate !=='undefined' && preparedDate) ? preparedDate : (typeof
                                        _todayShortQ !=='undefined' ? _todayShortQ : new
                                        Date().toLocaleDateString('en-US',{month:'2-digit',day:'2-digit',year:'numeric'}))
                                        %>
                                </td>
                            </tr>
                            <tr>
                                <td style="height:auto; padding:5px 7px;"><span
                                        style="font-style:italic; font-size:10px;">Reviewed by:</span><br><strong
                                        id="sigReviewedName" style="text-decoration:underline;">
                                        <%= typeof reviewedBy !=='undefined' ? reviewedBy : 'Glenda Marie T. Maniago' %>
                                    </strong></td>
                                <td id="sigReviewedPos">
                                    <%= typeof reviewedPos !=='undefined' ? reviewedPos
                                        : 'Quality Management Representative' %>
                                </td>
                                <td class="sig"></td>
                                <td id="sigReviewedDate"
                                    style="text-align:center; vertical-align:middle; font-size:10px;">
                                    <%= (typeof reviewedDate !=='undefined' && reviewedDate) ? reviewedDate : (typeof
                                        _todayShortQ !=='undefined' ? _todayShortQ : new
                                        Date().toLocaleDateString('en-US',{month:'2-digit',day:'2-digit',year:'numeric'}))
                                        %>
                                </td>
                            </tr>
                            <tr>
                                <td style="height:auto; padding:5px 7px;"><span
                                        style="font-style:italic; font-size:10px;">Certified by:</span><br><strong
                                        id="sigCertifiedName" style="text-decoration:underline;">
                                        <%= typeof certifiedBy !=='undefined' ? certifiedBy : 'Dexter Andrew O. Manalo'
                                            %>
                                    </strong></td>
                                <td id="sigCertifiedPos">
                                    <%= typeof certifiedPos !=='undefined' ? certifiedPos
                                        : 'Director, Office of Institutional Quality Assurance' %>
                                </td>
                                <td class="sig"></td>
                                <td id="sigCertifiedDate"
                                    style="text-align:center; vertical-align:middle; font-size:10px;">
                                    <%= (typeof certifiedDate !=='undefined' && certifiedDate) ? certifiedDate : (typeof
                                        _todayShortQ !=='undefined' ? _todayShortQ : new
                                        Date().toLocaleDateString('en-US',{month:'2-digit',day:'2-digit',year:'numeric'}))
                                        %>
                                </td>
                            </tr>
                        </table>

                        <p class="note">To be forwarded to the concerned unit:</p>
                        <table class="sign-table">
                            <tr>
                                <th style="width:34%; text-align:left;">Name</th>
                                <th style="width:34%; text-align:left;">Position/Designation</th>
                                <th style="width:18%;">Signature</th>
                                <th style="width:14%;">Date</th>
                            </tr>
                            <tr>
                                <td style="height:42px;"><span style="font-style:italic; font-size:10px;">Received
                                        by:</span></td>
                                <td>Document Control Coordinator</td>
                                <td></td>
                                <td></td>
                            </tr>
                        </table>
        </div>
        <script>
            function handleReportClose() {
                try {
                    if (window.parent && window.parent !== window && typeof window.parent.closeReportViewer === 'function') {
                        window.parent.closeReportViewer();
                        return;
                    }
                    if (window.parent && window.parent.document) {
                        const ov = window.parent.document.getElementById('reportViewerOverlay');
                        if (ov && ov.style.display !== 'none') {
                            ov.style.display = 'none';
                            window.parent.document.body.style.overflow = '';
                            const fr = window.parent.document.getElementById('reportViewerFrame');
                            if (fr) fr.src = 'about:blank';
                            return;
                        }
                    }
                } catch (e) { }
                if (window.opener) {
                    window.close();
                    return;
                }
                if (window.history.length > 1) {
                    window.history.back();
                } else {
                    window.location.href = '/admin/dashboard';
                }
                setTimeout(function () { try { window.close(); } catch (e) { } }, 100);
            }
            document.addEventListener('keydown', function (e) { if (e.key === 'Escape') handleReportClose(); });
        </script>
</body>

</html>