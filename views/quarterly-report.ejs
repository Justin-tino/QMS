  <!-- PSAU Global Timer — timer instead of circle for all async -->
  <div id="psauGlobalTimer" class="psau-global-timer" style="display:none;" aria-live="polite" aria-busy="true">
    <div class="psau-global-timer-card">
      <div class="psau-timer" style="width:52px; height:52px; border-width:3px; margin-bottom:0.2rem;">
        <div class="psau-timer-hand" style="height:18px;"></div>
        <div class="psau-timer-center"></div>
      </div>
      <div id="psauGlobalTimerTitle" class="psau-global-timer-title">Loading...</div>
      <div id="psauGlobalTimerSub" class="psau-global-timer-sub">Please wait <span id="psauGlobalTimerElapsed"
          style="font-weight:800; color:#1b5e20;">0.0s</span></div>
    </div>
  </div>

  <div id="psauDialog" class="psau-dialog-overlay" style="display:none;" role="dialog" aria-modal="true"
    aria-labelledby="psauDialogTitle" aria-describedby="psauDialogMessage">
    <div class="psau-dialog-card">
      <div id="psauDialogIcon" class="psau-dialog-icon variant-warning"><i class="fas fa-right-from-bracket"></i></div>
      <h3 id="psauDialogTitle" class="psau-dialog-title">Proceed to logout?</h3>
      <p id="psauDialogMessage" class="psau-dialog-message">You will be signed out and need to sign in again.</p>
      <div class="psau-dialog-actions">
        <button type="button" id="psauDialogCancel" class="psau-btn-secondary">No</button>
        <button type="button" id="psauDialogConfirm" class="psau-btn-primary">Yes</button>
      </div>
    </div>
  </div>
  <script>
    // Logout confirm — uses designed dialog, fallback to native
    function confirmLogoutQ(e) {
      if (e) e.preventDefault();
      var go = function () { window.location.href = '/admin/logout'; };
      var ov = document.getElementById('psauDialog');
      if (ov && document.getElementById('psauDialogConfirm')) {
        // set text securely
        document.getElementById('psauDialogTitle').textContent = 'Proceed to logout?';
        document.getElementById('psauDialogMessage').textContent = 'You will be signed out of your account.';
        document.getElementById('psauDialogCancel').textContent = 'No';
        document.getElementById('psauDialogConfirm').textContent = 'Yes';
        ov.style.display = 'flex'; ov.classList.add('open'); document.body.style.overflow = 'hidden';
        var c = document.getElementById('psauDialogConfirm'), x = document.getElementById('psauDialogCancel');
        var close = function (ok) {
          ov.style.display = 'none'; ov.classList.remove('open'); document.body.style.overflow = '';
          c.onclick = null; x.onclick = null; ov.onclick = null;
          if (ok) go();
        };
        c.onclick = function () { close(true); };
        x.onclick = function () { close(false); };
        ov.onclick = function (ev) { if (ev.target === ov) close(false); };
        return false;
      }
      if (confirm('Proceed to logout?')) go();
      return false;
    }
    // Global timer helper for quarterly (timer instead of spinner)
    let _qGlobalInt = null, _qGlobalStart = 0;
    function showGlobalTimer(t, s) {
      var ov = document.getElementById('psauGlobalTimer');
      var tt = document.getElementById('psauGlobalTimerTitle');
      var ss = document.getElementById('psauGlobalTimerSub');
      if (!ov) return;
      if (tt) tt.textContent = String(t || 'Loading...');
      if (ss) ss.innerHTML = 'Please wait <span id="psauGlobalTimerElapsed" style="font-weight:800; color:#1b5e20;">0.0s</span>';
      ov.style.display = 'flex'; ov.classList.add('open');
      document.body.style.overflow = 'hidden';
      _qGlobalStart = Date.now();
      if (_qGlobalInt) clearInterval(_qGlobalInt);
      _qGlobalInt = setInterval(function () { var el = document.getElementById('psauGlobalTimerElapsed'); if (el) el.textContent = ((Date.now() - _qGlobalStart) / 1000).toFixed(1) + 's'; }, 100);
    }
    function hideGlobalTimer() {
      var ov = document.getElementById('psauGlobalTimer');
      if (ov) { ov.style.display = 'none'; ov.classList.remove('open'); }
      document.body.style.overflow = '';
      if (_qGlobalInt) { clearInterval(_qGlobalInt); _qGlobalInt = null; }
    }
    document.addEventListener('DOMContentLoaded', function () {
      document.querySelectorAll('.q-pill').forEach(function (a) {
        a.addEventListener('click', function () { showGlobalTimer('Switching quarter...', ''); });
      });
      var sel = document.querySelector('select[onchange*="quarterly-reports"]');
      if (sel) sel.addEventListener('change', function () { showGlobalTimer('Loading year...', ''); });
    });
    // Dashboard is sole writer — this picker is now read-only and mirrors Dashboard
    function toggleQuarterDatePicker() {
      var txt=null; try{ var r=localStorage.getItem('psau_global_dateFilter'); if(r){ var gf=JSON.parse(r); if(gf.filterType==='range'&&gf.dateFrom&&gf.dateTo&&gf.dateFrom===gf.dateTo){ var d=new Date(gf.dateFrom); if(!isNaN(d.getTime())) txt=d.toLocaleDateString('en-PH',{year:'numeric',month:'long',day:'numeric'}); else txt=gf.dateFrom; } else if(gf.badgeText) txt=gf.badgeText; } }catch(e){}
      var msg=txt ? ('Filtered date: '+txt+' (from Dashboard). Go to Dashboard to change.') : 'No date filter — Overall (All Time). Set date on Dashboard.';
      // use app dialog if available
      if(typeof psauAlert==='function'){ try{ psauAlert({title:'Date follows Dashboard', message:msg, variant:'info'}); return; }catch(e){} }
      // fallback to unified dialog
      var ov=document.getElementById('psauDialog');
      if(ov && document.getElementById('psauDialogConfirm')){
        try{
          document.getElementById('psauDialogTitle').textContent='Date follows Dashboard';
          document.getElementById('psauDialogMessage').textContent=msg;
          document.getElementById('psauDialogCancel').textContent='OK';
          document.getElementById('psauDialogConfirm').textContent='Go to Dashboard';
          ov.style.display='flex'; ov.classList.add('open'); document.body.style.overflow='hidden';
          var c=document.getElementById('psauDialogConfirm'), x=document.getElementById('psauDialogCancel');
          var close=function(go){ ov.style.display='none'; ov.classList.remove('open'); document.body.style.overflow=''; c.onclick=null; x.onclick=null; ov.onclick=null; if(go) window.location.href='/admin/dashboard'; };
          c.onclick=function(){ close(true); }; x.onclick=function(){ close(false); }; ov.onclick=function(ev){ if(ev.target===ov) close(false); };
          return;
        }catch(e){}
      }
      alert(msg);
    }
    // Auto-mirror Dashboard date on load if no explicit ?date in URL (hidden badge)
    (function(){
      try{
        var url=new URL(window.location.href);
        if(url.searchParams.has('date')) return;
        var raw=localStorage.getItem('psau_global_dateFilter');
        if(!raw) return;
        var gf=JSON.parse(raw);
        var dateStr='';
        if(gf && gf.filterType==='range' && gf.dateFrom && gf.dateTo && gf.dateFrom===gf.dateTo) dateStr=gf.dateFrom;
        else if(gf && gf.dateFrom) dateStr=gf.dateFrom;
        if(!dateStr || !/^\d{4}-\d{2}-\d{2}$/.test(dateStr)) return;
        var d=new Date(dateStr); if(isNaN(d.getTime())) return;
        var badge=document.getElementById('quarterDateBadgeText');
        if(badge){ badge.textContent=d.toLocaleDateString('en-PH',{year:'numeric',month:'long',day:'numeric'}); badge.title='Filtered date: '+badge.textContent+' (from Dashboard)'; }
        var br=document.getElementById('quarterDateBadge');
        if(br) br.title='Date follows Dashboard: '+d.toLocaleDateString('en-PH',{year:'numeric',month:'long',day:'numeric'})+' — change on Dashboard';
      }catch(e){}
    })();
    // Report-specific date for Generate Report (AI Assistant only, independent from Dashboard global filter)
    (function(){
      var inp=document.getElementById('aiReportDate');
      var btn=document.getElementById('btnGenerateReport');
      var officeSel=document.getElementById('quarterOfficeFilter');
      if(!inp||!btn) return;
      function getDefaultReportDate(){
        var serverDate='<%= typeof selectedQuarterDate !== "undefined" ? selectedQuarterDate : "" %>';
        if(serverDate && /^\d{4}-\d{2}-\d{2}$/.test(serverDate)) return serverDate;
        try{
          var raw=localStorage.getItem('psau_global_dateFilter');
          if(raw){
            var gf=JSON.parse(raw);
            if(gf.filterType==='range' && gf.dateFrom && /^\d{4}-\d{2}-\d{2}$/.test(gf.dateFrom)) return gf.dateFrom;
            if(gf.dateFrom && /^\d{4}-\d{2}-\d{2}$/.test(gf.dateFrom)) return gf.dateFrom;
          }
        }catch(e){}
        return new Date().toISOString().split('T')[0];
      }
      function updateGenerateReportLink(){
        var v=inp.value;
        if(!v || !/^\d{4}-\d{2}-\d{2}$/.test(v)) return;
        var office=officeSel ? officeSel.value : '<%= typeof selectedOffice !== "undefined" ? selectedOffice : "all" %>';
        var params=new URLSearchParams();
        params.set('filterType','range');
        params.set('office', office||'all');
        params.set('dateFrom', v);
        params.set('dateTo', v);
        btn.href='/admin/report?' + params.toString();
        try{ btn.title='Generate report for '+ new Date(v).toLocaleDateString('en-PH',{year:'numeric',month:'long',day:'numeric'}); }catch(e){}
      }
      inp.value=getDefaultReportDate();
      updateGenerateReportLink();
      inp.addEventListener('change', updateGenerateReportLink);
      inp.addEventListener('input', updateGenerateReportLink);
      if(officeSel) officeSel.addEventListener('change', updateGenerateReportLink);
    })();
    function isValidYMDQ(s) { return /^\d{4}-\d{2}-\d{2}$/.test(s) && !isNaN(new Date(s).getTime()); }
    function shiftQuarterDate(dir) {
      var inp = document.getElementById('quarterDatePickerInput');
      if (!inp) return;
      if (!inp.value) { var t = new Date(); t.setDate(t.getDate() + dir); inp.value = t.toISOString().split('T')[0]; return; }
      if (!isValidYMDQ(inp.value)) return;
      var d = new Date(inp.value); d.setDate(d.getDate() + dir);
      var iso = d.toISOString().split('T')[0];
      if (isValidYMDQ(iso)) inp.value = iso;
    }
    function getQuarterFromMD(m) { // 0-indexed month
      if (m <= 2) return 'Q1'; if (m <= 5) return 'Q2'; if (m <= 8) return 'Q3'; return 'Q4';
    }
    function applyQuarterDate() {
      var inp = document.getElementById('quarterDatePickerInput');
      var v = inp ? String(inp.value || '').trim() : '';
      if (!v) { clearQuarterDate(); return; }
      if (!isValidYMDQ(v)) { alert('Please pick a valid date (YYYY-MM-DD).'); return; }
      var d = new Date(v);
      var y = d.getFullYear(); var q = getQuarterFromMD(d.getMonth());
      // sanitize year 2000-2100
      y = Math.max(2000, Math.min(2100, y));
      document.getElementById('quarterDatePopover').style.display = 'none';
      showGlobalTimer('Loading ' + q + ' ' + y + '...', '');
      var url = new URL(window.location.href);
      url.searchParams.set('year', y);
      url.searchParams.set('quarter', q);
      url.searchParams.set('date', v);
      window.location.href = url.toString();
    }
    function applyQuarterOfficeFilter(val) {
      showGlobalTimer('Filtering by office...', '');
      var url = new URL(window.location.href);
      if (val && val !== 'all') {
        url.searchParams.set('office', val);
      } else {
        url.searchParams.delete('office');
      }
      window.location.href = url.toString();
    }
    function clearQuarterDate() {
      var pop = document.getElementById('quarterDatePopover');
      if (pop) pop.style.display = 'none';
      window.location.href = '/admin/quarterly-reports';
    }
    document.addEventListener('click', function (e) {
      var pop = document.getElementById('quarterDatePopover');
      var badge = document.getElementById('quarterDateBadge');
      if (!pop || pop.style.display === 'none') return;
      if (pop.contains(e.target) || (badge && badge.contains(e.target))) return;
      pop.style.display = 'none';
    });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') { var pop = document.getElementById('quarterDatePopover'); if (pop) pop.style.display = 'none'; } });
    function printAIReport() {
      const activeOffice = (document.getElementById('quarterOfficeFilter') && document.getElementById('quarterOfficeFilter').value) ? document.getElementById('quarterOfficeFilter').value : '<%= typeof selectedOffice !== "undefined" ? selectedOffice : "all" %>';
      const p = new URLSearchParams({ quarter: '<%= activeQuarter %>', year: '<%= selectedYear %>', office: activeOffice }); window.open('/admin/print-ai-report?' + p.toString(), '_blank');
    }
    async function triggerAIAnalysis(forceRefresh) {
      const activeOffice = (document.getElementById('quarterOfficeFilter') && document.getElementById('quarterOfficeFilter').value) ? document.getElementById('quarterOfficeFilter').value : '<%= typeof selectedOffice !== "undefined" ? selectedOffice : "all" %>';
      const c = document.getElementById('aiAnalysisContainer'), r = document.getElementById('btnRefreshAI'), p = document.getElementById('btnPrintAI');
      c.innerHTML = '<div style="text-align:center;padding:1.4rem 1rem;"><div class="psau-timer" style="margin:0 auto 0.9rem auto;"><div class="psau-timer-hand"></div><div class="psau-timer-center"></div></div><div style="font-weight:700;color:#0f172a;font-size:0.85rem;">Analyzing quarterly data...</div><div style="font-size:0.78rem;color:#64748b;margin-top:0.2rem;">Trilingual Naive Bayes &bull; K-Means &bull; Q1-Q4</div><div id="qTimerElapsed" style="margin-top:0.55rem; font-size:0.72rem; font-weight:700; color:#1b5e20; font-variant-numeric:tabular-nums;">0.0s</div></div>';
      let qStart = Date.now(); let qInt = setInterval(function () { var el = document.getElementById('qTimerElapsed'); if (el) el.textContent = ((Date.now() - qStart) / 1000).toFixed(1) + 's'; }, 100);
      if (r) r.style.display = 'none'; if (p) p.style.display = 'none';
      try {
        const pa = new URLSearchParams({ quarter: '<%= activeQuarter %>', year: '<%= selectedYear %>', office: activeOffice }); if (forceRefresh) pa.append('refresh', 'true');
        const res = await fetch('/admin/generate-ai-report?' + pa.toString()); const j = await res.json();
        clearInterval(qInt);
        if (j.success) { c.innerHTML = '<div class="ai-analysis-content">' + j.aiAnalysis + '</div>'; if (r) { r.style.display = 'inline-flex'; } if (p) { p.style.display = 'inline-flex'; } }
        else { c.innerHTML = '<div style="text-align:center;padding:1rem 1rem;border:1px dashed #fecaca;border-radius:10px;background:#fef2f2;"><div style="color:#dc2626;font-weight:800;font-size:0.9rem;"><i class="fas fa-triangle-exclamation"></i> Failed</div><div style="font-size:0.78rem;color:#64748b;margin:0.3rem auto 0.7rem auto;max-width:420px;">' + (j.error || 'Unknown error') + '</div><button onclick="triggerAIAnalysis(false)" style="background:#dc2626;color:#fff;border:none;padding:0.45rem 0.8rem;border-radius:7px;font-weight:700;cursor:pointer;">Try Again</button></div>'; }
      } catch (e) { clearInterval(qInt); console.error(e); c.innerHTML = '<div style="text-align:center;padding:1rem;border:1px dashed #fecaca;border-radius:10px;background:#fef2f2;"><div style="color:#dc2626;font-weight:800;">Network Error</div><div style="font-size:0.78rem;color:#64748b;margin-top:0.2rem;">Check connection and try again.</div><button onclick="triggerAIAnalysis(false)" style="margin-top:0.6rem;background:#dc2626;color:#fff;border:none;padding:0.45rem 0.8rem;border-radius:7px;font-weight:700;cursor:pointer;">Retry</button></div>'; }
    }

    // --- New AI Suggestions (suggestions-only, secure, quality) — Image 2 ---
    (function () {
      const ta = document.getElementById('aiSuggestInput');
      const cnt = document.getElementById('aiSuggestCount');
      if (ta && cnt) {
        const upd = function () { cnt.textContent = String(ta.value.length); ta.style.borderColor = ta.value.length === 500 ? '#f59e0b' : '#86efac'; };
        ta.addEventListener('input', upd);
        ta.addEventListener('change', upd);
        upd();
      }
    })();
    async function generateAISuggestions() {
      const input = document.getElementById('aiSuggestInput');
      const btn = document.getElementById('aiSuggestBtn');
      const reply = document.getElementById('aiSuggestReply');
      const status = document.getElementById('aiSuggestStatus');
      const meta = document.getElementById('aiSuggestMeta');
      const raw = input ? String(input.value || '').trim() : '';
      if (!raw || raw.length < 3) { alert('Please enter your request (at least 3 characters).'); if (input) input.focus(); return; }
      if (raw.length > 500) { alert('Request too long (max 500).'); return; }
      const prevHtml = btn ? btn.innerHTML : '';
      if (btn) { btn.disabled = true; btn.style.opacity = '0.7'; btn.innerHTML = '<span style="width:14px;height:14px;border:2px solid rgba(255,255,255,0.6);border-top-color:#fff;border-radius:50%;display:inline-block;animation:spin 0.7s linear infinite;"></span> Generating...'; }
      const activeOffice = (document.getElementById('quarterOfficeFilter') && document.getElementById('quarterOfficeFilter').value) ? document.getElementById('quarterOfficeFilter').value : '<%= typeof selectedOffice !== "undefined" ? selectedOffice : "all" %>';
      const scopeText = (activeOffice && activeOffice !== 'all') ? activeOffice : 'University-Wide';
      if (reply) {
        reply.innerHTML = '<div style="text-align:center;padding:2rem 1rem;"><div class="psau-timer" style="margin:0 auto 0.9rem auto;"><div class="psau-timer-hand"></div><div class="psau-timer-center"></div></div><div style="font-weight:700;color:#0f172a;font-size:0.85rem;">Generating suggestions...</div><div style="font-size:0.76rem;color:#64748b;margin-top:0.2rem;">Gemini AI • suggestions only • ' + scopeText + ' • <%= activeQuarter %> <%= selectedYear %></div><div id="aiSuggestTimer" style="margin-top:0.5rem;font-size:0.72rem;font-weight:700;color:#16a34a;">0.0s</div></div>';
        const start = Date.now();
        const int = setInterval(function () { var el = document.getElementById('aiSuggestTimer'); if (el) el.textContent = ((Date.now() - start) / 1000).toFixed(1) + 's'; }, 100);
        reply._aiInt = int;
      }
      try {
        const payload = { quarter: '<%= activeQuarter %>', year: '<%= selectedYear %>', office: activeOffice, userRequest: raw };
        let data;
        try {
          const res = await fetch('/admin/ai-suggestions', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
            credentials: 'same-origin',
            body: JSON.stringify(payload)
          });
          const text = await res.text();
          try { data = JSON.parse(text); } catch (parseErr) {
            console.warn('AI suggestions: server returned non-JSON (maybe 404). Using local SQD+Form fallback.', text.substring(0, 200));
            throw new Error('Server not ready — showing local SQD + Form suggestions.');
          }
          if (!res.ok || !data.success) throw new Error((data && data.error) || 'Failed (' + res.status + ')');
        } catch (fetchErr) {
          // Local fallback — ACCURACY: never show N/A/5.00 findings when no data exists.
          console.warn('AI fetch failed, local fallback:', fetchErr.message);
          if (reply && reply._aiInt) { clearInterval(reply._aiInt); reply._aiInt = null; }
          // Injected count for the selected quarter/scope — server-rendered accurate flag
          const _fallbackHasData = <%= (typeof activeReport !== 'undefined' && activeReport && activeReport.items && activeReport.items.length > 0) ? 'true' : 'false' %>;
          if (!_fallbackHasData) {
            const _scopeEsc = String(scopeText || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
            const _noDataHtml = `
<div style="background:#fffbeb; border:1px solid #fcd34d; border-radius:12px; padding:0.95rem 1.1rem; margin-bottom:0.85rem; display:flex; gap:0.85rem; align-items:flex-start;">
  <div style="width:42px; height:42px; border-radius:12px; background:#fef3c7; color:#d97706; display:flex; align-items:center; justify-content:center; font-size:1.15rem; flex-shrink:0; border:1px solid #fde68a;"><i class="fas fa-inbox"></i></div>
  <div style="flex:1;">
    <div style="font-weight:800; color:#92400e; font-size:0.90rem; line-height:1.3;">No Feedback Data Available — `+_scopeEsc+` (0 respondents)</div>
    <div style="font-size:0.82rem; color:#78350f; margin-top:0.30rem; line-height:1.5;">Offline fallback cannot compute SQD averages — averages are <strong>N/A</strong>. Collect at least 5–10 responses first.</div>
    <div style="font-size:0.74rem; color:#a16207; margin-top:0.45rem; background:#ffffff; border:1px dashed #fcd34d; padding:0.45rem 0.65rem; border-radius:8px;">Showing <strong>setup guidance</strong> (not data-driven findings). Reconnect and click Generate again once data exists.</div>
  </div>
</div>
<div class="ai-suggestion-card" style="background:#ffffff; border:1px dashed #fcd34d; border-radius:12px; padding:0.85rem 1rem; margin-bottom:0.75rem; display:flex; align-items:flex-start; gap:0.85rem;">
  <div style="width:40px; height:40px; border-radius:12px; background:#fef3c7; color:#d97706; display:flex; align-items:center; justify-content:center; font-size:1.1rem; flex-shrink:0; border:1px solid #fde68a;"><i class="fas fa-qrcode"></i></div>
  <div style="flex:1;"><div style="display:flex; align-items:center; gap:0.45rem; margin-bottom:0.2rem;"><span style="width:20px; height:20px; border-radius:50%; background:#f59e0b; color:#fff; font-weight:700; font-size:0.68rem; display:inline-flex; align-items:center; justify-content:center;">1</span><span style="font-weight:700; color:#0f172a; font-size:0.88rem;">Deploy QR Codes & Invite Responses</span><span style="font-size:0.66rem; font-weight:700; color:#d97706; background:#fffbeb; border:1px solid #fde68a; padding:0.12rem 0.45rem; border-radius:20px; margin-left:0.3rem;">SETUP</span></div><div style="font-size:0.8rem; color:#475569; line-height:1.45; margin-bottom:0.35rem;">No data for <strong>`+_scopeEsc+`</strong> — make the form discoverable at every service point.</div><div style="background:#fffbeb; border-left:3px solid #f59e0b; padding:0.4rem 0.6rem; border-radius:4px; font-size:0.76rem; color:#334155;"><strong style="color:#92400e;"><i class="fas fa-lightbulb" style="margin-right:0.25rem;"></i> Strategy:</strong> Print QR codes on transaction slips, desk standees, and waiting-area posters. Aim for ≥10 responses before analysis.</div></div>
</div>
<div class="ai-suggestion-card" style="background:#ffffff; border:1px dashed #fcd34d; border-radius:12px; padding:0.85rem 1rem; margin-bottom:0.75rem; display:flex; align-items:flex-start; gap:0.85rem;">
  <div style="width:40px; height:40px; border-radius:12px; background:#fef3c7; color:#d97706; display:flex; align-items:center; justify-content:center; font-size:1.1rem; flex-shrink:0; border:1px solid #fde68a;"><i class="fas fa-chart-line"></i></div>
  <div style="flex:1;"><div style="display:flex; align-items:center; gap:0.45rem; margin-bottom:0.2rem;"><span style="width:20px; height:20px; border-radius:50%; background:#f59e0b; color:#fff; font-weight:700; font-size:0.68rem; display:inline-flex; align-items:center; justify-content:center;">2</span><span style="font-weight:700; color:#0f172a; font-size:0.88rem;">Verify Collection, Then Re-Run</span><span style="font-size:0.66rem; font-weight:700; color:#d97706; background:#fffbeb; border:1px solid #fde68a; padding:0.12rem 0.45rem; border-radius:20px; margin-left:0.3rem;">NEXT STEP</span></div><div style="font-size:0.8rem; color:#475569; line-height:1.45; margin-bottom:0.35rem;">Once feedback accumulates, Generate will show <strong>SQD-specific scores</strong> and Naïve Bayes sentiment, not generic setup tips.</div><div style="background:#fffbeb; border-left:3px solid #f59e0b; padding:0.4rem 0.6rem; border-radius:4px; font-size:0.76rem; color:#334155;"><strong style="color:#92400e;"><i class="fas fa-lightbulb" style="margin-right:0.25rem;"></i> Strategy:</strong> Check Dashboard after 5–10 submissions, then click Generate again for data-driven priorities.</div></div>
</div>`;
            if (reply) {
              reply.innerHTML = _noDataHtml;
              const st = document.getElementById('aiSuggestStatus');
              if (st) { st.style.display = 'inline-flex'; st.innerHTML = '<span style="color:#d97706;">&#9888;</span> No data — setup guidance shown'; }
            }
            return;
          }
          const fallbackHtml = (function () {
            const safeReq = String(raw).replace(/</g, '&lt;').substring(0, 120);
            const pool = [
              {
                title: "Streamline Transaction & Processing Speed (SQD1)",
                detail: "Address processing delays and long queues identified in quarterly client feedback logs.",
                strategy: "Establish express transaction lanes, digitize document queuing, and set target processing SLAs (max 15 mins per transaction).",
                icon: "fas fa-comment-dots"
              },
              {
                title: "Enhance Requirements Clarity & Guidance (SQD2)",
                detail: "Reduce client confusion regarding documentary requirements before reaching frontline windows.",
                strategy: "Publish step-by-step infographic checklists at office entrances and post downloadable requirement PDFs on the university portal.",
                icon: "fas fa-calendar-check"
              },
              {
                title: "Simplify Office Approval Workflows (SQD3)",
                detail: "Minimize redundant signatories and inter-office routing reported in quarterly feedback.",
                strategy: "Consolidate approval forms into single-window digital routing and train staff on cross-department document verification.",
                icon: "fas fa-users"
              },
              {
                title: "Improve Information Transparency & Status Tracking (SQD4)",
                detail: "Ensure clear communication of service timelines, Citizen's Charter standards, and document status.",
                strategy: "Install digital status monitors in waiting areas and launch real-time online tracking for student requests.",
                icon: "fas fa-trophy"
              },
              {
                title: "Maintain Clear Payment Channels & Transparency (SQD5)",
                detail: "Ensure transparency in official fee assessments and prevent cashier bottlenecking during enrollment.",
                strategy: "Integrate online e-payment gateways (GCash/PayMaya/Bank) and display official receipt breakdown signs at counters.",
                icon: "fas fa-chart-column"
              },
              {
                title: "Upgrade Waiting Area Comfort & Facility Hygiene (SQD6)",
                detail: "Improve physical waiting spaces, seating capacity, and ventilation based on visitor feedback.",
                strategy: "Implement bi-hourly sanitization logs, expand shaded outdoor waiting benches, and install free drinking water stations.",
                icon: "fas fa-couch"
              },
              {
                title: "Elevate Frontline Staff Courtesy & Client Care (SQD7)",
                detail: "Reinforce positive client engagement and active listening across all administrative service desks.",
                strategy: "Conduct mandatory quarterly customer service orientation for staff, establish help desks for complex inquiries, and enforce polite greeting protocols.",
                icon: "fas fa-hands-helping"
              },
              {
                title: "Establish Rapid Helpdesk & Problem Resolution (SQD8)",
                detail: "Ensure unhandled client inquiries or complaints receive prompt resolution within 24 hours.",
                strategy: "Deploy a dedicated QMS helpdesk desk officer and track complaint resolution SLAs in weekly administrative reviews.",
                icon: "fas fa-headset"
              }
            ];

            // Dynamic offset seed based on prompt & timestamp so every regenerate gives new strategies
            const seed = (safeReq.length + Date.now()) % pool.length;
            const picked = [];
            for (let i = 0; i < 5; i++) {
              picked.push(pool[(seed + i * 2) % pool.length]);
            }

            return picked.map((card, i) => `
            <div class="ai-suggestion-card" style="background:#ffffff; border:1px solid #e2e8f0; border-radius:12px; padding:0.85rem 1rem; margin-bottom:0.75rem; display:flex; align-items:flex-start; gap:0.85rem; transition:all 0.2s ease;">
              <div style="width:40px; height:40px; border-radius:12px; background:#e8f5e9; color:#16a34a; display:flex; align-items:center; justify-content:center; font-size:1.1rem; flex-shrink:0; border:1px solid #c8e6c9;">
                <i class="${card.icon}"></i>
              </div>
              <div style="flex:1;">
                <div style="display:flex; align-items:center; gap:0.45rem; margin-bottom:0.2rem;">
                  <span style="width:20px; height:20px; border-radius:50%; background:#16a34a; color:#ffffff; font-weight:700; font-size:0.7rem; display:inline-flex; align-items:center; justify-content:center; flex-shrink:0;">${i + 1}</span>
                  <span style="font-weight:700; color:#0f172a; font-size:0.88rem;">${card.title}</span>
                </div>
                <div style="font-size:0.8rem; color:#475569; line-height:1.45; margin-bottom:0.35rem;">${card.detail}</div>
                <div style="background:#f8fafc; border-left:3px solid #16a34a; padding:0.4rem 0.6rem; border-radius:4px; font-size:0.76rem; color:#334155;">
                  <strong style="color:#15803d;"><i class="fas fa-lightbulb" style="margin-right:0.25rem;"></i> Strategy:</strong> ${card.strategy}
                </div>
              </div>
            </div>
          `).join('');
          })();
          if (reply) {
            reply.innerHTML = fallbackHtml;
            const st = document.getElementById('aiSuggestStatus');
            if (st) { st.style.display = 'inline-flex'; st.innerHTML = '<span style="color:#16a34a;">&#10003;</span> Generated'; }
            const mt = document.getElementById('aiSuggestMeta');
            if (mt) mt.textContent = 'SQD + Form suggestions • ' + new Date().toLocaleString('en-PH');
          }
          return;
        }
        if (reply && reply._aiInt) { clearInterval(reply._aiInt); reply._aiInt = null; }
        if (!data.success) { throw new Error(data.error || 'Failed'); }
        if (reply) {
          reply.innerHTML = data.html;
          if (status) { status.style.display = 'inline-flex'; }
          if (meta) { meta.textContent = 'Generated for <%= activeQuarter %> <%= selectedYear %> • ' + new Date().toLocaleString('en-PH'); }
          // ensure status visible
          if (status) status.style.display = 'inline-flex';
        }
      } catch (e) {
        if (reply && reply._aiInt) { clearInterval(reply._aiInt); reply._aiInt = null; }
        if (reply) {
          reply.innerHTML = '<div style="text-align:center;padding:1rem;border:1px dashed #fecaca;background:#fef2f2;border-radius:8px;"><div style="color:#dc2626;font-weight:800;">Failed to generate</div><div style="font-size:0.78rem;color:#64748b;margin-top:0.3rem;">' + (e.message || 'Unknown error').replace(/</g, '&lt;') + '</div><button onclick="generateAISuggestions()" style="margin-top:0.6rem;background:#dc2626;color:#fff;border:none;padding:0.45rem 0.8rem;border-radius:7px;font-weight:700;cursor:pointer;">Retry</button></div>';
        }
        console.error(e);
      } finally {
        if (btn) { btn.disabled = false; btn.style.opacity = '1'; btn.innerHTML = prevHtml || '<span>&#10022;</span> Generate'; }
      }
    }
    function clearAISuggestions() {
      const input = document.getElementById('aiSuggestInput');
      const reply = document.getElementById('aiSuggestReply');
      const status = document.getElementById('aiSuggestStatus');
      const cnt = document.getElementById('aiSuggestCount');
      if (input) { input.value = ''; if (cnt) cnt.textContent = '0'; input.style.borderColor = '#86efac'; }
      if (reply) {
        reply.innerHTML = '<div id="aiSuggestPlaceholder" style="color:#94a3b8; text-align:center; padding:2rem 1rem;"><div style="width:48px; height:48px; border-radius:50%; background:#f0fdf4; border:1px solid #dcfce7; display:flex; align-items:center; justify-content:center; margin:0 auto 0.7rem auto; color:#16a34a; font-size:1.1rem;">&#128172;</div><div style="font-weight:600; color:#475569;">No suggestions yet</div><div style="font-size:0.76rem; margin-top:0.2rem;">Your AI-powered suggestions will appear here after you generate.</div></div><div id="aiSuggestMeta" style="margin-top:0.6rem; font-size:0.68rem; color:#64748b;"></div>';
      }
      if (status) status.style.display = 'none';
    }
    async function copyAISuggestions() {
      const reply = document.getElementById('aiSuggestReply');
      if (!reply) return;
      const text = (reply.innerText || '').trim();
      if (!text) { alert('Nothing to copy'); return; }
      try {
        if (navigator.clipboard) await navigator.clipboard.writeText(text);
        else { const ta = document.createElement('textarea'); ta.value = text; document.body.appendChild(ta); ta.select(); document.execCommand('copy'); ta.remove(); }
        const btn = document.querySelector('button[onclick="copyAISuggestions()"]');
        if (btn) { const orig = btn.innerHTML; btn.innerHTML = '<span>&#10003;</span> Copied'; setTimeout(function () { btn.innerHTML = orig; }, 1500); }
      } catch (e) { alert('Copy failed'); }
    }

    function downloadAISuggestions() {
      const reply = document.getElementById('aiSuggestReply');
      if (!reply) return;
      const text = (reply.innerText || '').trim();
      if (!text) { alert('Nothing to download'); return; }
      const blob = new Blob([text], { type: 'text/plain;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a'); a.href = url; a.download = 'PSAU_AI_Suggestions_<%= activeQuarter %>_<%= selectedYear %>.txt'; document.body.appendChild(a); a.click(); setTimeout(function () { URL.revokeObjectURL(url); a.remove(); }, 500);
    }
    function rateAISuggestions(dir) {
      const msg = dir === 'up' ? 'Thanks for your feedback!' : 'Thanks — we will improve.';
      let toast = document.getElementById('aiRateToast');
      if (!toast) {
        toast = document.createElement('div');
        toast.id = 'aiRateToast';
        toast.style.cssText = 'position:fixed;bottom:1.2rem;left:50%;transform:translateX(-50%);background:#0f172a;color:#fff;padding:0.5rem 0.9rem;border-radius:8px;font-size:0.78rem;font-weight:600;z-index:4000;box-shadow:0 8px 20px rgba(15,23,42,0.2);';
        document.body.appendChild(toast);
      }
      toast.textContent = msg;
      toast.style.display = 'block';
      setTimeout(function () { toast.style.display = 'none'; }, 1800);
    }
  </script>

  <%- include('partials/footer') %>