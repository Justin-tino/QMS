<%- include('partials/header', { pageTitle: 'Automated Quarterly Reports - PSAU QMS' }) %>
  <script>
    (function () { try { var t = localStorage.getItem('psau_theme'); if (t === 'dark' || t === 'light') document.documentElement.setAttribute('data-theme', t); } catch (e) { } })();
  </script>
  <script src="/js/admin-ui.js"></script>

  <style>
    @keyframes spin {
      0% {
        transform: rotate(0deg)
      }

      100% {
        transform: rotate(360deg)
      }
    }

    .spinner {
      display: inline-block;
      width: 1.9rem;
      height: 1.9rem;
      border: 3px solid rgba(27, 94, 32, .12);
      border-top-color: #1b5e20;
      border-radius: 50%;
      animation: spin .75s linear infinite
    }

    .psau-timer {
      position: relative;
      width: 44px;
      height: 44px;
      border: 3px solid #e2e8f0;
      border-radius: 50%;
      background: #fff;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 2px 10px rgba(15, 23, 42, 0.08);
      flex-shrink: 0
    }

    .psau-timer::before {
      content: '';
      position: absolute;
      top: -5px;
      left: 50%;
      transform: translateX(-50%);
      width: 10px;
      height: 5px;
      background: #94a3b8;
      border-radius: 2px 2px 0 0;
      border: 1px solid #cbd5e1
    }

    .psau-timer-hand {
      position: absolute;
      width: 2.5px;
      height: 15px;
      background: #1b5e20;
      border-radius: 2px;
      top: 50%;
      left: 50%;
      transform-origin: 50% 100%;
      transform: translate(-50%, -100%) rotate(0deg);
      animation: psauTimerTick 1s linear infinite
    }

    .psau-timer-center {
      width: 6px;
      height: 6px;
      background: #1b5e20;
      border-radius: 50%;
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      z-index: 1;
      box-shadow: 0 0 0 2px #fff
    }

    .psau-timer-text {
      position: absolute;
      bottom: -18px;
      left: 50%;
      transform: translateX(-50%);
      font-size: 0.62rem;
      font-weight: 700;
      color: #64748b;
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      padding: 1px 6px;
      border-radius: 10px;
      white-space: nowrap;
      letter-spacing: 0.2px;
      font-variant-numeric: tabular-nums
    }

    @keyframes psauTimerTick {
      from {
        transform: translate(-50%, -100%) rotate(0deg)
      }

      to {
        transform: translate(-50%, -100%) rotate(360deg)
      }
    }

    .psau-timer.small {
      width: 18px;
      height: 18px;
      border-width: 2px;
      box-shadow: none
    }

    .psau-timer.small::before {
      width: 6px;
      height: 3px;
      top: -3px
    }

    .psau-timer.small .psau-timer-hand {
      height: 7px;
      width: 2px
    }

    .psau-timer.small .psau-timer-center {
      width: 3px;
      height: 3px
    }

    .psau-timer.small .psau-timer-text {
      display: none
    }

    .psau-global-timer {
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 42, 0.48);
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 4000;
      flex-direction: column;
      gap: 0.9rem;
      padding: 1rem
    }

    .psau-global-timer.open {
      display: flex
    }

    .psau-global-timer-card {
      background: #fff;
      border: 1px solid #e2e8f0;
      border-radius: 16px;
      padding: 1.4rem 1.6rem;
      min-width: 280px;
      max-width: 360px;
      text-align: center;
      box-shadow: 0 20px 40px -12px rgba(15, 23, 42, 0.28);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.7rem
    }

    .psau-global-timer-title {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: 0.92rem;
      font-weight: 800;
      color: #0f172a
    }

    .psau-global-timer-sub {
      font-size: 0.76rem;
      font-weight: 500;
      color: #64748b;
      text-align: center;
      line-height: 1.4
    }

    .psau-dialog-overlay {
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 42, 0.55);
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 3000;
      padding: 1rem
    }

    .psau-dialog-overlay.open {
      display: flex
    }

    .psau-dialog-card {
      background: #fff;
      border: 1px solid #e2e8f0;
      border-radius: 16px;
      padding: 1.5rem;
      min-width: 320px;
      max-width: 400px;
      width: 100%;
      text-align: center;
      box-shadow: 0 20px 40px -12px rgba(15, 23, 42, 0.28)
    }

    .psau-dialog-icon {
      width: 52px;
      height: 52px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 0.9rem auto;
      font-size: 1.35rem
    }

    .psau-dialog-icon.variant-warning {
      background: #fffbeb;
      color: #d97706;
      border: 1px solid #fde68a
    }

    .psau-dialog-title {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: 1.02rem;
      font-weight: 800;
      color: #0f172a;
      margin: 0 0 0.4rem 0
    }

    .psau-dialog-message {
      font-size: 0.84rem;
      color: #475569;
      line-height: 1.5;
      margin: 0 0 1.2rem 0
    }

    .psau-dialog-actions {
      display: flex;
      gap: 0.6rem;
      justify-content: center
    }

    .psau-btn-primary,
    .psau-btn-secondary {
      padding: 0.55rem 1.1rem;
      border-radius: 9px;
      font-size: 0.82rem;
      font-weight: 700;
      cursor: pointer;
      border: 1px solid transparent;
      min-width: 90px
    }

    .psau-btn-primary {
      background: #0f172a;
      color: #fff;
      border-color: #0f172a
    }

    .psau-btn-primary:hover {
      background: #1e293b
    }

    .psau-btn-secondary {
      background: #f1f5f9;
      color: #475569;
      border-color: #e2e8f0
    }

    .psau-btn-secondary:hover {
      background: #e2e8f0
    }

    .q-pill {
      padding: 0.38rem 0.9rem;
      border-radius: 20px;
      font-size: 0.78rem;
      font-weight: 700;
      text-decoration: none;
      border: 1px solid #e2e8f0;
      transition: all .15s;
      display: inline-flex;
      align-items: center;
      gap: 0.3rem
    }

    .q-pill.active {
      background: #1b5e20;
      color: #fff;
      border-color: #1b5e20
    }

    .q-pill:not(.active) {
      background: #fff;
      color: #475569
    }

    .q-pill:not(.active):hover {
      border-color: #1b5e20;
      color: #1b5e20
    }

    .q-kpi {
      display: flex;
      align-items: center;
      gap: 0.85rem;
      border-radius: 12px;
      padding: 1rem 1.1rem;
      border: 1px solid #e2e8f0;
      background: rgba(255, 255, 255, .74);
      backdrop-filter: blur(12px)
    }

    .q-kpi .qk-icon {
      width: 44px;
      height: 44px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.05rem;
      flex-shrink: 0
    }

    .q-kpi .qk-value {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: 1.45rem;
      font-weight: 800;
      color: #0f172a;
      line-height: 1.05
    }

    .q-kpi .qk-label {
      font-size: 0.64rem;
      font-weight: 700;
      color: #64748b;
      text-transform: uppercase;
      letter-spacing: 0.45px
    }

    @media print {

      .sidebar,
      .mobile-tabs,
      .q-filter,
      .q-no-print {
        display: none !important
      }

      body {
        background: #fff !important
      }

      .admin-main {
        padding: 0 !important
      }

      .glass {
        box-shadow: none !important;
        break-inside: avoid
      }
    }

    /* ===== FIX: date popover was masked behind next glass card (z-index + overflow) ===== */
    .admin-main { overflow: visible !important; position: relative; }
    .dash-header { position: relative !important; z-index: 40 !important; overflow: visible !important; }
    .dash-header-right { position: relative !important; z-index: 50 !important; overflow: visible !important; }
    #quarterDatePopover { z-index: 1000 !important; }
    #quarterDatePickerInput, #dashDatePickerInput { box-sizing: border-box !important; }
    .admin-shell { overflow: visible; }
    .glass { position: relative; z-index: 1; }
    @media (max-width: 560px) {
      #quarterDatePopover {
        right: -0.5rem !important;
        left: auto !important;
        min-width: 260px !important;
        max-width: calc(100vw - 1.5rem) !important;
      }
    }
    @media (max-width: 380px) {
      #quarterDatePopover {
        right: 0 !important;
        left: 50% !important;
        transform: translateX(-50%) !important;
        width: calc(100vw - 1rem) !important;
        min-width: 0 !important;
      }
    }
  </style>

  <div class="admin-shell">
    <aside class="sidebar fade-up">
      <div class="side-brand">
        <img src="/images/logo.png" alt="PSAU Logo">
        <div>
          <div class="sb-name">PSAU - QMS</div>
        </div>
      </div>
      <nav class="side-nav">
        <a href="/admin/dashboard" onclick="sessionStorage.setItem('psauTab','dashboard')" class="side-link"><i
            class="fas fa-grip"></i> <span data-i18n="nav.dashboard">Dashboard</span></a>
        <a href="/admin/dashboard" onclick="sessionStorage.setItem('psauTab','feedback')" class="side-link"><i
            class="fas fa-comment-dots"></i> <span data-i18n="nav.feedback">Feedback</span></a>
        <a href="/admin/dashboard" onclick="sessionStorage.setItem('psauTab','qr')" class="side-link"><i
            class="fas fa-qrcode"></i> <span data-i18n="nav.qr">QR Codes</span></a>
        <a href="/admin/quarterly-reports" class="side-link active"><i class="fas fa-wand-magic-sparkles"></i> <span>AI
            Assistant</span></a>
        <% if (typeof userRole !=='undefined' && userRole==='admin' ) { %>
          <a href="/admin/dashboard" onclick="sessionStorage.setItem('psauTab','users')" class="side-link"><i
              class="fas fa-user"></i> <span data-i18n="nav.users">Users</span></a>
          <a href="/admin/dashboard" onclick="sessionStorage.setItem('psauTab','settings')" class="side-link"><i
              class="fas fa-gear"></i> <span data-i18n="nav.settings">Settings</span></a>
          <% } %>
      </nav>
      <div class="side-bottom">
        <div class="side-user-card">
          <div class="su-avatar"><i class="fas fa-user"></i></div>
          <div class="su-info">
            <div class="su-name">
              <%= typeof adminUser !=='undefined' && adminUser ? adminUser : (typeof userRole !=='undefined' &&
                userRole==='staff' ? 'Staff User' : 'Admin User' ) %>
            </div>
            <div class="su-mail">
              <%= typeof userRole !=='undefined' && userRole==='staff' ? 'Staff' : 'Administrator' %>
            </div>
          </div>
        </div>
        <button type="button" class="side-theme-card" onclick="PSAU_UI.toggleTheme()" title="Toggle dark / light mode">
          <span class="st-left"><i class="fas fa-sun" data-theme-icon></i> <span data-theme-label>Light
              Mode</span></span>
        </button>
        <a href="/admin/logout" onclick="return confirmLogoutQ(event)" class="side-logout-red"><i
            class="fas fa-arrow-right-from-bracket"></i> <span>Log Out</span></a>
      </div>
    </aside>

    <main class="admin-main">
      <div class="dash-header fade-up" style="margin-bottom:1rem;">
        <div class="dash-header-left">
          <h1 style="display:flex; align-items:center; gap:0.6rem;"><span data-i18n="q.title">Automated Quarterly
              Customer Feedback Report</span></h1>
        </div>
        <div class="dash-header-right" style="display:flex; gap:0.5rem; align-items:center; position:relative; z-index:50; overflow:visible;">
          <select id="quarterOfficeFilter" onchange="applyQuarterOfficeFilter(this.value)"
            style="cursor:pointer; border:1px solid #e2e8f0; background:#fff; border-radius:20px; padding:0.35rem 0.75rem; font-size:0.78rem; font-weight:600; color:#334155;">
            <option value="all" <%=typeof selectedOffice !=='undefined' && selectedOffice==='all' ? 'selected' : '' %>
              >All Offices / Departments</option>
            <% if (typeof availableOffices !=='undefined' && availableOffices.length) { %>
              <% availableOffices.forEach(function(off) { %>
                <option value="<%= off %>" <%=typeof selectedOffice !=='undefined' && selectedOffice===off ? 'selected'
                  : '' %>><%= off %>
                </option>
                <% }); %>
                  <% } %>
          </select>
          <div id="quarterDateBadge" class="dash-date-badge" title="Date follows Dashboard" style="display:none; cursor:default; border:1px solid #e2e8f0; background:#f8fafc; border-radius:20px; padding:0.35rem 0.7rem; font-size:0.78rem; font-weight:600; align-items:center; gap:0.35rem; color:#334155;">
            <i class="fas fa-calendar" style="color:#1b5e20;"></i> <span id="quarterDateBadgeText"><%= (function(){ try{ if(typeof selectedQuarterDate!=='undefined'&&selectedQuarterDate){ var d=new Date(selectedQuarterDate); if(!isNaN(d.getTime())) return d.toLocaleDateString('en-PH',{year:'numeric',month:'long',day:'numeric'}); } return new Date().toLocaleDateString('en-PH',{year:'numeric',month:'long',day:'numeric'}); }catch(e){ return new Date().toLocaleDateString('en-PH',{year:'numeric',month:'long',day:'numeric'}); } })() %></span>
          </div>
          <span id="quarterDateMirrorHint" style="display:none; font-size:0.68rem; color:#64748b; font-weight:600; align-items:center; gap:0.3rem; white-space:nowrap;">
            <i class="fas fa-link" style="font-size:0.62rem;"></i> Mirrored from Dashboard <a href="/admin/dashboard" style="color:#1b5e20; text-decoration:underline; margin-left:0.25rem;">Change</a>
          </span>
          <div id="quarterDatePopover"
            style="display:none; position:absolute; top:calc(100% + 0.5rem); right:0; background:#fff; border:1px solid #e2e8f0; border-radius:12px; padding:0.9rem; box-shadow:0 12px 24px rgba(15,23,42,0.18); z-index:1000; min-width:268px; max-width:min(92vw,320px);">
            <label for="quarterDatePickerInput"
              style="font-size:0.7rem; font-weight:700; color:#334155; text-transform:uppercase; letter-spacing:0.4px; display:block; margin-bottom:0.35rem;">Jump
              to specific day / year</label>
            <input type="date" id="quarterDatePickerInput"
              style="width:100%; padding:0.5rem; border:1px solid #cbd5e1; border-radius:8px; font-size:0.85rem;">
            <div style="display:flex; gap:0.4rem; margin-top:0.6rem;">
              <button type="button" onclick="shiftQuarterDate(-1)"
                style="flex:1; padding:0.4rem; border:1px solid #e2e8f0; background:#f8fafc; border-radius:7px; font-size:0.7rem; font-weight:600; cursor:pointer;">←
                Prev day</button>
              <button type="button" onclick="shiftQuarterDate(1)"
                style="flex:1; padding:0.4rem; border:1px solid #e2e8f0; background:#f8fafc; border-radius:7px; font-size:0.7rem; font-weight:600; cursor:pointer;">Next
                day →</button>
            </div>
            <div style="display:flex; gap:0.4rem; margin-top:0.4rem;">
              <button type="button" onclick="applyQuarterDate()"
                style="flex:1; background:#1b5e20; color:#fff; border:none; padding:0.5rem; border-radius:7px; font-weight:700; font-size:0.78rem; cursor:pointer;">Apply
                to quarterly</button>
              <button type="button" onclick="clearQuarterDate()"
                style="padding:0.5rem 0.7rem; background:#fff; border:1px solid #e2e8f0; border-radius:7px; font-size:0.78rem; cursor:pointer;">Clear</button>
            </div>
            <div style="font-size:0.65rem; color:#94a3b8; margin-top:0.5rem; text-align:center;">Admin & employee —
              jumps to year/quarter of chosen date</div>
          </div>
          <!-- Report-specific date (AI Assistant only, does not affect Dashboard filter) -->
          <div style="display:flex; align-items:center; gap:0.35rem; background:#fff; border:1px solid #e2e8f0; border-radius:20px; padding:0.22rem 0.55rem 0.22rem 0.7rem;">
            <label for="aiReportDate" style="font-size:0.68rem; font-weight:700; color:#475569; white-space:nowrap; cursor:pointer;"><i class="fas fa-calendar" style="color:#1b5e20; margin-right:0.2rem;"></i>Report date:</label>
            <input type="date" id="aiReportDate" style="border:none; background:transparent; font-size:0.78rem; font-weight:600; color:#0f172a; outline:none; padding:0.15rem 0; cursor:pointer;">
          </div>
          <a id="btnGenerateReport" href="/admin/report?filterType=range&office=<%= typeof selectedOffice !== 'undefined' ? encodeURIComponent(selectedOffice) : 'all' %>&dateFrom=<%= activeQuarter==='Q1' ? selectedYear+'-01-01' : activeQuarter==='Q2' ? selectedYear+'-04-01' : activeQuarter==='Q3' ? selectedYear+'-07-01' : selectedYear+'-10-01' %>&dateTo=<%= activeQuarter==='Q1' ? selectedYear+'-03-31' : activeQuarter==='Q2' ? selectedYear+'-06-30' : activeQuarter==='Q3' ? selectedYear+'-09-30' : selectedYear+'-12-31' %>"
            target="_blank" class="btn-submit"
            style="padding:0.5rem 0.9rem; font-size:0.78rem; border-radius:8px; background:#0f172a; color:#fff; text-decoration:none; display:inline-flex; align-items:center; gap:0.35rem; white-space:nowrap;"><i
              class="fas fa-file-lines"></i> Generate Report</a>
        </div>
      </div>

      <!-- 2. AI Suggestions Section — Matches Reference UI focused on SQD & Feedback Analysis -->
      <div class="glass fade-up d2"
        style="margin-bottom:1.5rem; background:#ffffff; border-radius:20px; border:1px solid #e2e8f0; padding:1.5rem 1.75rem; box-shadow:0 10px 30px rgba(15,23,42,0.04);">


        <!-- Dual Column Grid -->
        <div style="display:grid; grid-template-columns:1fr 1.35fr; gap:1.5rem;" class="ai-suggestions-grid">

          <!-- Left Column: Generator Panel -->
          <div
            style="border:1px solid #e2e8f0; border-radius:16px; background:#ffffff; padding:2rem 1.5rem; display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; min-height:480px; position:relative;">

            <!-- Outer Sparkle Ring Visual -->
            <div
              style="position:relative; width:150px; height:150px; margin-bottom:1.5rem; display:flex; align-items:center; justify-content:center;">
              <!-- Decorative Sparkles -->
              <span style="position:absolute; top:8px; right:20px; color:#4ade80; font-size:1rem;">✦</span>
              <span style="position:absolute; bottom:12px; left:16px; color:#86efac; font-size:0.8rem;">✦</span>
              <span style="position:absolute; top:28px; left:10px; color:#4ade80; font-size:0.75rem;">✦</span>
              <span style="position:absolute; bottom:8px; right:28px; color:#86efac; font-size:0.85rem;">✦</span>

              <!-- Soft Green Outer Aura Ring -->
              <div
                style="width:138px; height:138px; border-radius:50%; background:#f0fdf4; border:1px solid #dcfce7; display:flex; align-items:center; justify-content:center; box-shadow:0 0 25px rgba(34,197,94,0.14);">
                <!-- Inner Light Green Circle -->
                <div
                  style="width:90px; height:90px; border-radius:50%; background:#dcfce7; border:1px solid #bbf7d0; display:flex; align-items:center; justify-content:center; box-shadow:inset 0 2px 6px rgba(22,163,74,0.18);">
                  <!-- Green Magic Wand Icon -->
                  <i class="fas fa-magic"
                    style="font-size:2.2rem; color:#16a34a; transform:rotate(-15deg); filter:drop-shadow(0 3px 6px rgba(22,163,74,0.3));"></i>
                </div>
              </div>
            </div>

            <!-- Main Generate Button -->
            <button type="button" onclick="generateAISuggestions()" id="aiSuggestBtn"
              style="background:linear-gradient(135deg, #16a34a 0%, #15803d 100%); color:#ffffff; border:none; border-radius:9999px; padding:0.9rem 2.8rem; font-weight:700; font-size:1rem; cursor:pointer; display:inline-flex; align-items:center; gap:0.6rem; box-shadow:0 4px 16px rgba(22, 163, 74, 0.3); transition:all 0.2s ease;">
              <i class="fas fa-wand-magic-sparkles"></i> Generate
            </button>
            <div style="font-size:0.82rem; color:#64748b; margin-top:0.75rem;">Click to get AI suggestions</div>

            <!-- Hidden input box for backend query parameter passing (preserves SQD & feedback analysis focus) -->
            <input type="hidden" id="aiSuggestInput"
              value="Provide 5 actionable SQD and feedback analysis suggestions for <%= activeQuarter %> <%= selectedYear %>">
          </div>

          <!-- Right Column: AI Suggestions Output Panel -->
          <div
            style="border:1px solid #e2e8f0; border-radius:16px; background:#ffffff; padding:1.25rem 1.5rem; display:flex; flex-direction:column; justify-content:space-between; min-height:480px;">
            <div>
              <!-- Header Bar -->
              <div
                style="display:flex; align-items:center; margin-bottom:1.1rem; padding-bottom:0.75rem; border-bottom:1px solid #f1f5f9;">
                <div style="display:flex; align-items:center; gap:0.55rem;">
                  <span style="font-weight:700; color:#15803d; font-size:0.98rem;">AI Suggestions</span>
                </div>
              </div>

              <!-- Suggestions Cards List -->
              <div id="aiSuggestReply">
                <!-- Item 1: Encourage Active Participation -->
                <div class="ai-suggestion-card"
                  style="background:#ffffff; border:1px solid #e2e8f0; border-radius:12px; padding:0.85rem 1rem; margin-bottom:0.75rem; display:flex; align-items:flex-start; gap:0.85rem; transition:all 0.2s ease;">
                  <div
                    style="width:40px; height:40px; border-radius:12px; background:#e8f5e9; color:#16a34a; display:flex; align-items:center; justify-content:center; font-size:1.1rem; flex-shrink:0; border:1px solid #c8e6c9;">
                    <i class="fas fa-comment-dots"></i>
                  </div>
                  <div style="flex:1;">
                    <div style="display:flex; align-items:center; gap:0.45rem; margin-bottom:0.2rem;">
                      <span
                        style="width:20px; height:20px; border-radius:50%; background:#16a34a; color:#ffffff; font-weight:700; font-size:0.7rem; display:inline-flex; align-items:center; justify-content:center; flex-shrink:0;">1</span>
                      <span style="font-weight:700; color:#0f172a; font-size:0.88rem;">Encourage Active Feedback
                        Participation</span>
                    </div>
