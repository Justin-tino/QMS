<%- include('partials/header', { pageTitle: 'Automated Quarterly Reports - PSAU QMS' }) %>
  <script>
    (function () { try { var t = localStorage.getItem('psau_theme'); if (t === 'dark' || t === 'light') document.documentElement.setAttribute('data-theme', t); } catch (e) { } })();
  </script>
  <script src="/js/admin-ui.js"></script>

  <style>
    @keyframes spin {
      0% {
        transform: rotate(0deg)
      }

      100% {
        transform: rotate(360deg)
      }
    }

    .spinner {
      display: inline-block;
      width: 1.9rem;
      height: 1.9rem;
      border: 3px solid rgba(27, 94, 32, .12);
      border-top-color: #1b5e20;
      border-radius: 50%;
      animation: spin .75s linear infinite
    }

    .psau-timer {
      position: relative;
      width: 44px;
      height: 44px;
      border: 3px solid #e2e8f0;
      border-radius: 50%;
      background: #fff;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 2px 10px rgba(15, 23, 42, 0.08);
      flex-shrink: 0
    }

    .psau-timer::before {
      content: '';
      position: absolute;
      top: -5px;
      left: 50%;
      transform: translateX(-50%);
      width: 10px;
      height: 5px;
      background: #94a3b8;
      border-radius: 2px 2px 0 0;
      border: 1px solid #cbd5e1
    }

    .psau-timer-hand {
      position: absolute;
      width: 2.5px;
      height: 15px;
      background: #1b5e20;
      border-radius: 2px;
      top: 50%;
      left: 50%;
      transform-origin: 50% 100%;
      transform: translate(-50%, -100%) rotate(0deg);
      animation: psauTimerTick 1s linear infinite
    }

    .psau-timer-center {
      width: 6px;
      height: 6px;
      background: #1b5e20;
      border-radius: 50%;
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      z-index: 1;
      box-shadow: 0 0 0 2px #fff
    }

    .psau-timer-text {
      position: absolute;
      bottom: -18px;
      left: 50%;
      transform: translateX(-50%);
      font-size: 0.62rem;
      font-weight: 700;
      color: #64748b;
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      padding: 1px 6px;
      border-radius: 10px;
      white-space: nowrap;
      letter-spacing: 0.2px;
      font-variant-numeric: tabular-nums
    }

    @keyframes psauTimerTick {
      from {
        transform: translate(-50%, -100%) rotate(0deg)
      }

      to {
        transform: translate(-50%, -100%) rotate(360deg)
      }
    }

    .psau-timer.small {
      width: 18px;
      height: 18px;
      border-width: 2px;
      box-shadow: none
    }

    .psau-timer.small::before {
      width: 6px;
      height: 3px;
      top: -3px
    }

    .psau-timer.small .psau-timer-hand {
      height: 7px;
      width: 2px
    }

    .psau-timer.small .psau-timer-center {
      width: 3px;
      height: 3px
    }

    .psau-timer.small .psau-timer-text {
      display: none
    }

    .psau-global-timer {
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 42, 0.48);
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 4000;
      flex-direction: column;
      gap: 0.9rem;
      padding: 1rem
    }

    .psau-global-timer.open {
      display: flex
    }

    .psau-global-timer-card {
      background: #fff;
      border: 1px solid #e2e8f0;
      border-radius: 16px;
      padding: 1.4rem 1.6rem;
      min-width: 280px;
      max-width: 360px;
      text-align: center;
      box-shadow: 0 20px 40px -12px rgba(15, 23, 42, 0.28);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.7rem
    }

    .psau-global-timer-title {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: 0.92rem;
      font-weight: 800;
      color: #0f172a
    }

    .psau-global-timer-sub {
      font-size: 0.76rem;
      font-weight: 500;
      color: #64748b;
      text-align: center;
      line-height: 1.4
    }

    .psau-dialog-overlay {
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 42, 0.55);
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 3000;
      padding: 1rem
    }

    .psau-dialog-overlay.open {
      display: flex
    }

    .psau-dialog-card {
      background: #fff;
      border: 1px solid #e2e8f0;
      border-radius: 16px;
      padding: 1.5rem;
      min-width: 320px;
      max-width: 400px;
      width: 100%;
      text-align: center;
      box-shadow: 0 20px 40px -12px rgba(15, 23, 42, 0.28)
    }

    .psau-dialog-icon {
      width: 52px;
      height: 52px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 0.9rem auto;
      font-size: 1.35rem
    }

    .psau-dialog-icon.variant-warning {
      background: #fffbeb;
      color: #d97706;
      border: 1px solid #fde68a
    }

    .psau-dialog-title {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: 1.02rem;
      font-weight: 800;
      color: #0f172a;
      margin: 0 0 0.4rem 0
    }

    .psau-dialog-message {
      font-size: 0.84rem;
      color: #475569;
      line-height: 1.5;
      margin: 0 0 1.2rem 0
    }

    .psau-dialog-actions {
      display: flex;
      gap: 0.6rem;
      justify-content: center
    }

    .psau-btn-primary,
    .psau-btn-secondary {
      padding: 0.55rem 1.1rem;
      border-radius: 9px;
      font-size: 0.82rem;
      font-weight: 700;
      cursor: pointer;
      border: 1px solid transparent;
      min-width: 90px
    }

    .psau-btn-primary {
      background: #0f172a;
      color: #fff;
      border-color: #0f172a
    }

    .psau-btn-primary:hover {
      background: #1e293b
    }

    .psau-btn-secondary {
      background: #f1f5f9;
      color: #475569;
      border-color: #e2e8f0
    }

    .psau-btn-secondary:hover {
      background: #e2e8f0
    }

    .q-pill {
      padding: 0.38rem 0.9rem;
      border-radius: 20px;
      font-size: 0.78rem;
      font-weight: 700;
      text-decoration: none;
      border: 1px solid #e2e8f0;
      transition: all .15s;
      display: inline-flex;
      align-items: center;
      gap: 0.3rem
    }

    .q-pill.active {
      background: #1b5e20;
      color: #fff;
      border-color: #1b5e20
    }

    .q-pill:not(.active) {
      background: #fff;
      color: #475569
    }

    .q-pill:not(.active):hover {
      border-color: #1b5e20;
      color: #1b5e20
    }

    .q-kpi {
      display: flex;
      align-items: center;
      gap: 0.85rem;
      border-radius: 12px;
      padding: 1rem 1.1rem;
      border: 1px solid #e2e8f0;
      background: rgba(255, 255, 255, .74);
      backdrop-filter: blur(12px)
    }

    .q-kpi .qk-icon {
      width: 44px;
      height: 44px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.05rem;
      flex-shrink: 0
    }

    .q-kpi .qk-value {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: 1.45rem;
      font-weight: 800;
      color: #0f172a;
      line-height: 1.05
    }

    .q-kpi .qk-label {
      font-size: 0.64rem;
      font-weight: 700;
      color: #64748b;
      text-transform: uppercase;
      letter-spacing: 0.45px
    }

    @media print {

      .sidebar,
      .mobile-tabs,
      .q-filter,
      .q-no-print {
        display: none !important
      }

      body {
        background: #fff !important
      }

      .admin-main {
        padding: 0 !important
      }

      .glass {
        box-shadow: none !important;
        break-inside: avoid
      }
    }

    /* ===== FIX: date popover was masked behind next glass card (z-index + overflow) ===== */
    .admin-main { overflow: visible !important; position: relative; }
    .dash-header { position: relative !important; z-index: 40 !important; overflow: visible !important; }
    .dash-header-right { position: relative !important; z-index: 50 !important; overflow: visible !important; }
    #quarterDatePopover { z-index: 1000 !important; }
    #quarterDatePickerInput, #dashDatePickerInput { box-sizing: border-box !important; }
    .admin-shell { overflow: visible; }
    .glass { position: relative; z-index: 1; }
    @media (max-width: 560px) {
      #quarterDatePopover {
        right: -0.5rem !important;
        left: auto !important;
        min-width: 260px !important;
        max-width: calc(100vw - 1.5rem) !important;
      }
    }
    @media (max-width: 380px) {
      #quarterDatePopover {
        right: 0 !important;
        left: 50% !important;
        transform: translateX(-50%) !important;
        width: calc(100vw - 1rem) !important;
        min-width: 0 !important;
      }
    }
  </style>

  <div class="admin-shell">
    <aside class="sidebar fade-up">
      <div class="side-brand">
        <img src="/images/logo.png" alt="PSAU Logo">
        <div>
          <div class="sb-name">PSAU - QMS</div>
        </div>
      </div>
      <nav class="side-nav">
        <a href="/admin/dashboard" onclick="sessionStorage.setItem('psauTab','dashboard')" class="side-link"><i
            class="fas fa-grip"></i> <span data-i18n="nav.dashboard">Dashboard</span></a>
        <a href="/admin/dashboard" onclick="sessionStorage.setItem('psauTab','feedback')" class="side-link"><i
            class="fas fa-comment-dots"></i> <span data-i18n="nav.feedback">Feedback</span></a>
        <a href="/admin/dashboard" onclick="sessionStorage.setItem('psauTab','qr')" class="side-link"><i
            class="fas fa-qrcode"></i> <span data-i18n="nav.qr">QR Codes</span></a>
        <a href="/admin/quarterly-reports" class="side-link active"><i class="fas fa-wand-magic-sparkles"></i> <span>AI
            Assistant</span></a>
        <% if (typeof userRole !=='undefined' && userRole==='admin' ) { %>
          <a href="/admin/dashboard" onclick="sessionStorage.setItem('psauTab','users')" class="side-link"><i
              class="fas fa-user"></i> <span data-i18n="nav.users">Users</span></a>
          <a href="/admin/dashboard" onclick="sessionStorage.setItem('psauTab','settings')" class="side-link"><i
              class="fas fa-gear"></i> <span data-i18n="nav.settings">Settings</span></a>
          <% } %>
      </nav>
      <div class="side-bottom">
        <div class="side-user-card">
          <div class="su-avatar"><i class="fas fa-user"></i></div>
          <div class="su-info">
            <div class="su-name">
              <%= typeof adminUser !=='undefined' && adminUser ? adminUser : (typeof userRole !=='undefined' &&
                userRole==='staff' ? 'Staff User' : 'Admin User' ) %>
            </div>
            <div class="su-mail">
              <%= typeof userRole !=='undefined' && userRole==='staff' ? 'Staff' : 'Administrator' %>
            </div>
          </div>
        </div>
        <button type="button" class="side-theme-card" onclick="PSAU_UI.toggleTheme()" title="Toggle dark / light mode">
          <span class="st-left"><i class="fas fa-sun" data-theme-icon></i> <span data-theme-label>Light
              Mode</span></span>
        </button>
        <a href="/admin/logout" onclick="return confirmLogoutQ(event)" class="side-logout-red"><i
            class="fas fa-arrow-right-from-bracket"></i> <span>Log Out</span></a>
      </div>
    </aside>

    <main class="admin-main">
      <div class="dash-header fade-up" style="margin-bottom:1rem;">
        <div class="dash-header-left">
          <h1 style="display:flex; align-items:center; gap:0.6rem;"><span data-i18n="q.title">Automated Quarterly
              Customer Feedback Report</span></h1>
        </div>
        <div class="dash-header-right" style="display:flex; gap:0.5rem; align-items:center; position:relative; z-index:50; overflow:visible;">
          <select id="quarterOfficeFilter" onchange="applyQuarterOfficeFilter(this.value)"
            style="cursor:pointer; border:1px solid #e2e8f0; background:#fff; border-radius:20px; padding:0.35rem 0.75rem; font-size:0.78rem; font-weight:600; color:#334155;">
            <option value="all" <%=typeof selectedOffice !=='undefined' && selectedOffice==='all' ? 'selected' : '' %>
              >All Offices / Departments</option>
            <% if (typeof availableOffices !=='undefined' && availableOffices.length) { %>
              <% availableOffices.forEach(function(off) { %>
                <option value="<%= off %>" <%=typeof selectedOffice !=='undefined' && selectedOffice===off ? 'selected'
                  : '' %>><%= off %>
                </option>
                <% }); %>
                  <% } %>
          </select>
          <div id="quarterDateBadge" class="dash-date-badge" title="Date follows Dashboard" style="display:none; cursor:default; border:1px solid #e2e8f0; background:#f8fafc; border-radius:20px; padding:0.35rem 0.7rem; font-size:0.78rem; font-weight:600; align-items:center; gap:0.35rem; color:#334155;">
            <i class="fas fa-calendar" style="color:#1b5e20;"></i> <span id="quarterDateBadgeText"><%= (function(){ try{ if(typeof selectedQuarterDate!=='undefined'&&selectedQuarterDate){ var d=new Date(selectedQuarterDate); if(!isNaN(d.getTime())) return d.toLocaleDateString('en-PH',{year:'numeric',month:'long',day:'numeric'}); } return new Date().toLocaleDateString('en-PH',{year:'numeric',month:'long',day:'numeric'}); }catch(e){ return new Date().toLocaleDateString('en-PH',{year:'numeric',month:'long',day:'numeric'}); } })() %></span>
          </div>
          <span id="quarterDateMirrorHint" style="display:none; font-size:0.68rem; color:#64748b; font-weight:600; align-items:center; gap:0.3rem; white-space:nowrap;">
            <i class="fas fa-link" style="font-size:0.62rem;"></i> Mirrored from Dashboard <a href="/admin/dashboard" style="color:#1b5e20; text-decoration:underline; margin-left:0.25rem;">Change</a>
          </span>
          <div id="quarterDatePopover"
            style="display:none; position:absolute; top:calc(100% + 0.5rem); right:0; background:#fff; border:1px solid #e2e8f0; border-radius:12px; padding:0.9rem; box-shadow:0 12px 24px rgba(15,23,42,0.18); z-index:1000; min-width:268px; max-width:min(92vw,320px);">
            <label for="quarterDatePickerInput"
              style="font-size:0.7rem; font-weight:700; color:#334155; text-transform:uppercase; letter-spacing:0.4px; display:block; margin-bottom:0.35rem;">Jump
              to specific day / year</label>
            <input type="date" id="quarterDatePickerInput"
              style="width:100%; padding:0.5rem; border:1px solid #cbd5e1; border-radius:8px; font-size:0.85rem;">
            <div style="display:flex; gap:0.4rem; margin-top:0.6rem;">
              <button type="button" onclick="shiftQuarterDate(-1)"
                style="flex:1; padding:0.4rem; border:1px solid #e2e8f0; background:#f8fafc; border-radius:7px; font-size:0.7rem; font-weight:600; cursor:pointer;">←
                Prev day</button>
              <button type="button" onclick="shiftQuarterDate(1)"
                style="flex:1; padding:0.4rem; border:1px solid #e2e8f0; background:#f8fafc; border-radius:7px; font-size:0.7rem; font-weight:600; cursor:pointer;">Next
                day →</button>
            </div>
            <div style="display:flex; gap:0.4rem; margin-top:0.4rem;">
              <button type="button" onclick="applyQuarterDate()"
                style="flex:1; background:#1b5e20; color:#fff; border:none; padding:0.5rem; border-radius:7px; font-weight:700; font-size:0.78rem; cursor:pointer;">Apply
                to quarterly</button>
              <button type="button" onclick="clearQuarterDate()"
                style="padding:0.5rem 0.7rem; background:#fff; border:1px solid #e2e8f0; border-radius:7px; font-size:0.78rem; cursor:pointer;">Clear</button>
            </div>
            <div style="font-size:0.65rem; color:#94a3b8; margin-top:0.5rem; text-align:center;">Admin & employee —
              jumps to year/quarter of chosen date</div>
          </div>
          <!-- Report-specific date (AI Assistant only, does not affect Dashboard filter) -->
          <div style="display:flex; align-items:center; gap:0.35rem; background:#fff; border:1px solid #e2e8f0; border-radius:20px; padding:0.22rem 0.55rem 0.22rem 0.7rem;">
            <label for="aiReportDate" style="font-size:0.68rem; font-weight:700; color:#475569; white-space:nowrap; cursor:pointer;"><i class="fas fa-calendar" style="color:#1b5e20; margin-right:0.2rem;"></i>Report date:</label>
            <input type="date" id="aiReportDate" style="border:none; background:transparent; font-size:0.78rem; font-weight:600; color:#0f172a; outline:none; padding:0.15rem 0; cursor:pointer;">
          </div>
          <a id="btnGenerateReport" href="/admin/report?filterType=range&office=<%= typeof selectedOffice !== 'undefined' ? encodeURIComponent(selectedOffice) : 'all' %>&dateFrom=<%= activeQuarter==='Q1' ? selectedYear+'-01-01' : activeQuarter==='Q2' ? selectedYear+'-04-01' : activeQuarter==='Q3' ? selectedYear+'-07-01' : selectedYear+'-10-01' %>&dateTo=<%= activeQuarter==='Q1' ? selectedYear+'-03-31' : activeQuarter==='Q2' ? selectedYear+'-06-30' : activeQuarter==='Q3' ? selectedYear+'-09-30' : selectedYear+'-12-31' %>"
            target="_blank" class="btn-submit"
            style="padding:0.5rem 0.9rem; font-size:0.78rem; border-radius:8px; background:#0f172a; color:#fff; text-decoration:none; display:inline-flex; align-items:center; gap:0.35rem; white-space:nowrap;"><i
              class="fas fa-file-lines"></i> Generate Report</a>
        </div>
      </div>

      <!-- 2. AI Assistant Section — gated behind Generate (rankings + per-office suggestions hidden until generated) -->
      <div class="glass fade-up d2"
        style="margin-bottom:1.5rem; background:#ffffff; border-radius:20px; border:1px solid #e2e8f0; padding:1.5rem 1.75rem; box-shadow:0 10px 30px rgba(15,23,42,0.04);">

        <!-- Top Generate button — reveals rankings + per-office suggestions -->
        <div style="text-align:center; padding:0.5rem 0 1.25rem 0;">
          <button type="button" onclick="generateAssistantResults()" id="aiAssistantGenerateBtn"
            style="background:linear-gradient(135deg, #16a34a 0%, #15803d 100%); color:#ffffff; border:none; border-radius:9999px; padding:0.9rem 2.8rem; font-weight:700; font-size:1rem; cursor:pointer; display:inline-flex; align-items:center; gap:0.6rem; box-shadow:0 4px 16px rgba(22, 163, 74, 0.3); transition:all 0.2s ease;">
            <i class="fas fa-wand-magic-sparkles"></i> Generate
          </button>
          <div style="font-size:0.78rem; color:#64748b; text-align:center; margin-top:0.55rem;">Click Generate to reveal office performance rankings with suggestions for the selected scope.</div>
        </div>

        <!-- Results Grid (hidden until Generate) -->
        <div id="aiAssistantResults" style="display:none; grid-template-columns:1fr; gap:1.5rem;" class="reports-grid">

          <!-- Left Column: Office Performance Ranking (Low Performing + Top 3) -->
          <div
            style="border:1px solid #e2e8f0; border-radius:16px; background:#ffffff; padding:1.25rem 1.5rem; display:flex; flex-direction:column; min-height:480px; position:relative;">

            <!-- Low Performing Offices header -->
            <div style="display:flex; align-items:center; gap:0.55rem; margin-bottom:1.1rem; padding-bottom:0.75rem; border-bottom:1px solid #f1f5f9;">
              <span style="width:34px; height:34px; border-radius:10px; background:#fef2f2; color:#dc2626; display:inline-flex; align-items:center; justify-content:center; border:1px solid #fecaca; flex-shrink:0;"><i class="fas fa-triangle-exclamation"></i></span>
              <div>
                <div style="font-weight:800; color:#dc2626; font-size:1rem;">Low Performing Offices</div>
                <div style="font-size:0.72rem; color:#64748b;">Ranked by average SQD • <%= activeQuarter %> <%= selectedYear %></div>
              </div>
            </div>

            <div style="flex:1; overflow-y:auto;">
              <% if (typeof officeRankings !== 'undefined' && officeRankings && officeRankings.lowPerformers && officeRankings.lowPerformers.length) { %>
                <% officeRankings.lowPerformers.forEach(function(off, idx) { %>
                  <!-- Low performer office with suggestions below (hidden past 5 until "Show all") -->
                  <div class="low-performer-card" data-extra="<%= idx >= 5 ? '1' : '0' %>"
                    style="border:1px solid #fecaca; background:#fff8f8; border-radius:12px; padding:0.9rem 1rem; margin-bottom:0.85rem;<%= idx >= 5 ? ' display:none;' : '' %>">
                    <div style="display:flex; align-items:flex-start; gap:0.6rem;">
                      <span style="width:26px; height:26px; border-radius:50%; background:#dc2626; color:#fff; font-weight:800; font-size:0.78rem; display:inline-flex; align-items:center; justify-content:center; flex-shrink:0;"><%= idx + 1 %></span>
                      <div style="flex:1;">
                        <div style="font-weight:800; color:#0f172a; font-size:0.95rem;"><%= off.name %></div>
                        <div style="font-size:0.74rem; color:#64748b; margin-top:0.15rem; line-height:1.5;">
                          Average SQD: <strong style="color:#dc2626;"><%= off.avgDisplay %></strong> •
                          <%= off.responses %> response<%= off.responses === 1 ? '' : 's' %><% if (off.weakest) { %> •
                          Weakest: <strong style="color:#b45309;"><%= off.weakest.code %> <%= off.weakest.name %> (<%= off.weakest.avg.toFixed(2) %>)</strong><% } %>
                        </div>
                      </div>
                      <span style="background:#fef2f2; color:#dc2626; border:1px solid #fecaca; border-radius:20px; padding:0.2rem 0.65rem; font-size:0.72rem; font-weight:800; flex-shrink:0;">Needs Improvement</span>
                    </div>
                    <% if (off.suggestions && off.suggestions.length) { %>
                      <div style="margin-top:0.55rem; margin-left:2.3rem; border-left:3px solid #f59e0b; background:#fffbeb; padding:0.55rem 0.75rem; border-radius:4px;">
                        <div style="font-size:0.74rem; font-weight:800; color:#92400e; margin-bottom:0.3rem;"><i class="fas fa-lightbulb" style="margin-right:0.25rem;"></i>Suggestions for this office:</div>
                        <% off.suggestions.forEach(function(sug) { %>
                          <div style="font-size:0.78rem; color:#334155; line-height:1.55; margin-bottom:0.25rem;">• <%= sug %></div>
                        <% }); %>
                      </div>
                    <% } %>
                  </div>
                <% }); %>
                <% if (officeRankings.lowPerformers.length > 5) { %>
                  <div style="text-align:center; margin:0.35rem 0 0.9rem 0;">
                    <button type="button" id="btnShowAllOffices" onclick="toggleLowPerformers(true)"
                      style="background:#0f172a; color:#fff; border:none; padding:0.5rem 1.1rem; border-radius:20px; font-size:0.78rem; font-weight:700; cursor:pointer; display:inline-flex; align-items:center; gap:0.35rem;">
                      <i class="fas fa-chevron-down"></i> Show all (<%= officeRankings.lowPerformers.length - 5 %> more)
                    </button>
                    <button type="button" id="btnViewLessOffices" onclick="toggleLowPerformers(false)"
                      style="display:none; background:#fff; color:#334155; border:1px solid #e2e8f0; padding:0.5rem 1.1rem; border-radius:20px; font-size:0.78rem; font-weight:700; cursor:pointer; align-items:center; gap:0.35rem;">
                      <i class="fas fa-chevron-up"></i> View less
                    </button>
                  </div>
                <% } %>

              <% } else { %>
                <div style="text-align:center; padding:1.5rem 1rem; border:1px dashed #fecaca; border-radius:10px; background:#fff8f8;">
                  <div style="font-weight:700; color:#475569;"><i class="fas fa-comment-dots" style="color:#dc2626; margin-right:0.3rem;"></i>No feedback data yet</div>
                  <div style="font-size:0.78rem; color:#64748b; margin-top:0.35rem;">Once feedback comes in for <%= activeQuarter %> <%= selectedYear %>, the lowest-ranked offices with their suggestions will appear here.</div>
                </div>
              <% } %>
            </div>

            <!-- Top 3 Performing Offices -->
            <div style="display:flex; align-items:center; gap:0.55rem; margin-top:0.6rem; margin-bottom:0.75rem; padding-top:1rem; border-top:1px solid #f1f5f9;">
              <span style="width:34px; height:34px; border-radius:10px; background:#fffbeb; color:#d97706; display:inline-flex; align-items:center; justify-content:center; border:1px solid #fde68a; flex-shrink:0;"><i class="fas fa-trophy"></i></span>
              <div>
                <div style="font-weight:800; color:#b45309; font-size:1rem;">Top 3 Performing Offices</div>
                <div style="font-size:0.72rem; color:#64748b;">Highest average SQD • <%= activeQuarter %> <%= selectedYear %></div>
              </div>
            </div>
            <% if (typeof officeRankings !== 'undefined' && officeRankings && officeRankings.top3 && officeRankings.top3.length) { %>
              <% officeRankings.top3.forEach(function(off, idx) { %>
                <div style="display:flex; align-items:center; gap:0.65rem; border:1px solid #fde68a; background:#fffdf5; border-radius:10px; padding:0.65rem 0.9rem; margin-bottom:0.5rem;">
                  <span style="width:28px; height:28px; border-radius:50%; background:<%= idx === 0 ? '#d97706' : idx === 1 ? '#94a3b8' : '#b45309' %>; color:#fff; font-weight:800; font-size:0.8rem; display:inline-flex; align-items:center; justify-content:center; flex-shrink:0;"><%= idx + 1 %>.</span>
                  <div style="flex:1; font-weight:700; color:#0f172a; font-size:0.9rem;"><%= off.name %></div>
                  <span style="background:#fffbeb; border:1px solid #fde68a; color:#b45309; border-radius:20px; padding:0.2rem 0.65rem; font-size:0.76rem; font-weight:800; flex-shrink:0;">SQD <%= off.avgDisplay %></span>
                </div>
              <% }); %>
            <% } else { %>
              <div style="text-align:center; padding:0.9rem; border:1px dashed #fde68a; border-radius:10px; background:#fffdf5; font-size:0.78rem; color:#64748b;">Not enough data to rank the top offices yet.</div>
            <% } %>

            <!-- Legend — senior friendly reading guide -->
            <div style="margin-top:auto; padding-top:0.9rem; font-size:0.72rem; color:#64748b; line-height:1.55; border-top:1px solid #f1f5f9;">
              <strong style="color:#334155;">How to read this:</strong> SQD scores range from 1.00 (poor) to 5.00 (excellent). Offices averaging below 4.00 are listed as Low Performing — every suggestion is computed from that office's own weakest scores, comments and response volume, so it changes as the data changes.
            </div>
          </div>

        </div>

      </div>

    </main>
  </div>
  <!-- PSAU Global Timer — timer instead of circle for all async -->
  <div id="psauGlobalTimer" class="psau-global-timer" style="display:none;" aria-live="polite" aria-busy="true">
    <div class="psau-global-timer-card">
      <div class="psau-timer" style="width:52px; height:52px; border-width:3px; margin-bottom:0.2rem;">
        <div class="psau-timer-hand" style="height:18px;"></div>
        <div class="psau-timer-center"></div>
      </div>
      <div id="psauGlobalTimerTitle" class="psau-global-timer-title">Loading...</div>
      <div id="psauGlobalTimerSub" class="psau-global-timer-sub">Please wait <span id="psauGlobalTimerElapsed"
          style="font-weight:800; color:#1b5e20;">0.0s</span></div>
    </div>
  </div>

  <div id="psauDialog" class="psau-dialog-overlay" style="display:none;" role="dialog" aria-modal="true"
    aria-labelledby="psauDialogTitle" aria-describedby="psauDialogMessage">
    <div class="psau-dialog-card">
      <div id="psauDialogIcon" class="psau-dialog-icon variant-warning"><i class="fas fa-right-from-bracket"></i></div>
      <h3 id="psauDialogTitle" class="psau-dialog-title">Proceed to logout?</h3>
      <p id="psauDialogMessage" class="psau-dialog-message">You will be signed out and need to sign in again.</p>
      <div class="psau-dialog-actions">
        <button type="button" id="psauDialogCancel" class="psau-btn-secondary">No</button>
        <button type="button" id="psauDialogConfirm" class="psau-btn-primary">Yes</button>
      </div>
    </div>
  </div>
  <script>
    // Logout confirm — uses designed dialog, fallback to native
    function confirmLogoutQ(e) {
      if (e) e.preventDefault();
      var go = function () { window.location.href = '/admin/logout'; };
      var ov = document.getElementById('psauDialog');
      if (ov && document.getElementById('psauDialogConfirm')) {
        // set text securely
        document.getElementById('psauDialogTitle').textContent = 'Proceed to logout?';
        document.getElementById('psauDialogMessage').textContent = 'You will be signed out of your account.';
        document.getElementById('psauDialogCancel').textContent = 'No';
        document.getElementById('psauDialogConfirm').textContent = 'Yes';
        ov.style.display = 'flex'; ov.classList.add('open'); document.body.style.overflow = 'hidden';
        var c = document.getElementById('psauDialogConfirm'), x = document.getElementById('psauDialogCancel');
        var close = function (ok) {
          ov.style.display = 'none'; ov.classList.remove('open'); document.body.style.overflow = '';
          c.onclick = null; x.onclick = null; ov.onclick = null;
          if (ok) go();
        };
        c.onclick = function () { close(true); };
        x.onclick = function () { close(false); };
        ov.onclick = function (ev) { if (ev.target === ov) close(false); };
        return false;
      }
      if (confirm('Proceed to logout?')) go();
      return false;
    }
    // Global timer helper for quarterly (timer instead of spinner)
    let _qGlobalInt = null, _qGlobalStart = 0;
    function showGlobalTimer(t, s) {
      var ov = document.getElementById('psauGlobalTimer');
      var tt = document.getElementById('psauGlobalTimerTitle');
      var ss = document.getElementById('psauGlobalTimerSub');
      if (!ov) return;
      if (tt) tt.textContent = String(t || 'Loading...');
      if (ss) ss.innerHTML = 'Please wait <span id="psauGlobalTimerElapsed" style="font-weight:800; color:#1b5e20;">0.0s</span>';
      ov.style.display = 'flex'; ov.classList.add('open');
      document.body.style.overflow = 'hidden';
      _qGlobalStart = Date.now();
      if (_qGlobalInt) clearInterval(_qGlobalInt);
      _qGlobalInt = setInterval(function () { var el = document.getElementById('psauGlobalTimerElapsed'); if (el) el.textContent = ((Date.now() - _qGlobalStart) / 1000).toFixed(1) + 's'; }, 100);
    }
    function hideGlobalTimer() {
      var ov = document.getElementById('psauGlobalTimer');
      if (ov) { ov.style.display = 'none'; ov.classList.remove('open'); }
      document.body.style.overflow = '';
      if (_qGlobalInt) { clearInterval(_qGlobalInt); _qGlobalInt = null; }
    }
    document.addEventListener('DOMContentLoaded', function () {
      document.querySelectorAll('.q-pill').forEach(function (a) {
        a.addEventListener('click', function () { showGlobalTimer('Switching quarter...', ''); });
      });
      var sel = document.querySelector('select[onchange*="quarterly-reports"]');
      if (sel) sel.addEventListener('change', function () { showGlobalTimer('Loading year...', ''); });
    });
    // Dashboard is sole writer — this picker is now read-only and mirrors Dashboard
    function toggleQuarterDatePicker() {
      var txt=null; try{ var r=localStorage.getItem('psau_global_dateFilter'); if(r){ var gf=JSON.parse(r); if(gf.filterType==='range'&&gf.dateFrom&&gf.dateTo&&gf.dateFrom===gf.dateTo){ var d=new Date(gf.dateFrom); if(!isNaN(d.getTime())) txt=d.toLocaleDateString('en-PH',{year:'numeric',month:'long',day:'numeric'}); else txt=gf.dateFrom; } else if(gf.badgeText) txt=gf.badgeText; } }catch(e){}
      var msg=txt ? ('Filtered date: '+txt+' (from Dashboard). Go to Dashboard to change.') : 'No date filter — Overall (All Time). Set date on Dashboard.';
      // use app dialog if available
      if(typeof psauAlert==='function'){ try{ psauAlert({title:'Date follows Dashboard', message:msg, variant:'info'}); return; }catch(e){} }
      // fallback to unified dialog
      var ov=document.getElementById('psauDialog');
      if(ov && document.getElementById('psauDialogConfirm')){
        try{
          document.getElementById('psauDialogTitle').textContent='Date follows Dashboard';
          document.getElementById('psauDialogMessage').textContent=msg;
          document.getElementById('psauDialogCancel').textContent='OK';
          document.getElementById('psauDialogConfirm').textContent='Go to Dashboard';
          ov.style.display='flex'; ov.classList.add('open'); document.body.style.overflow='hidden';
          var c=document.getElementById('psauDialogConfirm'), x=document.getElementById('psauDialogCancel');
          var close=function(go){ ov.style.display='none'; ov.classList.remove('open'); document.body.style.overflow=''; c.onclick=null; x.onclick=null; ov.onclick=null; if(go) window.location.href='/admin/dashboard'; };
          c.onclick=function(){ close(true); }; x.onclick=function(){ close(false); }; ov.onclick=function(ev){ if(ev.target===ov) close(false); };
          return;
        }catch(e){}
      }
      alert(msg);
    }
    // Auto-mirror Dashboard date on load if no explicit ?date in URL (hidden badge)
    (function(){
      try{
        var url=new URL(window.location.href);
        if(url.searchParams.has('date')) return;
        var raw=localStorage.getItem('psau_global_dateFilter');
        if(!raw) return;
        var gf=JSON.parse(raw);
        var dateStr='';
        if(gf && gf.filterType==='range' && gf.dateFrom && gf.dateTo && gf.dateFrom===gf.dateTo) dateStr=gf.dateFrom;
        else if(gf && gf.dateFrom) dateStr=gf.dateFrom;
        if(!dateStr || !/^\d{4}-\d{2}-\d{2}$/.test(dateStr)) return;
        var d=new Date(dateStr); if(isNaN(d.getTime())) return;
        var badge=document.getElementById('quarterDateBadgeText');
        if(badge){ badge.textContent=d.toLocaleDateString('en-PH',{year:'numeric',month:'long',day:'numeric'}); badge.title='Filtered date: '+badge.textContent+' (from Dashboard)'; }
        var br=document.getElementById('quarterDateBadge');
        if(br) br.title='Date follows Dashboard: '+d.toLocaleDateString('en-PH',{year:'numeric',month:'long',day:'numeric'})+' — change on Dashboard';
      }catch(e){}
    })();
    // Report-specific date for Generate Report (AI Assistant only, independent from Dashboard global filter)
    (function(){
      var inp=document.getElementById('aiReportDate');
      var btn=document.getElementById('btnGenerateReport');
      var officeSel=document.getElementById('quarterOfficeFilter');
      if(!inp||!btn) return;
      function getDefaultReportDate(){
        var serverDate='<%= typeof selectedQuarterDate !== "undefined" ? selectedQuarterDate : "" %>';
        if(serverDate && /^\d{4}-\d{2}-\d{2}$/.test(serverDate)) return serverDate;
        try{
          var raw=localStorage.getItem('psau_global_dateFilter');
          if(raw){
            var gf=JSON.parse(raw);
            if(gf.filterType==='range' && gf.dateFrom && /^\d{4}-\d{2}-\d{2}$/.test(gf.dateFrom)) return gf.dateFrom;
            if(gf.dateFrom && /^\d{4}-\d{2}-\d{2}$/.test(gf.dateFrom)) return gf.dateFrom;
          }
        }catch(e){}
        return new Date().toISOString().split('T')[0];
      }
      function updateGenerateReportLink(){
        var v=inp.value;
        if(!v || !/^\d{4}-\d{2}-\d{2}$/.test(v)) return;
        var office=officeSel ? officeSel.value : '<%= typeof selectedOffice !== "undefined" ? selectedOffice : "all" %>';
        var params=new URLSearchParams();
        params.set('filterType','range');
        params.set('office', office||'all');
        params.set('dateFrom', v);
        params.set('dateTo', v);
        btn.href='/admin/report?' + params.toString();
        try{ btn.title='Generate report for '+ new Date(v).toLocaleDateString('en-PH',{year:'numeric',month:'long',day:'numeric'}); }catch(e){}
      }
      inp.value=getDefaultReportDate();
      updateGenerateReportLink();
      inp.addEventListener('change', updateGenerateReportLink);
      inp.addEventListener('input', updateGenerateReportLink);
      if(officeSel) officeSel.addEventListener('change', updateGenerateReportLink);
    })();
    function isValidYMDQ(s) { return /^\d{4}-\d{2}-\d{2}$/.test(s) && !isNaN(new Date(s).getTime()); }
    function shiftQuarterDate(dir) {
      var inp = document.getElementById('quarterDatePickerInput');
      if (!inp) return;
      if (!inp.value) { var t = new Date(); t.setDate(t.getDate() + dir); inp.value = t.toISOString().split('T')[0]; return; }
      if (!isValidYMDQ(inp.value)) return;
      var d = new Date(inp.value); d.setDate(d.getDate() + dir);
      var iso = d.toISOString().split('T')[0];
      if (isValidYMDQ(iso)) inp.value = iso;
    }
    function getQuarterFromMD(m) { // 0-indexed month
      if (m <= 2) return 'Q1'; if (m <= 5) return 'Q2'; if (m <= 8) return 'Q3'; return 'Q4';
    }
    function applyQuarterDate() {
      var inp = document.getElementById('quarterDatePickerInput');
      var v = inp ? String(inp.value || '').trim() : '';
      if (!v) { clearQuarterDate(); return; }
      if (!isValidYMDQ(v)) { alert('Please pick a valid date (YYYY-MM-DD).'); return; }
      var d = new Date(v);
      var y = d.getFullYear(); var q = getQuarterFromMD(d.getMonth());
      // sanitize year 2000-2100
      y = Math.max(2000, Math.min(2100, y));
      document.getElementById('quarterDatePopover').style.display = 'none';
      showGlobalTimer('Loading ' + q + ' ' + y + '...', '');
      var url = new URL(window.location.href);
      url.searchParams.set('year', y);
      url.searchParams.set('quarter', q);
      url.searchParams.set('date', v);
      window.location.href = url.toString();
    }
    function applyQuarterOfficeFilter(val) {
      showGlobalTimer('Filtering by office...', '');
      var url = new URL(window.location.href);
      if (val && val !== 'all') {
        url.searchParams.set('office', val);
      } else {
        url.searchParams.delete('office');
      }
      window.location.href = url.toString();
    }
    function clearQuarterDate() {
      var pop = document.getElementById('quarterDatePopover');
      if (pop) pop.style.display = 'none';
      window.location.href = '/admin/quarterly-reports';
    }
    document.addEventListener('click', function (e) {
      var pop = document.getElementById('quarterDatePopover');
      var badge = document.getElementById('quarterDateBadge');
      if (!pop || pop.style.display === 'none') return;
      if (pop.contains(e.target) || (badge && badge.contains(e.target))) return;
      pop.style.display = 'none';
    });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') { var pop = document.getElementById('quarterDatePopover'); if (pop) pop.style.display = 'none'; } });
    function printAIReport() {
      const activeOffice = (document.getElementById('quarterOfficeFilter') && document.getElementById('quarterOfficeFilter').value) ? document.getElementById('quarterOfficeFilter').value : '<%= typeof selectedOffice !== "undefined" ? selectedOffice : "all" %>';
      const p = new URLSearchParams({ quarter: '<%= activeQuarter %>', year: '<%= selectedYear %>', office: activeOffice }); window.open('/admin/print-ai-report?' + p.toString(), '_blank');
    }
    // Low Performing Offices — Show all / View less (first 5 shown by default)
    function toggleLowPerformers(showAll) {
      var extras = document.querySelectorAll('.low-performer-card[data-extra="1"]');
      for (var i = 0; i < extras.length; i++) extras[i].style.display = showAll ? 'block' : 'none';
      var showBtn = document.getElementById('btnShowAllOffices');
      var lessBtn = document.getElementById('btnViewLessOffices');
      if (showBtn) showBtn.style.display = showAll ? 'none' : 'inline-flex';
      if (lessBtn) lessBtn.style.display = showAll ? 'inline-flex' : 'none';
    }

    // Top Generate — reveals rankings with per-office suggestions (redundant AI cards panel removed)
    function generateAssistantResults() {
      var wrap = document.getElementById('aiAssistantResults');
      var btn = document.getElementById('aiAssistantGenerateBtn');
      if (wrap) { wrap.style.display = 'grid'; }
      if (btn) { btn.innerHTML = '<i class="fas fa-wand-magic-sparkles"></i> Regenerate'; }
      try {
        if (wrap && !wrap.dataset.scrolled) {
          wrap.dataset.scrolled = '1';
          setTimeout(function () { wrap.scrollIntoView({ behavior: 'smooth', block: 'start' }); }, 100);
        }
      } catch (e) {}
    }


  </script>

  <%- include('partials/footer') %>