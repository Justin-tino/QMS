<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Customer Feedback Report (PSAU-QMS-SF-20) - PSAU</title>
    <style>
        *,
        *::before,
        *::after {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background: #f0f2f5;
            padding: 1.5rem;
            color: #111;
        }

        .sheet {
            max-width: 820px;
            margin: 0 auto;
            background: #fff;
            padding: 1.2rem 1.4rem;
            box-shadow: 0 4px 16px rgba(0, 0, 0, .08);
        }

        .btn-bar {
            max-width: 820px;
            margin: 0 auto 1rem auto;
            display: flex;
            gap: 0.6rem;
            justify-content: flex-end;
        }

        .btn-bar button {
            padding: 0.55rem 1.1rem;
            background: #1b5e20;
            color: #fff;
            border: none;
            border-radius: 7px;
            font-weight: 700;
            font-size: 0.8rem;
            cursor: pointer;
            font-family: inherit;
        }

        .btn-bar button.secondary {
            background: #475569;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        td,
        th {
            border: 1px solid #000;
            padding: 4px 7px;
            font-size: 11.5px;
            vertical-align: top;
        }

        .hdr-table td {
            text-align: center;
        }

        .hdr-table .unit {
            font-size: 11px;
            letter-spacing: 0.4px;
        }

        .hdr-table .title {
            font-size: 15px;
            font-weight: 800;
            letter-spacing: 0.6px;
        }

        .logo-cell {
            width: 78px;
            text-align: center;
        }

        .logo-cell img {
            height: 52px;
            width: auto;
        }

        .meta-table td {
            font-size: 10.5px;
            text-align: center;
            padding: 3px 5px;
        }

        .info-table td {
            font-size: 11.5px;
        }

        .info-table .lbl {
            width: 26%;
            font-weight: 400;
        }

        .dist-table th {
            text-align: center;
            font-size: 10.5px;
            background: #f2f2f2;
        }

        .dist-table td {
            text-align: center;
            font-size: 11px;
        }

        .dist-table .month {
            text-align: left;
            font-size: 10.5px;
            letter-spacing: 0.4px;
        }

        .dist-table .total-row td {
            font-weight: 800;
            font-size: 11px;
            background: #f9f9f9;
        }

        .sqd-table th {
            background: #e8f5e9;
        }

        .section-box {
            border: 1px solid #000;
            margin-top: 8px;
        }

        .section-box .section-head {
            border-bottom: 1px solid #000;
            padding: 3px 7px;
            font-size: 11.5px;
            font-weight: 800;
            background: #fff;
        }

        .section-box .section-body {
            padding: 6px 9px;
            font-size: 11px;
            min-height: 52px;
            line-height: 1.5;
        }

        .sign-table td {
            height: 28px;
            font-size: 11px;
            vertical-align: top;
            padding: 4px 7px;
        }

        .sign-table th {
            font-size: 10.5px;
            background: #f2f2f2;
        }

        .sign-table .role {
            font-style: italic;
        }

        .sign-table .sig {
            height: 42px;
        }

        .note {
            font-size: 10px;
            font-style: italic;
            margin-top: 6px;
            color: #333;
        }

        /* ---------- Click-to-edit values (screen only — never printed) ----------
           Click a value directly on the sheet and retype it. Only the printed text
           changes; every figure, count and percentage keeps the value the server
           computed. */
        .editable {
            cursor: text;
            outline: none;
            border-bottom: 1px dashed #94a3b8;
            border-radius: 2px;
            padding: 0 2px;
            transition: background 0.12s ease, box-shadow 0.12s ease;
        }

        .editable:hover {
            background: #eef7ee;
        }

        .editable:focus {
            background: #fff8d9;
            border-bottom-color: #1b5e20;
            box-shadow: 0 0 0 2px rgba(27, 94, 32, 0.14);
        }

        .edit-tip {
            max-width: 820px;
            margin: 0 auto 0.75rem auto;
            padding: 0.45rem 0.75rem;
            background: #fff;
            border: 1px dashed #94a3b8;
            border-radius: 7px;
            font-size: 0.72rem;
            line-height: 1.5;
            color: #334155;
        }

        .edit-tip strong {
            color: #1b5e20;
        }

        @media print {
            body {
                background: #fff;
                padding: 0;
            }

            .btn-bar,
            .edit-tip {
                display: none !important;
            }

            .editable,
            .editable:hover,
            .editable:focus {
                border-bottom: 0 !important;
                background: transparent !important;
                box-shadow: none !important;
                padding: 0 !important;
            }

            .sheet {
                box-shadow: none;
                max-width: 100%;
                padding: 0.4rem 0.5rem;
            }

            @page {
                size: A4 portrait;
                margin: 10mm;
            }
        }
    </style>
</head>

<body>
    <div class="btn-bar">
        <button class="secondary" onclick="resetReportEdits()" title="Restore the values generated by the system">Reset
            edits</button>
        <button class="secondary" onclick="handleReportClose()">Close</button>
        <button onclick="window.print()">Print / Save as PDF</button>
    </div>
    <div class="edit-tip">Click any value on the sheet to edit it — <strong>Revision No.</strong>, <strong>Eff. Date</strong>,
        <strong>Covered Month-Year</strong>, a <strong>MONTH</strong> row or a signatory <strong>Date</strong>. Type a new
        value and press Enter (just clicking a value changes nothing). Changing the Covered Month-Year re-dates the whole
        report from the <strong>first day</strong> of the period — the figures never change.</div>
    <% const _todayShort=(typeof todayShort !=='undefined' && todayShort) ? todayShort : new
        Date().toLocaleDateString('en-US', { month:'2-digit', day:'2-digit', year:'numeric' }); %>

        <div class="sheet">
            <table class="hdr-table">
                <tr>
                    <td class="logo-cell" rowspan="2"><img src="/images/leftlogo.png" alt="Left Logo"
                            onerror="this.style.display='none'"></td>
                    <td class="unit">Quality Management System Unit</td>
                    <td class="logo-cell" rowspan="2"><img src="/images/rightlogo.png" alt="Right Logo"
                            onerror="this.style.display='none'"></td>
                </tr>
                <tr>
                    <td class="title">CUSTOMER FEEDBACK REPORT</td>
                </tr>
            </table>
            <table class="meta-table">
                <tr>
                    <td style="width:25%;">PSAU-QMS-SF-20</td>
                    <td style="width:25%;">Revision No.: <span id="editRevision" class="editable" data-edit="revision"
                            contenteditable="true" spellcheck="false" role="textbox" aria-label="Revision number"
                            title="Click to edit the revision number">08</span></td>
                    <td style="width:28%;">Eff. Date: <span id="editEffDate" class="editable" data-edit="date-long"
                            contenteditable="true" spellcheck="false" role="textbox" aria-label="Effective date"
                            title="Click to edit the effective date"><%=
                            typeof effDate !=='undefined' && effDate ? effDate : new
                            Date().toLocaleDateString('en-PH', { month:'long', day:'numeric', year:'numeric' }) %></span>
                    </td>
                    <td>Page 1 of 1</td>
                </tr>
            </table>
            <% const _generatedAt=typeof generatedAt !=='undefined' && generatedAt ? generatedAt : new
                Date().toLocaleString('en-PH', { year:'numeric', month:'long', day:'numeric', hour:'2-digit',
                minute:'2-digit', hour12:true }); %>
                <div style="text-align:right; font-size:9px; color:#64748b; margin-top:3px; font-style:italic;">Report
                    generated: <span id="editGeneratedAt" class="editable" data-edit="generated" contenteditable="true"
                        spellcheck="false" role="textbox" aria-label="Report generated date and time"
                        title="Click to edit the report generated date (the time is kept)"><%= _generatedAt %></span>
                </div>

                <% /* Organizational Unit — shows specific filtered office/department, or "All" when university-wide */
                    %>
                    <% const _rawOffice=(typeof selectedOffice !=='undefined' && selectedOffice && selectedOffice
                        !=='all' ) ? selectedOffice : ((typeof office !=='undefined' && office && office !=='all' ) ?
                        office : '' ); const _office=_rawOffice && _rawOffice.trim().length ? _rawOffice.trim() : 'All'
                        ; const _periodLabel=typeof periodLabel !=='undefined' ? periodLabel : (typeof dateFrom
                        !=='undefined' && dateFrom ? dateFrom : 'Overall' ); const _respondents=typeof respondents
                        !=='undefined' ? respondents : (typeof feedbacks !=='undefined' ? feedbacks.length : (typeof
                        stats !=='undefined' ? stats.totalResponses : 0)); %>
                        <table class="info-table" style="margin-top:8px;">
                            <tr>
                                <td class="lbl">Organizational Unit</td>
                                <td colspan="3" style="font-weight:800; letter-spacing:0.3px;">
                                    <%= _office.toUpperCase() %>
                                </td>
                            </tr>
                            <tr>
                                <td class="lbl">Covered Month-Year</td>
                                <td><strong id="editPeriod" class="editable" data-edit="period" contenteditable="true"
                                        spellcheck="false" role="textbox" aria-label="Covered month-year"
                                        title="Click to edit the covered period — the dates in this report follow it"><%=
                                        _periodLabel %></strong></td>
                                <td class="lbl" style="width:22%;">Total Respondents</td>
                                <td style="width:12%; text-align:center; font-weight:800;">
                                    <%= _respondents %>
                                </td>
                            </tr>
                        </table>

                        <table class="dist-table" style="margin-top:8px;">
                            <tr>
                                <th rowspan="2" style="width:22%;">MONTH</th>
                                <th colspan="6">Frequency Distribution</th>
                                <th rowspan="2" style="width:13%;">Percentage (%)</th>
                                <th rowspan="2" style="width:15%;">Adjectival Equivalent</th>
                            </tr>
                            <tr>
                                <th style="width:6%;">5</th>
                                <th style="width:6%;">4</th>
                                <th style="width:6%;">3</th>
                                <th style="width:6%;">2</th>
                                <th style="width:6%;">1</th>
                                <th style="width:6%;">N/A</th>
                            </tr>
                            <% const _months=(typeof months !=='undefined' && Array.isArray(months)) ? months : [];
                                const _overall=(typeof overall !=='undefined' && overall) ? overall : (typeof
                                quarterSummary !=='undefined' ? quarterSummary : { counts:
                                {'5':0,'4':0,'3':0,'2':0,'1':0,'N/A':0}, valid:0, pct:0, adj:'—', mean:0 }); %>
                                <% if (_months.length) { %>
                                    <% _months.forEach(function(m) { %>
                                        <tr>
                                            <td class="month">
                                                <span class="editable month-label" contenteditable="true" spellcheck="false"
                                                    role="textbox" aria-label="Month label"
                                                    title="Click to edit this month label (the figures stay the same)"><%=
                                                    m.name %><%= m.year ? ' ' + m.year : '' %></span>
                                            </td>
                                            <td>
                                                <%= m.counts['5'] %>
                                            </td>
                                            <td>
                                                <%= m.counts['4'] %>
                                            </td>
                                            <td>
                                                <%= m.counts['3'] %>
                                            </td>
                                            <td>
                                                <%= m.counts['2'] %>
                                            </td>
                                            <td>
                                                <%= m.counts['1'] %>
                                            </td>
                                            <td>
                                                <%= m.counts['N/A'] %>
                                            </td>
                                            <td>
                                                <%= m.valid> 0 ? m.pct.toFixed(2) + '%' : '—' %>
                                            </td>
                                            <td>
                                                <%= m.valid> 0 ? m.adj : '—' %>
                                            </td>
                                        </tr>
                                        <% }) %>
                                            <% } else { %>
                                                <tr>
                                                    <td class="month">N/A</td>
                                                    <td>0</td>
                                                    <td>0</td>
                                                    <td>0</td>
                                                    <td>0</td>
                                                    <td>0</td>
                                                    <td>0</td>
                                                    <td>—</td>
                                                    <td>—</td>
                                                </tr>
                                                <% } %>
                                                    <tr class="total-row">
                                                        <td class="month">FREQUENCY DIST. FOR THE PERIOD</td>
                                                        <td>
                                                            <%= _overall.counts['5'] %>
                                                        </td>
                                                        <td>
                                                            <%= _overall.counts['4'] %>
                                                        </td>
                                                        <td>
                                                            <%= _overall.counts['3'] %>
                                                        </td>
                                                        <td>
                                                            <%= _overall.counts['2'] %>
                                                        </td>
                                                        <td>
                                                            <%= _overall.counts['1'] %>
                                                        </td>
                                                        <td>
                                                            <%= _overall.counts['N/A'] %>
                                                        </td>
                                                        <td></td>
                                                        <td></td>
                                                    </tr>
                                                    <tr class="total-row">
                                                        <td class="month">PERIOD RATING</td>
                                                        <td colspan="5" style="background:#fff;"></td>
                                                        <td>
                                                            <%= _overall.valid> 0 ? _overall.counts['N/A'] : 0 %>
                                                        </td>
                                                        <td style="font-weight:800;">
                                                            <%= _overall.valid> 0 ? _overall.pct.toFixed(2) + '%' : '—'
                                                                %>
                                                        </td>
                                                        <td style="font-weight:800;">
                                                            <%= _overall.valid> 0 ? _overall.adj : '—' %>
                                                        </td>
                                                    </tr>
                        </table>

                        <!-- SQD RATINGS SUMMARY (matches Reaction Summary on dashboard) -->
                        <table class="dist-table sqd-table" style="margin-top:8px;">
                            <tr>
                                <th colspan="11" style="text-align:center; font-size:11px; letter-spacing:0.3px;">SQD
                                    RATINGS SUMMARY (SQD0 — SQD8)</th>
                            </tr>
                            <tr>
                                <th rowspan="2" style="width:7%;">SQD</th>
                                <th rowspan="2" style="width:30%; text-align:left;">Service Quality Dimension</th>
                                <th colspan="6">Frequency Distribution</th>
                                <th rowspan="2" style="width:7%;">Avg</th>
                                <th rowspan="2" style="width:10%;">Percentage (%)</th>
                                <th rowspan="2" style="width:12%;">Adjectival Equivalent</th>
                            </tr>
                            <tr>
                                <th style="width:6%;">5</th>
                                <th style="width:6%;">4</th>
                                <th style="width:6%;">3</th>
                                <th style="width:6%;">2</th>
                                <th style="width:6%;">1</th>
                                <th style="width:6%;">N/A</th>
                            </tr>
                            <% (typeof sqdSummary !=='undefined' && sqdSummary ? sqdSummary : []).forEach(function(s) {
                                %>
                                <tr>
                                    <td style="font-weight:800;">
                                        <%= s.code %>
                                    </td>
                                    <td style="text-align:left; font-size:9.5px; line-height:1.3;">
                                        <%= s.full %>
                                            <div style="font-size:8.5px; color:#555;">
                                                <%= s.desc %>
                                            </div>
                                    </td>
                                    <td>
                                        <%= s.counts['5'] %>
                                    </td>
                                    <td>
                                        <%= s.counts['4'] %>
                                    </td>
                                    <td>
                                        <%= s.counts['3'] %>
                                    </td>
                                    <td>
                                        <%= s.counts['2'] %>
                                    </td>
                                    <td>
                                        <%= s.counts['1'] %>
                                    </td>
                                    <td>
                                        <%= s.counts['N/A'] %>
                                    </td>
                                    <td style="font-weight:700;">
                                        <%= s.valid> 0 ? s.mean.toFixed(2) : '—' %>
                                    </td>
                                    <td>
                                        <%= s.valid> 0 ? s.pct.toFixed(2) + '%' : '—' %>
                                    </td>
                                    <td>
                                        <%= s.adj %>
                                    </td>
                                </tr>
                                <% }) %>
                                    <tr class="total-row">
                                        <td colspan="2" class="month">OVERALL SQD AVERAGE</td>
                                        <% const _fallbackCounts=(typeof _overall !=='undefined' && _overall.counts) ?
                                            _overall.counts : {'5':0,'4':0,'3':0,'2':0,'1':0,'N/A':0}; %>
                                            <td>
                                                <%= (typeof sqdTotals !=='undefined' && sqdTotals ? sqdTotals['5'] :
                                                    _fallbackCounts['5']) %>
                                            </td>
                                            <td>
                                                <%= (typeof sqdTotals !=='undefined' && sqdTotals ? sqdTotals['4'] :
                                                    _fallbackCounts['4']) %>
                                            </td>
                                            <td>
                                                <%= (typeof sqdTotals !=='undefined' && sqdTotals ? sqdTotals['3'] :
                                                    _fallbackCounts['3']) %>
                                            </td>
                                            <td>
                                                <%= (typeof sqdTotals !=='undefined' && sqdTotals ? sqdTotals['2'] :
                                                    _fallbackCounts['2']) %>
                                            </td>
                                            <td>
                                                <%= (typeof sqdTotals !=='undefined' && sqdTotals ? sqdTotals['1'] :
                                                    _fallbackCounts['1']) %>
                                            </td>
                                            <td>
                                                <%= (typeof sqdTotals !=='undefined' && sqdTotals ? sqdTotals['N/A'] :
                                                    _fallbackCounts['N/A']) %>
                                            </td>
                                            <td style="font-weight:800;">
                                                <%= (typeof sqdOverallMean !=='undefined' ?
                                                    Number(sqdOverallMean).toFixed(2) : (typeof _overall !=='undefined'
                                                    && _overall.valid ? _overall.mean.toFixed(2) : '—' )) %>
                                            </td>
                                            <td style="font-weight:800;">
                                                <%= (typeof sqdOverallPct !=='undefined' ?
                                                    Number(sqdOverallPct).toFixed(2)+'%' : (typeof _overall
                                                    !=='undefined' && _overall.valid ? _overall.pct.toFixed(2)+'%':'—'))
                                                    %>
                                            </td>
                                            <td style="font-weight:800;">
                                                <%= (typeof sqdOverallAdj !=='undefined' ? sqdOverallAdj : (typeof
                                                    _overall !=='undefined' ? _overall.adj : '—' )) %>
                                            </td>
                                    </tr>
                        </table>

                        <% const _remarks=typeof remarks !=='undefined' ? remarks : (typeof _overall !=='undefined' &&
                            _overall.valid> 0 ? (_overall.adj + ' — Period Rating: ' + _overall.pct.toFixed(2) + '%') :
                            'No remarks — insufficient data for the selected period.'); %>
                            <div style="display:flex; gap:8px; margin-top:6px;">
                                <div class="section-box" style="flex:1; margin-top:0;">
                                    <div class="section-head">QUARTERLY RATING</div>
                                    <div class="section-body"
                                        style="min-height:28px; text-align:center; font-weight:800; font-size:11px;">
                                        <%= _overall.valid> 0 ? _overall.pct.toFixed(2)+'%' : '—' %> — <%=
                                                _overall.valid> 0 ? _overall.adj : '—' %>
                                    </div>
                                </div>
                                <div class="section-box" style="flex:1; margin-top:0;">
                                    <div class="section-head">REMARKS:</div>
                                    <div class="section-body" style="min-height:28px;">
                                        <%= _remarks %>
                                    </div>
                                </div>
                            </div>




                            <table class="sign-table" style="margin-top:8px;">
                                <tr>
                                    <th style="width:34%; text-align:left;">Name</th>
                                    <th style="width:34%; text-align:left;">Position/Designation</th>
                                    <th style="width:18%;">Signature</th>
                                    <th style="width:14%;">Date</th>
                                </tr>
                                <tr>
                                    <td style="height:auto; padding:5px 7px;"><span
                                            style="font-style:italic; font-size:10px;">Prepared by:</span><br><strong
                                            id="sigPreparedName" style="text-decoration:underline;">
                                            <%= typeof preparedBy !=='undefined' ? preparedBy
                                                : 'Ma. Reena Rose P. Tayag' %>
                                        </strong></td>
                                    <td id="sigPreparedPos">
                                        <%= typeof preparedPos !=='undefined' ? preparedPos
                                            : 'Assistant Quality Management Representative' %>
                                    </td>
                                    <td class="sig"></td>
                                    <td id="sigPreparedDate" class="editable" data-edit="date-short"
                                        contenteditable="true" spellcheck="false" role="textbox"
                                        aria-label="Prepared by date" title="Click to edit this date"
                                        style="text-align:center; vertical-align:middle; font-size:10px;">
                                        <%= (typeof preparedDate !=='undefined' && preparedDate) ? preparedDate :
                                            (typeof _todayShort !=='undefined' ? _todayShort : new
                                            Date().toLocaleDateString('en-US',{month:'2-digit',day:'2-digit',year:'numeric'}))
                                            %>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="height:auto; padding:5px 7px;"><span
                                            style="font-style:italic; font-size:10px;">Reviewed by:</span><br><strong
                                            id="sigReviewedName" style="text-decoration:underline;">
                                            <%= typeof reviewedBy !=='undefined' ? reviewedBy
                                                : 'Glenda Marie T. Maniago' %>
                                        </strong></td>
                                    <td id="sigReviewedPos">
                                        <%= typeof reviewedPos !=='undefined' ? reviewedPos
                                            : 'Quality Management Representative' %>
                                    </td>
                                    <td class="sig"></td>
                                    <td id="sigReviewedDate" class="editable" data-edit="date-short"
                                        contenteditable="true" spellcheck="false" role="textbox"
                                        aria-label="Reviewed by date" title="Click to edit this date"
                                        style="text-align:center; vertical-align:middle; font-size:10px;">
                                        <%= (typeof reviewedDate !=='undefined' && reviewedDate) ? reviewedDate :
                                            (typeof _todayShort !=='undefined' ? _todayShort : new
                                            Date().toLocaleDateString('en-US',{month:'2-digit',day:'2-digit',year:'numeric'}))
                                            %>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="height:auto; padding:5px 7px;"><span
                                            style="font-style:italic; font-size:10px;">Certified by:</span><br><strong
                                            id="sigCertifiedName" style="text-decoration:underline;">
                                            <%= typeof certifiedBy !=='undefined' ? certifiedBy
                                                : 'Dexter Andrew O. Manalo' %>
                                        </strong></td>
                                    <td id="sigCertifiedPos">
                                        <%= typeof certifiedPos !=='undefined' ? certifiedPos
                                            : 'Director, Office of Institutional Quality Assurance' %>
                                    </td>
                                    <td class="sig"></td>
                                    <td id="sigCertifiedDate" class="editable" data-edit="date-short"
                                        contenteditable="true" spellcheck="false" role="textbox"
                                        aria-label="Certified by date" title="Click to edit this date"
                                        style="text-align:center; vertical-align:middle; font-size:10px;">
                                        <%= (typeof certifiedDate !=='undefined' && certifiedDate) ? certifiedDate :
                                            (typeof _todayShort !=='undefined' ? _todayShort : new
                                            Date().toLocaleDateString('en-US',{month:'2-digit',day:'2-digit',year:'numeric'}))
                                            %>
                                    </td>
                                </tr>
                            </table>

                            <p class="note">To be forwarded to the concerned unit:</p>
                            <table class="sign-table">
                                <tr>
                                    <th style="width:34%; text-align:left;">Name</th>
                                    <th style="width:34%; text-align:left;">Position/Designation</th>
                                    <th style="width:18%;">Signature</th>
                                    <th style="width:14%;">Date</th>
                                </tr>
                                <tr>
                                    <td style="height:42px;"><span style="font-style:italic; font-size:10px;">Received
                                            by:</span></td>
                                    <td>Document Control Coordinator</td>
                                    <td></td>
                                    <td></td>
                                </tr>
                            </table>
        </div>
        <script>
            function handleReportClose() {
                try {
                    if (window.parent && window.parent !== window && typeof window.parent.closeReportViewer === 'function') {
                        window.parent.closeReportViewer();
                        return;
                    }
                    if (window.parent && window.parent.document) {
                        const ov = window.parent.document.getElementById('reportViewerOverlay');
                        if (ov && ov.style.display !== 'none') {
                            ov.style.display = 'none';
                            window.parent.document.body.style.overflow = '';
                            const fr = window.parent.document.getElementById('reportViewerFrame');
                            if (fr) fr.src = 'about:blank';
                            return;
                        }
                    }
                } catch (e) { }
                if (window.opener) {
                    window.close();
                    return;
                }
                if (window.history.length > 1) {
                    window.history.back();
                } else {
                    window.location.href = '/admin/dashboard';
                }
                setTimeout(function () { try { window.close(); } catch (e) { } }, 100);
            }
            document.addEventListener('keydown', function (e) { if (e.key === 'Escape') handleReportClose(); });

            /* ================= Click-to-edit report values =================
               The encoder can click the Revision No., the Eff. Date, the "Report
               generated" stamp, the Covered Month-Year, a MONTH row of the frequency
               distribution or a signatory Date and retype it. Only the printed text
               changes — every count, total, percentage and adjectival equivalent keeps
               the value the server computed. Editing the Covered Month-Year re-dates
               the whole sheet from the FIRST day of the period. Nothing is saved:
               closing / re-opening the report restores the generated values. */
            (function () {
                /* -- report-edit helpers:start -- */
                var RE_MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August',
                    'September', 'October', 'November', 'December'];
                var RE_MONTH_INDEX = {};
                RE_MONTHS.forEach(function (name, i) { RE_MONTH_INDEX[name.toLowerCase()] = i; });

                function rePad2(n) { return (n < 10 ? '0' : '') + n; }

                function reClean(text) {
                    return String(text == null ? '' : text).replace(/[\u2013\u2014]/g, '-').replace(/\s+/g, ' ').trim();
                }

                function reMonthIndex(token) {
                    var t = reClean(token).toLowerCase().replace(/\./g, '');
                    if (t.length < 3) return -1;
                    for (var name in RE_MONTH_INDEX) {
                        if (name.indexOf(t) === 0) return RE_MONTH_INDEX[name];
                    }
                    return -1;
                }

                // Strict calendar date — rejects impossible days such as 02/30/2026
                function reMakeDate(year, monthIndex, day) {
                    var d = new Date(year, monthIndex, day);
                    if (isNaN(d.getTime())) return null;
                    return (d.getFullYear() === year && d.getMonth() === monthIndex && d.getDate() === day) ? d : null;
                }

                // Last calendar day of a month (monthIndex is 0-based)
                function reLastDayOfMonth(year, monthIndex) { return new Date(year, monthIndex + 1, 0); }

                function reFmtLong(d) { return RE_MONTHS[d.getMonth()] + ' ' + d.getDate() + ', ' + d.getFullYear(); }

                function reFmtShort(d) {
                    return rePad2(d.getMonth() + 1) + '/' + rePad2(d.getDate()) + '/' + d.getFullYear();
                }

                // 2026-09-30 | 09/30/2026 | 9/30/2026 | September 30, 2026 | Sept 30 2026 | 30 September 2026
                function reParseDate(input) {
                    var s = reClean(input);
                    if (!s) return null;
                    var m = /^(\d{4})-(\d{1,2})-(\d{1,2})$/.exec(s);
                    if (m) return reMakeDate(+m[1], +m[2] - 1, +m[3]);
                    m = /^(\d{1,2})\/(\d{1,2})\/(\d{4})$/.exec(s);
                    if (m) return reMakeDate(+m[3], +m[1] - 1, +m[2]);
                    m = /^([A-Za-z.]{3,})\s+(\d{1,2}),?\s+(\d{4})$/.exec(s);
                    if (m) { var mi = reMonthIndex(m[1]); return mi >= 0 ? reMakeDate(+m[3], mi, +m[2]) : null; }
                    m = /^(\d{1,2})\s+([A-Za-z.]{3,}),?\s+(\d{4})$/.exec(s);
                    if (m) { var mi2 = reMonthIndex(m[2]); return mi2 >= 0 ? reMakeDate(+m[3], mi2, +m[1]) : null; }
                    return null;
                }

                // 2026-07-01 to 2026-09-30 | July 1, 2026 - September 30, 2026 | October-December 2026
                // 2026-10 | October 2026 | Q3 2026 | 3rd Quarter 2026 | 2026 | 2026-09-30 | From 2026-07-01
                // Returns { start: Date, end: Date } (both inclusive) or null when unusable.
                function reParsePeriod(input) {
                    var s = reClean(input).replace(/^(?:from|up to|until|covering)\s+/i, '');
                    if (!s) return null;

                    var parts = s.split(/\s+to\s+|\s+through\s+/i);
                    if (parts.length === 2) {
                        var a = reParseDate(parts[0]), b = reParseDate(parts[1]);
                        if (a && b) return { start: a, end: b };
                    }

                    var m = /^([A-Za-z.]{3,})\s*-\s*([A-Za-z.]{3,}),?\s+(\d{4})$/.exec(s);
                    if (m) {
                        var m1 = reMonthIndex(m[1]), m2 = reMonthIndex(m[2]);
                        if (m1 >= 0 && m2 >= 0) {
                            return { start: reMakeDate(+m[3], m1, 1), end: reLastDayOfMonth(+m[3], m2) };
                        }
                    }

                    m = /^([A-Za-z.]{3,}),?\s+(\d{4})$/.exec(s);
                    if (m) {
                        var single = reMonthIndex(m[1]);
                        if (single >= 0) {
                            return { start: reMakeDate(+m[2], single, 1), end: reLastDayOfMonth(+m[2], single) };
                        }
                    }

                    m = /^(\d{4})-(\d{1,2})$/.exec(s);
                    if (m) {
                        var mo = +m[2] - 1;
                        if (mo >= 0 && mo <= 11) {
                            return { start: reMakeDate(+m[1], mo, 1), end: reLastDayOfMonth(+m[1], mo) };
                        }
                    }

                    m = /^(?:q\s*([1-4])|([1-4])\s*(?:st|nd|rd|th)?\s*quarter|quarter\s*([1-4]))\s*,?\s*(\d{4})$/i.exec(s);
                    if (m) {
                        var n = +(m[1] || m[2] || m[3]), sm = (n - 1) * 3;
                        return { start: reMakeDate(+m[4], sm, 1), end: reLastDayOfMonth(+m[4], sm + 2) };
                    }

                    m = /^(\d{4})$/.exec(s);
                    if (m) return { start: reMakeDate(+m[1], 0, 1), end: reMakeDate(+m[1], 11, 31) };

                    var only = reParseDate(s);
                    if (only) return { start: only, end: only };

                    return null;
                }

                // "September 30, 2026 at 10:13 AM" -> { datePart: 'September 30, 2026', timePart: ' at 10:13 AM' }
                function reSplitStamp(text) {
                    var m = /^(.*?)(\s+at\s+.*)$/i.exec(reClean(text));
                    return m ? { datePart: m[1], timePart: m[2] } : { datePart: reClean(text), timePart: '' };
                }

                // "September 2026" | "Sept. 2026" -> { monthIndex, year }
                function reParseMonthLabel(text) {
                    var m = /^([A-Za-z.]{3,}),?\s+(\d{4})$/.exec(reClean(text));
                    if (!m) return null;
                    var mi = reMonthIndex(m[1]);
                    return mi >= 0 ? { monthIndex: mi, year: +m[2] } : null;
                }

                // MONTH-row re-anchoring: the first row lands on the period's first month,
                // every other row keeps its original distance from it.
                function reShiftAbsMonth(abs, firstAbs, anchorAbs) { return anchorAbs + (abs - firstAbs); }

                function reMonthLabelFromAbs(abs) { return RE_MONTHS[abs % 12] + ' ' + Math.floor(abs / 12); }
                /* -- report-edit helpers:end -- */

                var editables = [];
                var monthRows = [];          // { el, abs } — parsed "Month YYYY" labels, in DOM order
                var periodText = '';         // last committed Covered Month-Year text
                var periodOriginalText = '';

                function byId(id) { return document.getElementById(id); }
                function setText(el, value) { if (el) el.textContent = value; }
                function isMonthLabel(el) { return !!(el.classList && el.classList.contains('month-label')); }
                function rowFor(el) {
                    for (var i = 0; i < monthRows.length; i++) { if (monthRows[i].el === el) return monthRows[i]; }
                    return null;
                }

                // ---- the Covered Month-Year drives every date on the sheet (FIRST day) ----
                function applyPeriod(period) {
                    var anchor = period.start;
                    setText(byId('editEffDate'), reFmtLong(anchor));
                    var stamp = byId('editGeneratedAt');
                    if (stamp) {
                        var split = reSplitStamp(stamp.textContent);   // the printed time is kept
                        stamp.textContent = reFmtLong(anchor) + split.timePart;
                    }
                    ['sigPreparedDate', 'sigReviewedDate', 'sigCertifiedDate'].forEach(function (id) {
                        setText(byId(id), reFmtShort(anchor));
                    });
                    shiftMonthLabels(anchor);
                }

                function shiftMonthLabels(anchor) {
                    if (!monthRows.length) return;
                    var anchorAbs = anchor.getFullYear() * 12 + anchor.getMonth();
                    var firstAbs = monthRows[0].abs;
                    monthRows.forEach(function (row) {
                        row.el.textContent = reMonthLabelFromAbs(reShiftAbsMonth(row.abs, firstAbs, anchorAbs));
                    });
                }

                // Rows that are not "Month YYYY" (e.g. the synthetic bucket that repeats the old
                // period text) simply follow the Covered Month-Year text.
                function shiftFallbackRows(nextText) {
                    editables.forEach(function (el) {
                        if (!isMonthLabel(el) || rowFor(el)) return;
                        if (el.textContent.trim() === periodText) el.textContent = nextText;
                    });
                }

                // ---- normalising / committing one field ----
                function normalize(el) {
                    var kind = el.getAttribute('data-edit') || '';
                    var raw = reClean(el.textContent);
                    if (kind === 'revision') {
                        el.textContent = (/^\d+$/.test(raw) && raw.length < 2) ? '0' + raw : raw;
                        return;
                    }
                    if (kind === 'date-long') { var long = reParseDate(raw); el.textContent = long ? reFmtLong(long) : raw; return; }
                    if (kind === 'date-short') { var short = reParseDate(raw); el.textContent = short ? reFmtShort(short) : raw; return; }
                    if (kind === 'generated') {
                        var split = reSplitStamp(raw);
                        var stamp = reParseDate(split.datePart);
                        el.textContent = stamp ? (reFmtLong(stamp) + split.timePart) : raw;
                        return;
                    }
                    if (isMonthLabel(el)) {
                        var label = reParseMonthLabel(raw);
                        el.textContent = label ? (RE_MONTHS[label.monthIndex] + ' ' + label.year) : raw;
                        return;
                    }
                    el.textContent = raw;   // period — printed exactly as typed
                }

                function commit(el) {
                    // Nothing was typed (plain click / focus + click away): keep the generated
                    // realtime date and every other value exactly as the server rendered them.
                    if (el.dataset.dirty !== '1') {
                        el.dataset.committed = reClean(el.textContent);
                        return;
                    }
                    el.dataset.dirty = '';
                    normalize(el);
                    var text = el.textContent.trim();
                    if (el.getAttribute('data-edit') === 'period') {
                        var period = reParsePeriod(text);
                        if (period) { shiftFallbackRows(text); applyPeriod(period); }
                        periodText = text;
                    }
                    el.dataset.committed = text;
                }

                // ---- click-to-edit wiring ----
                function bind(el) {
                    el.dataset.original = reClean(el.textContent);
                    el.dataset.committed = el.dataset.original;
                    el.addEventListener('focus', function () { el.dataset.committed = reClean(el.textContent); });
                    // Only real typing / pasting counts as an edit — a plain click must be a no-op.
                    el.addEventListener('input', function () { el.dataset.dirty = '1'; });
                    el.addEventListener('keydown', function (e) {
                        if (e.key === 'Enter') {
                            e.preventDefault();
                            e.stopPropagation();
                            commit(el);
                            el.blur();
                        } else if (e.key === 'Escape') {
                            e.preventDefault();
                            e.stopPropagation();   // Escape cancels the edit — it must not close the report
                            el.dataset.dirty = ''; // cancelling is not an edit
                            el.textContent = el.dataset.committed || el.dataset.original || '';
                            el.dataset.committed = reClean(el.textContent);
                            el.blur();
                        } else if (e.key === 'Tab') {
                            e.stopPropagation();
                            commit(el);
                        }
                    });
                    el.addEventListener('blur', function () { commit(el); });
                    el.addEventListener('paste', function (e) {   // paste as plain text only
                        e.preventDefault();
                        var cb = e.clipboardData || window.clipboardData;
                        var text = cb ? cb.getData('text') : '';
                        if (text) document.execCommand('insertText', false, reClean(text));
                    });
                }

                function resetReportEdits() {
                    editables.forEach(function (el) {
                        el.textContent = el.dataset.original || '';
                        el.dataset.committed = el.dataset.original || '';
                        el.dataset.dirty = '';
                    });
                    periodText = periodOriginalText;
                }

                function init() {
                    editables = [].slice.call(document.querySelectorAll('.editable'));
                    editables.forEach(function (el) {
                        bind(el);
                        if (!isMonthLabel(el)) return;
                        var label = reParseMonthLabel(el.textContent);
                        if (label) monthRows.push({ el: el, abs: label.year * 12 + label.monthIndex });
                    });
                    var periodEl = byId('editPeriod');
                    periodOriginalText = periodText = periodEl ? reClean(periodEl.textContent) : '';
                }

                window.resetReportEdits = resetReportEdits;
                if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
                else init();
            })();
        </script>
</body>

</html>